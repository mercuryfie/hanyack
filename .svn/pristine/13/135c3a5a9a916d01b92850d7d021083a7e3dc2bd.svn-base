


<div class="cancelCheckPopCon" id="cancelCheckPopCon" name="cancelCheckPopCon">
    <div class="cancelCheckPop" id="cancelCheckPop" name="cancelCheckPop">

        <!--            <i class="fa-solid fa-xmark close"></i>-->
        <h2>주문 취소</h2>
        <div class="cancelCheckPop1-1">
            <div class="title">
                <p>옵션 선택</p>
                <p>작성</p>
            </div>
            <div class="contents">
                <select name="cancel" id="">
                    <option value="">단순 변심</option>
                    <option value="">주문 수량 변경</option>
                    <option value="">타사 저렴한 상품</option>
                </select>
                <textarea name="" id="" cols="30" rows="10"></textarea>
            </div>
        </div>
        <div class="cancelCheckPop1-2">
            <button class="close">닫기</button>
            <button class="confirm">확인</button>
        </div>
    </div>
</div>