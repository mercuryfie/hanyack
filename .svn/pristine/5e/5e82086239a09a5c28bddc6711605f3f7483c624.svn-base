$(document).ready(function () {
    Load_Data(1);

    $('#btn_ini').on('click',function(e){
       location.reload();
    });


});

async function Load_Data(page) {
    try {
        start_spinner();
        INI_Load_Data();
        let dataarr = {'page' : page};
        let url = APIURL + '/Load_Package_Decoc';
        let result = await Load_API(url,dataarr);
        if (result.get('status') == 'NoLogin') {
            go_login();
        }else if (result.get('status') == 'ok') {
            let html = '';
            let arr = result.get('data');
            let Cnt = arr.length;
            if (Cnt > 0) {
                $.each(arr, function (index, el) {
                    let put_str = '';
                    let deli_str = '';
                    if (el.p_type >= 2) {
                        put_str = '입고대기';
                    }else{
                        put_str = '입고완료';
                    }
                    if (el.delicode == '') {
                        deli_str = `
                            <td><td>
                            <td><td>
                        `;
                    }else{
                        deli_str = `
                            <td>${Make_delcode_str(el.delitype)}</td>
                            <td>${el.delicode}</td>    
                        `;
                    }


                    html +=`
                        <tr>
                            <td class="">${put_str}</td>
                            <td class="hoverGreen"><a href="javascript://" onclick="Load_Package('${el.pcode}')">${el.pcode}</a></td>
                            <td>${el.mi_name}</td>
                            <td>${el.t_cnt}건</td>
                            <td>${number_format(el.t_weight)}(g)</td>
                            ${deli_str}
                            <td>${el.pa_regdate}</td>
                        </tr>    
                    `;
                });
            } else {
                html = '<td colspan="10">출하 약초 정보가 없습니다.</td>';
            }
            $('#putList').append(html);
        } else {
            alert(result.get('message'));
        }
        stop_spinner();
    } catch (error) {
        alert('오류가 발생하였습니다. 다시 시도하여주세요.\n[ERROR : ' + error + '}');
        stop_spinner();
    }
}



async function Load_Package(pcode){
    try {
        start_spinner();
        INI_Load_Data2();
        let dataarr = {"pcode" : pcode};
        let url = APIURL + '/Load_Package_Decoc_List';
        let result = await Load_API(url,dataarr);
        if (result.get('status') == 'NoLogin') {
            go_login();
        }else if(result.get('status') == 'ok') {
            let html = '';
            let arr = result.get('data').list;
            let Cnt = arr.length;
            if (Cnt > 0) {

                $.each(arr, function (index, el) {
                    html +=`
                        <tr>
                            <td><input type="checkbox" name="chkproduct" value="${el.pa_code}"/></td>
                            <td>${el.pa_code}</td>
                            <td>${el.fk_pcode}</td>
                            <td>${el.fk_hncode}</td>
                            <td>${el.hn_name}</td>
                            <td>${el.t1_value}</td>
                            <td>${el.t2_value}</td>
                            <td>${el.t_cnt}건</td>
                            <td>${number_format(el.t_weight)}(g)</td>
                            <td>${el.pa_regdate}</td>
                            <td>${el.delidate}</td>
                        </tr>
                    `;
                });
            } else {
                html = '<td colspan="10">출하 약초 정보가 없습니다.</td>';
            }
            $('#putListDetail').append(html);
        } else {
            alert(result.get('message'));
        }
        stop_spinner();
    } catch (error) {
        alert('오류가 발생하였습니다. 다시 시도하여주세요.\n[ERROR : ' + error + '}');
        stop_spinner();
    }

}

function Make_delcode_str(sn){
    let del = ['직배','퀵','경동','대신','로젠','롯데','천일','한진'];

    str = del[(sn-1)];

    return str;
}


function Insert_Package(sn,pcode){
    let delitype =  $('#delitype_' + sn).val();
    let delicode = $('#delicode_' + sn).val();

    console.log('delitype=' + delitype);
    console.log('delicode=' + delicode);
    console.log('pcode=' + pcode);

    if(delitype==''){
        alert('발송타입을 선택하세요.');
    }else if(delicode==''){
        alert('송장번호를 입력하세요');
    }else if(window.confirm('송장번호를 입력하시겠습니까?')==true){
        Insert_delicode(delitype,delicode,pcode);
    }

}

function INI_Load_Data(){
    $('#putlist').empty();
    $('#putlistDetail').empty();
}

function INI_Load_Data2(){
    $('#putListDetail').empty();
};