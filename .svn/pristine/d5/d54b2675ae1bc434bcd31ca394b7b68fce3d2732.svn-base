<?php

namespace App\Controllers;

use App\Libraries\Form;
use App\Libraries\Utils;
use App\Model;
use CodeIgniter\API\ResponseTrait;

class HerbController extends BaseController
{
    use ResponseTrait;


    public function __construct ()
    {
        $util = New Utils;
        $util->fn_Check_Auth(AUTH_MASTER);
    }


    public function herbList(){
        $util = New Utils;
        $sessinarr = $util->fnGetSessionData();
        if(!$sessinarr['islogin']){
            return redirect()->to('/Member/Login')->with('msg','로그인이 필요합니다.');
        }else {
            $request = service('request');
            $skey = ($request->getPost('skey')=='') ? '' : $request->getPost('skey');
            $page = ($request->getPost('page')=='') ? 1 : $request->getPost('page');
            $limit = 50;

            $s_data = [];

            $metaarr = [
                'h_title' => '상품리스트',
                'h_type' => 1
            ];

            $body = [
                'skey' => $skey,
                'page' => $page,
                'limit' => $limit
            ];

            $form = new Form;
            $main_data = [
                'meta' => $form->fnMake_Meta($metaarr),
                'header' => $form->fnMake_Header($sessinarr),
                'left_menu' => $form->fnMake_Left($sessinarr),
                'search' => $form->fnMake_Search($s_data),
                'body' => $body
            ];

            return view('web/master/herbListMaster_View', $main_data);
        }
    }

    public function herbMatch(){
        $util = New Utils;
        $sessinarr = $util->fnGetSessionData();
        if(!$sessinarr['islogin']){
            return redirect()->to('/Member/Login')->with('msg','로그인이 필요합니다.');
        }else {
            $request = service('request');
            $cf_code = ($request->getPost('cf')=='') ? '' : $request->getPost('cf');
            $hn_name = ($request->getPost('hn')=='') ? '' : $request->getPost('hn');
            $page = ($request->getPost('page')=='') ? 1 : $request->getPost('page');
            $limit = 50;

            $s_data = [];

            $metaarr = [
                'h_title' => '약재매칭',
                'h_type' => 1
            ];

            $decocarr = $util->fn_LoadDecoc('decoc');
            $decocoption = '';
            if($util->fnArrayCnt($decocarr)>0){
                foreach ($decocarr as $c){
                    if($cf_code==$c['mi_cfcode']){
                        $decocoption .= "<option selected value='{$c['mi_cfcode']}'>{$c['mi_name']}</option>";
                    }else{
                        $decocoption .= "<option value='{$c['mi_cfcode']}'>{$c['mi_name']}</option>";
                    }
                }
            }

            $body = [
                'cf_code' => $cf_code,
                'hn_name' => $hn_name,
                'option' => $decocoption,
                'page' => $page,
                'limit' => $limit
            ];

            $form = new Form;
            $main_data = [
                'meta' => $form->fnMake_Meta($metaarr),
                'header' => $form->fnMake_Header($sessinarr),
                'left_menu' => $form->fnMake_Left($sessinarr),
                'search' => $form->fnMake_Search($s_data),
                'body' => $body
            ];

            return view('web/master/herbMatch_View', $main_data);
        }
    }

    public function updateApproval() {
        $authentifier = $this->request->getPost('authentifier');
        $model = new Herb_m();
        $model->updateHnIsok($authentifier, 1); // 1로 업데이트
        return $this->respond(['status' => 'success']);
    }


    public function orderList(){
        $util = New Utils;
        $sessinarr = $util->fnGetSessionData();
        if(!$sessinarr['islogin']){
            return redirect()->to('/Member/Login')->with('msg','로그인이 필요합니다.');
        }else{
            $uid = $sessinarr['user']['uid'];
            $mi_code = $sessinarr['user']['mi_code'];
            $mi_type = $sessinarr['user']['mi_type'];
            $metaarr = [
                'h_title' => '상품등록',
                'h_type' => 1
            ];

            $herb_m = model('Herb_m');
            $fields = ['t2_code','t2_value'];
            $Rs = $herb_m->Load_option2($fields);
            $option2 = '';
            if($util->fnArrayCnt($Rs) <= 0){
                $option2 = '<option selected value="0">옵션 없음.</option>';
            }else{
                $option2 = '<option selected value="0">선택하세요.</option>';
                foreach($Rs as $d){
                    $option2 .= '<option value="' . $d['t2_code'] . '">' . $d['t2_value'] . '</option>';
                }
            }


            $fields = ['w_code','w_name','w_value'];
            $Rs = $herb_m->Load_option3($fields);
            $option3 = '';
            if($util->fnArrayCnt($Rs) <= 0){
                $option3 = '<option selected value="0">옵션 없음.</option>';
            }else{
                $option3 = '<option selected value="0">선택하세요.</option>';
                foreach($Rs as $d){
                    $option3 .= '<option value="' . $d['w_code'] . '">' . $d['w_name'] . '</option>';
                }
            }

            $fields = ['n_code','n_key','n_value'];
            $Rs = $herb_m->Load_option_nation($fields);
            $nation = '';
            if($util->fnArrayCnt($Rs) <= 0){
                $nation = '<option selected value="0">옵션 없음.</option>';
            }else{
                $nation = '<option selected value="">선택하세요.</option>';
                foreach($Rs as $d){
                    $nation .= '<option value="' . $d['n_key'] . '">' . $d['n_value'] . '</option>';
                }
            }


            $order = '<option selected value="0">등록 약재 없음</option>';

            $body_data = [
                'uid' => $uid,
                'mi_code' => $mi_code,
                'option2' => $option2,
                'option3' => $option3,
                'nation' => $nation,
                'order' => $order
            ];

            $form = New Form;
            $main_data = [
                'meta' => $form->fnMake_Meta($metaarr),
                'header' => $form->fnMake_Header($sessinarr),
                'left_menu' => $form->fnMake_Left($sessinarr),
                'body' => $body_data
            ];

            return view('web/master/orderListMaster_View', $main_data);
        }
    }
