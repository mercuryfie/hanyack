<?php

namespace App\Controllers;


use App\Libraries\Local_Utils;
use App\Libraries\Utils;
use CodeIgniter\API\ResponseTrait;
use App\DTOs\ResultDTO;


class ApiDjmediController extends BaseController
{
    use ResponseTrait;

    public function __construct()
    {
//        $Auth = [AUTH_MASTER, AUTH_PHARM, AUTH_DECOC];
//        $this->Check_Auth($Auth);
    }


    public function syncMedicineData(){
        /*
        http://test.djherb.kr/Api/syncMedicineData?tk=YEIHSH7RH4NCVU1H&cf=on
        http://test.djherb.kr/Api/syncMedicineData?tk=YEIHSH7RH4NCVU1H&cf=hs
        http://test.djherb.kr/Api/syncMedicineData?tk=YEIHSH7RH4NCVU1H&cf=hm
        http://test.djherb.kr/Api/syncMedicineData?tk=YEIHSH7RH4NCVU1H&cf=ch
        http://test.djherb.kr/Api/syncMedicineData?tk=YEIHSH7RH4NCVU1H&cf=cy
        http://test.djherb.kr/Api/syncMedicineData?tk=YEIHSH7RH4NCVU1H&cf=hp
        http://test.djherb.kr/Api/syncMedicineData?tk=YEIHSH7RH4NCVU1H&cf=dj
        http://test.djherb.kr/Api/syncMedicineData?tk=YEIHSH7RH4NCVU1H&cf=kd
        http://test.djherb.kr/Api/syncMedicineData?tk=YEIHSH7RH4NCVU1H&cf=kh
        http://test.djherb.kr/Api/syncMedicineData?tk=YEIHSH7RH4NCVU1H&cf=kl
        http://test.djherb.kr/Api/syncMedicineData?tk=YEIHSH7RH4NCVU1H&cf=hb
        http://test.djherb.kr/Api/syncMedicineData?tk=YEIHSH7RH4NCVU1H&cf=dr
        http://test.djherb.kr/Api/syncMedicineData?tk=YEIHSH7RH4NCVU1H&cf=dh
        http://test.djherb.kr/Api/syncMedicineData?tk=YEIHSH7RH4NCVU1H&cf=ds
        http://test.djherb.kr/Api/syncMedicineData?tk=YEIHSH7RH4NCVU1H&cf=ms
        */

        $token = $this->request->getGet('tk') ?? '';
        $is_cron = ($token === getenv('api.djmedi.Token'));
        if (!$is_cron) {
            return $this->respond(ResultDTO::fail('Error101', [], '잘못된 토큰입니다.'));
        }
        $cfcode = $this->request->getGet('cf') ?? '';
        if (empty($cfcode)) {
            return $this->respond(ResultDTO::fail('Error102', [], '잘못된 접근입니다.'));
        }

        $body = [
            'apiCode' => 'mediaverageusage',
            'ckCfcode' => $cfcode,
            'kind' => 'mediqty',//week | month |  mediqty
            'language' => 'kor'
        ];

        $apiUrl = API_DJMEDI . "/manager/medicine/";
        $response = fn_CURL($apiUrl, 'GET', [], $body);
        if (empty($response) || !is_array($response) || !isset($response['resultCode'])) {
            return $this->respond(ResultDTO::fail('Error103', [], 'API 서버 연결에 실패했습니다.'));
        }
        $resultCode = $response['resultCode'];
        if($resultCode!=200){
            return $this->respond(ResultDTO::fail('Error104', [], $response['resultMessage']));
        }
        $t_cnt = 0;
        $data = $response['list'];
        if((is_array($data)) && !empty($data)){

            $herb_m = model('Herb_m');
            foreach ($data as $d){
                $mm_medicine = $d['mm_medicine'];
                $stock = $d['mediqty'];
                $cnt = $herb_m->Chk_Medicine_Info($cfcode,$mm_medicine);
                if($cnt <=0){
                    $t_arr = [
                        'cfcode' => $cfcode,
                        'md_code' => $d['md_code'],
                        'mm_code' => $d['mm_code'],
                        'mm_medicine' => $mm_medicine,
                        'md_Medi' => $d['md_Medi'],
                        'mm_title' => $d['mm_title'],
                        'stock' => $d['mediqty'],
                        'optimal_stock' => $d['mm_stable']
                    ];
                    $sID = $herb_m->Insert_Medicine_Info($t_arr);
                    if(!empty($sID)) $t_cnt++;
                }else{
                    $sID = $herb_m->Update_Medicine_Stock($cfcode,$mm_medicine,$stock);
                    if(!empty($sID)) $t_cnt++;
                }

            }
        }
        $i_arr = [
            'cfcode' => $cfcode,
            'tcnt' => $t_cnt
        ];

        return $this->respond(ResultDTO::success($i_arr));
    }



}