                $result = 'type111';
                $data = '';
                $message = '권한이외의 접근입니다.';
            } else {
                $hncode = ($this->request->getPost('code') == '') ? '' : $this->request->getPost('code');
                $str = ($this->request->getPost('str') == '') ? '' : $this->request->getPost('str');
