                if((fn_ArrayCnt($d_arr)<=0) || ($mdMedi=='') || ($cfcode=='') || ($mm_medicine=='') || ($mm_origin=='') || ($md_title_kor=='') || ($md_maker=='')){
                    $result = 'type113';
                    $data = '';
                    $message = '잘못된 접근입니다.';
                }else{
                    $herb_m = model('Herb_m');
                    $param = [];
                    $hncode = '';
                    $Cnt = fn_ArrayCnt($d_arr);
                    for($i=0;$i<=($Cnt-1);$i++){
                        $hncode = $d_arr[$i];
                        $t_arr = [];
                        $cRs = $herb_m->Load_Product_Code($hncode);
                        if(fn_ArrayCnt($cRs)>0){
                            $t_arr['fk_hncode'] = $hncode;
                            $t_arr['fk_cfcode'] = $cfcode;
                            $t_arr['fk_micode'] = $cRs[0]['fk_micode'];
                            $t_arr['fk_mdMedi'] = $mdMedi;
                            $t_arr['fk_mdcode'] = $cRs[0]['fk_mdcode'];
                            $t_arr['mm_medicine'] = $mm_medicine;
                            $t_arr['mm_origin'] = $mm_origin;
                            $t_arr['md_title_kor'] = $md_title_kor;
                            $t_arr['md_maker'] = $md_maker;
                            $t_arr['mm_stock'] = $mm_stock;

                            array_push($param,$t_arr);
                        }
                    }

                    if(fn_ArrayCnt($param)>0){
                        $eCnt = $herb_m->Insert_Product_Matches($param);

                    }

                    $MCnt =  $herb_m->Cnt_Product_Match($mdMedi,$cfcode,$mm_medicine);

                    $i_arr = [
                        'Match' =>  $MCnt
                    ];

                    $result = 'ok';
                    $data = $i_arr;
                    $message = '';
                }
            }
        }

        $return = [
            'result' => $result,
            'info' => $data,
            'message' => $message
        ];
        return $this->respond($return);

    }

    public function Load_Decoc_Herb_List(){
        $medicode = ($this->request->getPost('medicode') == '') ? '' : $this->request->getPost('medicode');
        $cfcode = ($this->request->getPost('cfcode') == '') ? '' : $this->request->getPost('cfcode');
        $orgin = ($this->request->getPost('orgin') == '') ? '' : $this->request->getPost('orgin');
        if(($medicode=='') || ($cfcode=='') || ($orgin=='')){
            $result = 'type101';
            $data = '';
            $message = '잘못된 접근입니다.';
        }else{
            $sessinarr = $this->GetSessionData();
            if (!$sessinarr['islogin']) {
                $result = 'NoLogin';
                $data = '';
                $message = '로그인을 하셔야 합니다.';
            } else {
                $mi_type = $sessinarr['user']['mi_type'];
                if ($mi_type != AUTH_MASTER) {
                    $result = 'type111';
                    $data = '';
                    $message = '권한이외의 접근입니다.';
                } else {
                    $apiUrl = fn_ENV_URL() . "/manager/medicine/?apiCode=medicineclientlist&language=kor&ckCfcode={$cfcode}&medicode={$medicode}&mmorigin={$orgin}&reData=smartorder";
                    $retVal = fn_CURL($apiUrl, 'get');
                    if (empty($retVal)) {
                        $result = 'type102';
                        $data = '';
                        $message = '통신장애로 데이터로드에 실패하였습니다.<br>다시 시도 하여주세요.[Error101]';
                    } else if ($retVal['resultCode'] == '200') {
                        $herb_m = model('Herb_m');
                        $list = [];
                        foreach ($retVal['list'] as $d) {
                            $t_arr = [];

                            $t_arr['mm_seq'] = $d['mm_seq'];
                            $t_arr['mdMedi'] = $d['mdMedi'];
                            $t_arr['md_code'] = $d['md_code'];
                            $t_arr['mdMediName'] = $d['mdMediName'];
                            $t_arr['mm_medicine'] = $d['mm_medicine'];
                            $t_arr['md_title_kor'] = $d['md_title_kor'];
                            $t_arr['md_maker'] = $d['md_maker'];
                            $t_arr['mdMedi'] = $d['mdMedi'];
                            $t_arr['mm_origin'] = $d['mm_origin'];
                            $t_arr['md_maker'] = $d['md_maker'];
                            $t_arr['m_cnt'] = $herb_m->Cnt_Product_Match($d['mdMedi'],$cfcode,$d['mm_medicine']);


                            array_push($list, $t_arr);
                        }

                        $result = 'ok';
                        $data = ['list' => $list];
                        $message = '';
                    }
                }
            }
        }

        $return = [
            'result' => $result,
            'info' => $data,
            'message' => $message
        ];
        return $this->respond($return);
    }

    public function Load_Decoc_Match_Info2(){
        $sessinarr = $this->GetSessionData();
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $list1 = [];
            $list2 = [];
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            $mi_cfcode = $sessinarr['user']['mi_cf'];
            if ($mi_type == AUTH_PHARM) {
                $result = 'error';
                $list1 = [];
                $list2 = [];
                $message = '권한이외의 접근입니다.';
            } else {
                $hncode = ($this->request->getPost('code') == '') ? '' : $this->request->getPost('code');
                if ($hncode == '') {
                    $result = 'error';
                    $list1 = [];
                    $list2 = [];
                    $message = '잘못된 접근입니다.';
                } else {
                    $herb_m = model('Herb_m');
                    $Rs = $herb_m->Load_Product_Code($hncode);
                    if(fn_ArrayCnt($Rs)<=0){
                        $result = 'error';
                        $list1 = [];
                        $list2 = [];
                        $message = '존재하지 않는 약재입니다.';
                    }else{
                        $medicode = $Rs[0]['fk_medicode'];
                        $mediorgin = $Rs[0]['fk_ncode'];

                        $Rs = $herb_m->Load_Product_MatchedForPharm($hncode,$mi_cfcode);
                        if(fn_ArrayCnt($Rs)<=0) {
                            $list1 = [];
                            $mmMedicineList = [];
                        }else{
                            $list1 = [];
                            $mmMedicineList = [];
                            foreach ($Rs as $d){
                                $t_arr = [];

                                $t_arr['sn'] = $d['sn'];
                                $t_arr['mm_medicine'] = $d['mm_medicine'];
                                $t_arr['fk_mdMedi'] = $d['fk_mdMedi'];
                                $t_arr['md_title_kor'] = $d['md_title_kor'];
                                $t_arr['mm_origin'] = $d['mm_origin'];
                                $t_arr['md_maker'] = $d['md_maker'];

                                array_push($list1,$t_arr);
                                $mmMedicineList[] = $d['mm_medicine'];
                            }
                        }

                        $apiUrl = fn_ENV_URL() . "/manager/medicine/?apiCode=medicineclientlist&language=kor&ckCfcode={$mi_cfcode}&medicode={$medicode}&mmorigin={$mediorgin}&reData=smartorder";
                        $retVal = fn_CURL($apiUrl, 'get');
                        if (empty($retVal)) {
                            $result = 'type102';
                            $list1 = [];
                            $list2 = [];
                            $message = '통신장애로 데이터로드에 실패하였습니다.<br>다시 시도 하여주세요.[Error101]';
                        } else if($retVal['resultCode']=='200'){
                            $list2 = [];
                            foreach($retVal['list'] as $d) {
                                if (!in_array($d['mm_medicine'], $mmMedicineList)) {
                                    $t_arr = [];

                                    $t_arr['mm_seq'] = $d['mm_seq'];
                                    $t_arr['mdMedi'] = $d['mdMedi'];
                                    $t_arr['md_code'] = $d['md_code'];
                                    $t_arr['mdMediName'] = $d['mdMediName'];
                                    $t_arr['mm_medicine'] = $d['mm_medicine'];
                                    $t_arr['md_title_kor'] = $d['md_title_kor'];
                                    $t_arr['md_maker'] = $d['md_maker'];
                                    $t_arr['mdMedi'] = $d['mdMedi'];
                                    $t_arr['mm_origin'] = $d['mm_origin'];
                                    $t_arr['md_maker'] = $d['md_maker'];


                                    array_push($list2, $t_arr);
                                }
                            }
                            $result = 'ok';
                            $message = '';
                        }
                    }
                }
            }
        }

        $i_arr = [
          'list1' => $list1,
          'list2' => $list2
        ];
        $return = [
            'result' => $result,
            'info' => $i_arr,
            'message' => $message
        ];
        return $this->respond($return);
    }


    public function Load_Decoc_Match_Info(){
