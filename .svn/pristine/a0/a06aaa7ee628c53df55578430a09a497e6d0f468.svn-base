        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            $mi_code = $sessinarr['user']['mi_code'];
            if ($mi_type != 'decoc') {
                $result = 'type111';
                $info = '';
                $page = '';
                $message = '권한이외의 접근입니다.';
