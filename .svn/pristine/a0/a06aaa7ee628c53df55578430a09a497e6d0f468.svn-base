    public function Load_herb_Decoc()
    {
        $sessinarr = $this->GetSessionData();
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $info = '';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            $mi_code = $sessinarr['user']['mi_code'];
            if (($mi_type != AUTH_DECOC) && ($mi_type != AUTH_MASTER)) {
                $result = 'type101';
                $data = '';
                $message = '권한이외의 접근입니다.';
            } else {
                $page = ($this->request->getPost('page') == '') ? 1 : $this->request->getPost('page');
                $maxcnt = ($this->request->getPost('maxcnt') == '') ? 100 : $this->request->getPost('maxcnt');
                $cfCode = $sessinarr['user']['mi_cf'];

                $apiUrl = fn_ENV_URL() . "/manager/medicine/?apiCode=medicineclientlist&language=kor&ckCfcode={$cfCode}&ckStaffid=afsafd&v=1747622142118&page={$page}&psize={$maxcnt}&searchTxt=&searchStatus=undefined&searchmedicinetype=undefined&reData=smartorder";
                $retVal = fn_CURL($apiUrl, 'get');
                if (empty($retVal)) {
                    $dataarr = [];
                } else {
                    $herb_m = model('Herb_m');
                    $dataarr = [];
                    foreach($retVal['list'] as $d){
                        $temparr = [];

                        $temparr['mdMediName'] = $d['mdMediName'];
                        $temparr['md_maker'] = $d['md_maker'];
                        $temparr['md_code'] = $d['md_code'];
                        $temparr['md_medi'] = $d['md_medi'];
                        $temparr['boxcnt'] = $d['boxcnt'];
                        $temparr['mm_stable'] = $d['mm_stable'];
                        $temparr['md_title_kor'] = $d['md_title_kor'];
                        $temparr['mm_title_kor'] = $d['mm_title_kor'];
                        $temparr['mm_medicine'] = $d['mm_medicine'];
                        $temparr['mm_origin'] = $d['mm_origin'];

                        $info1 = $herb_m->Decoc_Match_Load($mi_code,$d['mm_medicine']);
                        $temparr['match_sn'] = (fn_ArrayCnt($info1)>0) ? $info1[0]['sn'] : '';

                        array_push($dataarr,$temparr);
                    }
                }

                $info = [
                    'page' => ($page + 1),
                    'list' => $dataarr
                ];

                $result = 'ok';
                $data = $info;
                $message = 'success';
            }
        }
        $return = [
            'result' => $result,
            'info' => $data,
            'message' => $message
        ];
        return $this->respond($return);
    }

    public function Load_Sale_Herb()
    {
        $sessinarr = $this->GetSessionData();
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $data = '';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_code = $sessinarr['user']['mi_code'];
            $mi_type = $sessinarr['user']['mi_type'];
            if($mi_type==AUTH_PHARM) {
                $result = 'AUTH_FAIL';
                $data = '';
                $message = '접근 권한이 없습니다.';
            }else if (($mi_type == AUTH_DECOC) || ($mi_type == AUTH_MASTER)) {
                $sKey = ($this->request->getPost('skey') == '') ? '' : $this->request->getPost('skey');
                $page = ($this->request->getPost('page') == '') ? 1 : $this->request->getPost('page');
                $pType = ($this->request->getPost('ptyp') == '') ? '' : $this->request->getPost('ptyp');
                $micode = ($this->request->getPost('pharm') == '') ? '' : $this->request->getPost('pharm');
                $cfCode = $sessinarr['user']['mi_cf'];

                $limit = 50;
                $offset = ($sKey == '') ? $limit * ($page - 1) : '';
                $herb_m = model('Herb_m');
                $param = [
                    'skey' => $sKey,
                    'micode' => $micode,
                    'ptyp' => $pType,
                    'limit' => $limit,
                    'offset' => $offset
                ];
                $Rs = $herb_m->Load_Product_Page_Sale($param);
                if (fn_ArrayCnt($Rs) > 0) {
                    $dataarr = [];
                    $loadstock = [];
                    $i = 0;
                    $location = [];
                    $price = [];
                    foreach ($Rs as $d) {
                        $temparr = [];

                        $temparr['sn'] = $d['sn'];
                        $temparr['hn_ID'] = $d['hn_ID'];
                        $temparr['hn_code'] = $d['hn_code'];
                        $temparr['fk_mdcode'] = $d['fk_mdcode'];
                        $temparr['fk_mdname'] = $d['fk_mdname'];
                        $temparr['fk_medicode'] = $d['fk_medicode'];
                        $temparr['fk_micode'] = $d['fk_micode'];
                        $temparr['mi_name'] = $d['mi_name'];
                        $temparr['fk_ncode'] = $d['fk_ncode'];
                        $temparr['n_value'] = $d['n_value'];

                        $temparr['fk_t1code'] = $d['fk_t1code'];
                        $temparr['t1_value'] = ($d['fk_t1code'] == '0') ? '' : $d['t1_value'];
                        $temparr['fk_t2code'] = $d['fk_t2code'];
                        $temparr['t2_value'] = $d['t2_value'];
                        $temparr['opt_str'] = $this->Product_Option_str($d['t1_value'],$d['t2_value']);
                        $temparr['fk_wcode'] = $d['fk_wcode'];
                        $temparr['w_value'] = $d['w_value'];
                        $temparr['w_name'] = $d['w_name'];
                        $temparr['hn_name'] = $d['hn_name'];

                        $temparr['hn_sale'] = $d['hn_sale'];
                        $temparr['hn_MakeDate'] = fn_Short_Date($d['hn_MakeDate']);
                        $temparr['hn_sellSDate'] = fn_Short_Date($d['hn_sellSDate']);
                        $temparr['hn_sellEDate'] = fn_Short_Date($d['hn_sellEDate']);


                        $temparr['hn_tax'] = $d['hn_tax'];
                        $temparr['hn_desc'] = $d['hn_desc'];
                        $temparr['hn_isSell'] = $d['hn_isSell'];
                        $temparr['sn'] = $d['sn'];
                        $temparr['hn_isok'] = $d['hn_isok'];
                        $temparr['hn_regdate'] = $d['hn_regdate'];
                        $temparr['fname'] = $d['thumnail'];

                        $temparr['hn_gPrice'] = $d['hn_gPrice'];
                        $temparr['hn_pPrice'] = $d['hn_pPrice'];
                        $temparr['hn_method'] = $d['hn_method'];
                        $temparr['hn_period'] = $d['hn_period'];
                        $temparr['hn_boxCnt'] = $d['hn_boxCnt'];
                        $temparr['hn_like'] = $herb_m->Cnt_Product_Like($d['hn_code'],$mi_code,$d['hn_method']);

                        $temparr['LowCnt'] = $this->LowPrice($d['fk_medicode'], $d['hn_gPrice'], $d['hn_method']);

                        $cRs = $herb_m->Load_Product_MatchedForPharm($d['hn_code'], $cfCode);
                        if (fn_ArrayCnt($cRs) > 0) {
                            $temparr['isMatch'] = 1;

                            $temparr['mm_medicine'] = $cRs[0]['mm_medicine'];
                            $temparr['stock'] = '-';
                            $temparr['common_stock'] = '-';
                            $temparr['month_stock'] = '-';
                            $temparr['recommand_stock'] = '-';

                            if (!in_array($cRs[0]['mm_medicine'], $loadstock)) {
                                $loadstock[] = $cRs[0]['mm_medicine'];
                            }

                            $data = [
                                'code' => $cRs[0]['mm_medicine'],
                                'location' => $i,
                                'r_stock' => $cRs[0]['mm_stock']
                            ];
                            array_push($location, $data);

                        } else {
                            $temparr['isMatch'] = 0;
                            $temparr['stock'] = '';
                            $temparr['common_stock'] = '';
                            $temparr['month_stock'] = '';
                            $temparr['recommand_stock'] = '';
                        }
                        array_push($dataarr, $temparr);
                        $i++;
                    }

                    if (fn_ArrayCnt($loadstock) > 0) {
                        $mmMedi = implode(',', $loadstock);
                        $apiUrl = fn_ENV_URL() . "/manager/medicine/?apiCode=medicinestock&language=kor&ckCfcode={$cfCode}&mmMedicine={$mmMedi}";
                        $retVal = fn_CURL($apiUrl, 'get');
                        if (!empty($retVal)) {
                            foreach ($retVal['list'] as $d) {
                                $key = $d[0];
                                $index = array_search($key, array_column($location, 'code'));
                                $loca = $location[$index]['location'];
                                $r_stock = $location[$index]['r_stock'];

                                $dataarr[$loca]['stock'] = number_format($d[2]);
                                $dataarr[$loca]['common_stock'] = number_format($d[1]);
                                $dataarr[$loca]['month_stock'] = number_format($d[3]);
                                $dataarr[$loca]['recommand_stock'] = number_format($r_stock);

                            }
                        }
                    }

                    if ($sKey != '') {
                        $n_arr = fn_ArrayMutiSorting($dataarr, 'stock', 'desc', 'hn_code', 'asc');
                    } else {
                        $n_arr = $dataarr;
                    }
                    $info = [
                        'page' => ($page + 1),
                        'list' => $n_arr,
                        'tCnt' => $herb_m->Cnt_Product_Page_Sale($param)
                    ];

                    $result = 'ok';
                    $data = $info;
                    $message = 'success';
                } else {
                    $info = [
                        'tCnt' => $herb_m->Cnt_Product_Page_Sale($param)
                    ];

                    $result = 'ok';
                    $data = $info;
                    $message = 'Empty';
                }
            }
        }

        $return = [
            'result' => $result,
            'info' => $data,
            'message' => $message
        ];
        return $this->respond($return);
    }



