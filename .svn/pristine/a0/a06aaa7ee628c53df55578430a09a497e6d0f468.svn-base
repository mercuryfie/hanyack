    public function Ship_Step()
    {
        $sessinarr = $this->GetSessionData();
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            $mi_code = $sessinarr['user']['mi_code'];
            if ($mi_type != AUTH_PHARM) {
                $result = 'type111';
                $message = '권한이외의 접근입니다.';
            } else {
                $key = ($this->request->getPost('key') == '') ? '' : $this->request->getPost('key');
                if ($key == '') {
                    $result = 'type112';
                    $message = '출하처리 할 목록을 확인하세요.';
                } else {
                    $order_m = model('Order_m');
                    $k_arr = explode(',', $key);
                    $Rs = $order_m->Load_Order_Goods_IN($k_arr);
                    if (fn_ArrayCnt($Rs) <= 0) {
                        $result = 'type113';
                        $message = '출하 항목 정보 로드에 실패하였습니다.';
                    } else {
                        $u_Cnt = 0;
                        $u_weight = 0;
                        foreach ($Rs as $d) {
                            $sn = $d['sn'];
                            $t_cnt = $d['gd_cnt'];
                            $weight = $d['w_value'];
                            $od_code = $d['fk_odcode'];
                            $gd_code = $d['gd_code'];
                            $od_wcode = $d['od_wcode'];
                            $od_wname = $d['od_wname'];

                            $tarr = [
                                'w_code' => $od_wcode,
                                'p_type' => 0
                            ];
                            $Rs2 = $order_m->Load_Package_Goods_Active($tarr);
                            if (fn_ArrayCnt($Rs2) <= 0) {
                                $fk_pcode = $this->Make_Code(6);
                                $marr = [
                                    'pcode' => $fk_pcode,
                                    'mi_code' => $mi_code,
                                    'w_code' => $od_wcode,
                                    'w_name' => $od_wname
                                ];
                                $Cnt = $order_m->Insert_Package($marr);
                            } else {
                                $fk_pcode = $Rs2[0]['pcode'];
                            }

                            $sarr = [
                                'pa_code' => $this->Make_Code(5),
                                'fk_pcode' => $fk_pcode,
                                'fk_odcode' => $od_code,
                                'fk_gdcode' => $gd_code,
                                't_cnt' => $t_cnt,
                                't_weight' => ($t_cnt * $weight),
                                'delidate' => fn_AddDay(2, 3)
                            ];
                            $Cnt = $order_m->Insert_Package_Goods($sarr);

                            $p_arr = [
                                'pcode' => $fk_pcode,
                                'cnt' => $t_cnt,
                                'weight' => ($t_cnt * $weight)
                            ];
                            $eCnt = $order_m->Update_Package_Info($fk_pcode, $p_arr);
                            $oCnt = $order_m->Update_Order_Goods_Sn($sn, ORDER_DELIVERY_READY);
                        }

                        $result = 'ok';
                        $message = 'success';
                    }
                }
            }
        }

        $return = [
            'result' => $result,
            'message' => $message
        ];
        return $this->respond($return);
    }

