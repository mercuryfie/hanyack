                $mm_origin = ($this->request->getPost('mm_origin') == '') ? '' : $this->request->getPost('mm_origin');
                $md_title_kor = ($this->request->getPost('md_title_kor') == '') ? '' : $this->request->getPost('md_title_kor');
                $md_maker = ($this->request->getPost('md_maker') == '') ? '' : $this->request->getPost('md_maker');
