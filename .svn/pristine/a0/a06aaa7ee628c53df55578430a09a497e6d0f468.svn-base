            'message' => $message
        ];
        return $this->respond($return);
    }


    public function Del_Match_Data()
    {
        $sessinarr = $this->GetSessionData();
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $data = '';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            if ($mi_type != AUTH_MASTER) {
                $result = 'type111';
                $data = '';
                $message = '권한이외의 접근입니다.';
            } else {
                $sn_arr = (fn_IsEmpty($this->request->getPost('data1'))) ? [] : $this->request->getPost('data1');
                $cfcode = ($this->request->getPost('cfcode') == '') ? '' : $this->request->getPost('cfcode');
                $mdMedi = ($this->request->getPost('mdMedi') == '') ? '' : $this->request->getPost('mdMedi');
                $mm_medicine  = ($this->request->getPost('mmMedi') == '') ? '' : $this->request->getPost('mmMedi');

                if((fn_ArrayCnt($sn_arr)<=0) || ($mdMedi=='') || ($cfcode=='')){
                    $result = 'type113';
                    $data = '';
                    $message = '잘못된 접근입니다.';
                }else{
                    $herb_m = model('Herb_m');
                    $Cnt = $herb_m->Delete_Product_Matches($cfcode,$mdMedi,$sn_arr);

                    $MCnt =  $herb_m->Cnt_Product_Match($mdMedi,$cfcode,$mm_medicine);

                    $i_arr = [
                        'Match' =>  $MCnt
                    ];

                    $result = 'ok';
                    $data = $i_arr;
                    $message = '';
                }
            }
        }

        $return = [
            'result' => $result,
            'info' => $data,
            'message' => $message
        ];
        return $this->respond($return);
    }

    public function Insert_Match_Data2(){
        $sessinarr = $this->GetSessionData();
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $data = '';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            $mi_cfcode = $sessinarr['user']['mi_cf'];
            if ($mi_type == AUTH_PHARM) {
                $result = 'type111';
                $data = '';
                $message = '권한이외의 접근입니다.';
            } else {
                $hncode = ($this->request->getPost('code') == '') ? '' : $this->request->getPost('code');
                $stock = ($this->request->getPost('stock') == '') ? '' : $this->request->getPost('stock');
                $str = ($this->request->getPost('str') == '') ? '' : $this->request->getPost('str');
                if($str==''){
                    $result = 'error';
                    $data = '';
                    $message = '잘못된 접근입니다.';
                }else {
                    $param = [];
                    $d_arr = json_decode($str, true);
                    $herb_m = model('Herb_m');
                    $cRs = $herb_m->Load_Product_Code($hncode);
                    if(fn_ArrayCnt($cRs)<=0){
                        $result = 'error';
                        $data = '';
                        $message = '존재하지 않는 약재입니다.';
                    }else{
                        $wcode = $cRs[0]['fk_micode'];
                        foreach ($d_arr as $d) {
                            $t_arr = [];

                            $t_arr['fk_hncode'] = $hncode;
                            $t_arr['fk_cfcode'] = $mi_cfcode;
                            $t_arr['fk_micode'] = $wcode;
                            $t_arr['fk_mdMedi'] = $d['mdMedi'];
                            $t_arr['fk_mdcode'] = $d['md_code'];
                            $t_arr['mm_medicine'] = $d['mm_medicine'];
                            $t_arr['mm_origin'] = $d['mm_origin'];
                            $t_arr['md_title_kor'] = $d['md_title_kor'];
                            $t_arr['md_maker'] = $d['md_maker'];
                            $t_arr['mm_stock'] = $stock;

                            array_push($param,$t_arr);

                        }

                        if(fn_ArrayCnt($param)>0){
                            $eCnt = $herb_m->Insert_Product_Matches($param);

                        }

                        $MCnt =  $herb_m->Cnt_Product_Match2($hncode,$mi_cfcode);

                        $i_arr = [
                            'Match' =>  $MCnt
                        ];

                        $result = 'ok';
                        $data = $i_arr;
                        $message = '';
                    }
                }
            }
        }
        $return = [
            'result' => $result,
            'info' => $data,
            'message' => $message
        ];
        return $this->respond($return);

    }

    public function Insert_Match_Data(){
