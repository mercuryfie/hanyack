                $page = ($this->request->getPost('page') == '') ? '1' : $this->request->getPost('page');

                $order_m = model('Order_m');
                $Rs = $order_m->Load_Order_Package_Decoc($mi_code);
                if (fn_ArrayCnt($Rs) <= 0) {
