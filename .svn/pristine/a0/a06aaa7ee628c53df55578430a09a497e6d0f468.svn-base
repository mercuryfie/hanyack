                        $t_arr['delitype'] = $d['delitype'];
                        $t_arr['delicode'] = $d['delicode'];
                        $t_arr['delidate'] = $d['delidate'];
                        $t_arr['p_type'] = $d['p_type'];
                        $t_arr['pa_regdate'] = fn_Short_Date($d['pa_regdate']);

