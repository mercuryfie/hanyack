    }

    public function Insert_DeliInfo()
    {
        $sessinarr = $this->GetSessionData();

        // 1. 로그인 체크
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            $mi_code = $sessinarr['user']['mi_code'];

            if ($mi_type != AUTH_DECOC) {
                $result = 'type101';
                $message = '권한이외의 접근입니다.';
            } else {
                foreach ($this->request->getPost() as $key => $value) {
                    $post[$key] = $value;
                }
                if (empty($post)) {
                    $result = 'type102';
                    $message = '잘못된 접근입니다.';
                } else {
                    $pcode = $post['zonecode'];
                    $Add1 = $post['Add1'];
                    $Add2 = $post['Add2'];
                    $miname = $post['miname'];
                    $ctc = $post['ctc'];
                    $isDefault = $post['isDefault'];

                    $herb_m = model('Herb_m');
                    $Rs = $herb_m->Load_DelInfo(['fk_micode' => $mi_code]);

                    $db_micode = '';

                    if (!empty($Rs)) {
                        $db_micode = $Rs[0]['fk_micode'];
                    }

                    if ($db_micode != $mi_code) {
                        $result = 'type108';
                        $message = '변경 권한이 없습니다.';
                    } else {
                        if (fn_ArrayCnt($Rs) <= 0) {
                            $result = 'type102';
                            $message = '해당 제약사가 존재하지 않습니다.';
                        } else {
                            if ($isDefault == 1) {
                                $isZero = 0;

                                $Cnt = $herb_m->Update_DelInfo_SetAllAsZero($mi_code,$isZero);
                                if ($Cnt <= 0) {
                                    $result = 'type103';
                                    $message = '기본 배송지 저장에 실패 하였습니다.';
                                } else {
                                    $param2 = [
                                        'fk_micode' => $mi_code,
                                        'mi_zip' => $pcode,
                                        'mi_Address1' => $Add1,
                                        'mi_Address2' => $Add2,
                                        'mi_name' => $miname,
                                        'mi_tel' => $ctc,
                                        'isDefault' => 1
                                    ];
                                    $Cnt2 = $herb_m->Insert_DelInfo($param2);
                                    if ($Cnt2 <= 0) {
                                        $result = 'type104';
                                        $message = '새로운 주소 등록 실패';
                                    } else {
                                        $result = 'ok';
                                        $message = 'success';

                                    }
                                }
                            } else if ($isDefault == 0){
                                $param3 = [
                                    'fk_micode' => $mi_code,
                                    'mi_zip' => $pcode,
                                    'mi_Address1' => $Add1,
                                    'mi_Address2' => $Add2,
                                    'mi_name' => $miname,
                                    'mi_tel' => $ctc,
                                    'isDefault' => 0
                                ];

                                $Cnt3 = $herb_m->Insert_DelInfo($param3);
                                if ($Cnt3 <= 0) {
                                    $result = 'type105';
                                    $message = '새로운 주소 등록 실패2';
                                } else {
                                    $result = 'ok';
                                    $message = 'success';
                                }
                            } else {
                                $result = 'type106';
                                $message = '새로운 주소 등록 실패3';

                            }
                        }

                    }
                }
            }
        }

        $return = [
            'result' => $result,
            'message' => $message
        ];
        return $this->respond($return);
    }

    public function Update_DeliInfo()
    {
        $sessinarr = $this->GetSessionData();

        // 1. 로그인 체크
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            $mi_code = $sessinarr['user']['mi_code'];

            if ($mi_type != AUTH_DECOC) {
                $result = 'type101';
                $message = '권한이외의 접근입니다.';
            } else {
                foreach ($this->request->getPost() as $key => $value) {
                    $post[$key] = $value;
                }
                if (empty($post)) {
                    $result = 'type102';
                    $message = '잘못된 접근입니다.';
                } else {
                    $sn = $post['sn'];
                    $pcode = $post['zonecode'];
                    $Add1 = $post['Add1'];
                    $Add2 = $post['Add2'];
                    $miname = $post['miname'];
                    $ctc = $post['ctc'];
                    $isDefault = $post['isDefault'];

                    $herb_m = model('Herb_m');
                    $param = [];
                    $Rs = $herb_m->Load_DelInfo_Sn(['sn' => $sn]);
                    $Cnt = fn_ArrayCnt($Rs);
                    if (fn_ArrayCnt($Rs) <= 0) {
                        $result = 'type102';
                        $message = '해당 주소 정보가 존재하지 않습니다.';
                    } else {
                        $dbSn = '';
                        $db_micode = '';
                        if (!empty($Rs)) {
                            $dbSn = $Rs[0]['sn'];
                            $db_micode = $Rs[0]['fk_micode'];
                            $echo = $sn;
                            $echo2 = $dbSn;
                        }
                        if ($db_micode != $mi_code) {
                            $result = 'type108';
                            $message = '변경 권한이 없습니다.';
                        } else {
                            if ($dbSn != $sn) {
                                $result = 'type109';
                                $message = '해당 주소가 없습니다.';
                            } else {
                                if ($isDefault == 1) {
                                    $isZero = 0;

                                    $Cnt = $herb_m->Update_DelInfo_SetAllAsZero($mi_code,$isZero);
                                    if ($Cnt <= 0) {
                                        $result = 'type103';
                                        $message = '기본 배송지 저장에 실패 하였습니다.';
                                        echo ($mi_code);
                                    } else {
                                        $param2 = [
                                            'sn' => $sn,
                                            'fk_micode' => $mi_code,
                                            'mi_zip' => $pcode,
                                            'mi_Address1' => $Add1,
                                            'mi_Address2' => $Add2,
                                            'mi_name' => $miname,
                                            'mi_tel' => $ctc,
                                            'isDefault' => 1
                                        ];
                                        $Cnt2 = $herb_m->Update_DelInfo($param2);
                                        if ($Cnt2 <= 0) {
                                            $result = 'type104';
                                            $message = '새로운 주소 등록 실패';
                                        } else {
                                            $result = 'ok';
                                            $message = 'success';

                                        }
                                    }
                                } else if ($isDefault == 0){
                                    $param3 = [
                                        'fk_micode' => $mi_code,
                                        'mi_zip' => $pcode,
                                        'mi_Address1' => $Add1,
                                        'mi_Address2' => $Add2,
                                        'mi_name' => $miname,
                                        'mi_tel' => $ctc,
                                        'isDefault' => 0
                                    ];

                                    $Cnt3 = $herb_m->Update_DelInfo($param3);
                                    if ($Cnt3 <= 0) {
                                        $result = 'type105';
                                        $message = '새로운 주소 등록 실패2';
                                    } else {
                                        $result = 'ok';
                                        $message = 'success';
                                    }
                                } else {
                                    $result = 'type106';
                                    $message = '새로운 주소 등록 실패3';

                                }
                            }


                        }

                    }
                }
            }
        }

        $return = [
            'result' => $result,
            'message' => $message,
            'param' => $param
        ];
        return $this->respond($return);
    }

