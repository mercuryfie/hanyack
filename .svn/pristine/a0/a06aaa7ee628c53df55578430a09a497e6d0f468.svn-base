//    public function Update_product_Edited()
    public function Insert_BContent(){

        foreach ($this->request->getPost() as $key => $value) {
            $post[$key] = $value;
        }

        if(empty($post)){
            $result = 'type101';
            $code = '';
            $message = '필수 입력값을 확인하여주세요.';
        }else{
            $sessinarr = $this->GetSessionData();
            $userid = $sessinarr['user']['userid'];
            $data = [
                'uid' => $post['p_uid'],
                'writer' => $userid,
                'bid' => $post['bid'],
                'btyp' => $post['btyp'],
                'bTitle' => $post['bTitle'],
                'bContent' => $post['bContent'],
                'isDel' => 0,
                'regidate' => date('Y-m-d H:i:s')
            ];

            $board_m = model('Board_m');
            $bcode = $board_m->Insert_Board($data);
            if($bcode <= 0){
                $result = 'type102';
                $code = '';
                $message  = '';
            }else{
                $result = 'ok';
                $code = $bcode;
                $message  = 'success';
            }
        }

        $return = [
            'result' => $result,
            'code' => $code,
            'msg' => $message
        ];
        return $this->respond($return);
    }


    public function Update_Edited_BContent()
    {

        $request = service('request') ;
        $post = [];
        foreach ($request->getPost() as $key => $value) {
            $post[$key] = $value;
        }

        if(empty($post)){
            $result = 'type101';
            $message = '필수 입력값을 확인하여주세요.';
        } else {
            $sessinarr = $this->GetSessionData();
            $uid = $sessionarr['user']['uid'];
            $b_uid = ($request->getPost('b_uid') == '') ? '' : $request->getPost('b_uid');
            $bcode = ($request->getPost('bcode') == '') ? '' : $request->getPost('bcode');
            if ($uid != $b_uid) {
                $result = 'type102';
                $message = '계정 권한을 확인하여주세요.';
            } else {
                $data = [
                    'btyp' => $post['btyp'],
                    'bTitle' => $post['bTitle'],
                    'bContent' => $post['bContent'],
                    'isDel' => 0,
                    'update_date' => date('Y-m-d H:i:s')
                ];
                $board_m = model('Board_m');
                $bcode = $board_m->Update_Board($bcode,$data);
                if($bcode <= 0){
                    $result = 'type102';
                    $message  = 'nothing updated';
                }else{
                    $result = 'ok';
                    $message  = 'success';
                }
            }
            $return = [
                'result' => $result,
                'msg' => $message
            ];
            return $this->respond($return);

        }
    }

    public function Insert_RContent()
    {

        $request = service('request') ;
        $post = [];
        foreach ($request->getPost() as $key => $value) {
            $post[$key] = $value;
        }

        if(empty($post)){
            $result = 'type101';
            $message = '필수 입력값을 확인하여주세요.';
        } else {
            $sessinarr = $this->GetSessionData();
            $mi_type = $sessionarr['user']['mi_type'];
            $bcode = ($request->getPost('bcode') == '') ? '' : $request->getPost('bcode');
            if ($mi_type != AUTH_MASTER) {
                $result = 'type102';
                $message = '계정 권한을 확인하여 주세요.';

            } else {

                $data = [
                    'fk_bcode' => $bcode,
                    'rContent' => $post['rContent'],
                    'isDel' => 0,
                    'regidate' => date('Y-m-d H:i:s')
                ];
                $board_m = model('Board_m');
                $bcode = $board_m->Insert_Board_Reply($data);
                if($bcode <= 0){
                    $result = 'type102';
                    $message  = 'nothing inserted';
                }else{
                    $result = 'ok';
                    $message  = 'success';
                }
            }
            $return = [
                'result' => $result,
                'msg' => $message
            ];
            return $this->respond($return);

        }
    }

    public function Re_Approval(){
        $sessinarr = $this->GetSessionData();

        // 1. 로그인 체크
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            if ($mi_type != AUTH_PHARM) {
                $result = 'type101';
                $message = '권한이외의 접근입니다.';
            } else {
                $hncode = ($this->request->getPost('hncode') == '') ? '' : $this->request->getPost('hncode');
                if ($hncode == '') {
                    $result = 'type102';
                    $message = '잘못된 접근입니다.';
                }else{
                    $param = [
                        'hn_isok' => 0
                    ];
                    $herb_m = model('Herb_m');
                    $Cnt = $herb_m->Update_Product_Info($hncode,$param);
                    if($Cnt <= 0){
                        $result = 'type104';
                        $message = '반려 사유 등록에 실패 하였습니다';

                    }else{
                        $result = 'ok';
                        $message = 'success';
                    }
                }
            }
        }

        $return = [
            'result' => $result,
            'data' => '',
            'message' => $message
        ];
        return $this->respond($return);
    }

    public function Load_ProductEvent(){
        $hncode = ($this->request->getPost('code') == '') ? '' : $this->request->getPost('code');
        if($hncode==''){
            $result = 'error';
            $data = '';
            $message = '잘못된 접근입니다.';
        }else {
            $sessinarr = $this->GetSessionData();
            if (!$sessinarr['islogin']) {
                $result = 'NoLogin';
                $data = '';
                $message = '로그인을 하셔야 합니다.';
            }else {
                $mi_type = $sessinarr['user']['mi_type'];
                if ($mi_type != AUTH_MASTER) {
                    $result = 'AUTH_FAIL';
                    $data = '';
                    $message = '접근 권한이 없습니다.1';
                } else {
                    $herb_m = model('Herb_m');
                    $fields = ['a.sn','a.fk_hncode','a.f_type','b.fk_mdname','b.hn_name'];
                    $Rs = $herb_m->Load_ProductEvent($hncode,$fields);
                    if(fn_ArrayCnt($Rs) <= 0) {
                        $result = 'ok';
                        $data = '';
                        $message = '';
                    } else {
                        $dataarr = [];
                        foreach ($Rs as $d){
                            $temparr = [];

                            $temparr['sn'] = $d['sn'];
                            $temparr['fk_hncode'] = $d['fk_hncode'];
                            $temparr['f_type'] = $d['f_type'];
                            $temparr['fk_mdname'] = $d['fk_mdname'];
                            $temparr['hn_name'] = $d['hn_name'];

                            array_push($dataarr, $temparr);
                        }


                        $i_arr = [
                            'list' => $dataarr
                        ];

                        $result = 'ok';
                        $data = $i_arr;
                        $message = 'success';

                    }
                }
            }
        }
        $return = [
            'result' => $result,
            'info' => $data,
            'message' => $message
        ];
        return $this->respond($return);
    }


    public function Insert_Product_Event(){
        $hncode = ($this->request->getPost('code') == '') ? '' : $this->request->getPost('code');
        $etype = ($this->request->getPost('etype') == '') ? '' : $this->request->getPost('etype');
        if(($hncode=='') || ($hncode=='')) {
            $result = 'error';
            $data = '';
            $message = '잘못된 접근입니다.';
        }else {
            $sessionarr = $this->GetSessionData();
            if (!$sessionarr['islogin']) {
                $result = 'NoLogin';
                $data = '';
                $message = '로그인을 하셔야 합니다.';
            } else {
                $mi_type = $sessionarr['user']['mi_type'];
                if ($mi_type != AUTH_MASTER) {
                    $result = 'type111';
                    $data = '';
                    $message = '권한이외의 접근입니다.';
                } else {
                    $type_str = '';
                    if($etype==1){
                        $type_str = '인기 약재';
                    }else if($etype==2){
                        $type_str = '추천 약재';
                    }else if($etype==3) {
                        $type_str = '신규 약재';
                    }


                    $herb_m = model('Herb_m');
                    $Rs = $herb_m->Load_ProductEvent_Only($hncode,$etype);
                    if(fn_ArrayCnt($Rs)>0){
                        $result = 'error';
                        $data = '';
                        $message = "이미 {$type_str} 로 등록되어 있는 약재입니다.";
                    }else{
                        $param = [
                            'fk_hncode' => $hncode,
                            'f_type' => $etype
                        ];
                        $sn = $herb_m->Insert_ProductEvent($param);

                        $i_arr = [
                          'sn' => $sn
                        ];

                        $result = 'ok';
                        $data = $i_arr;
                        $message = "";
                    }
                }
            }
        }
        $return = [
            'result' => $result,
            'info' => $data,
            'message' => $message
        ];
        return $this->respond($return);
    }


    public function Insert_ProductEvent(){
        $sessionarr = $this->GetSessionData();
        if (!$sessionarr['islogin']) {
            $result = 'NoLogin';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessionarr['user']['mi_type'];
            if ($mi_type != AUTH_MASTER) {
                $result = 'type111';
                $message = '권한이외의 접근입니다.';
            }else{
                foreach ($this->request->getPost() as $key => $value) {
                    $post[$key] = $value;
                }
                if (empty($post)) {
                    $result = 'type102';
                    $message = '잘못된 접근입니다.';
                } else {
                    $sn = $post['sn'];
                    $hncode = $post['hncode'];
                    $ftype = $post['ftype'];

                    if (empty($ftype)) {
                        $ftypes = [];
                    } else {
                        $ftypes = is_array($ftype) ? $ftype : [$ftype];
                    }

                    $param = [
                        'f_type' =>  $ftype,
                        'fk_hncode' =>  $hncode
                    ];

                    $herb_m = model('Herb_m');
                    $Rs = $herb_m->Load_ProductEvent_Only($hncode);

                    if (!empty($Rs)) {
                        foreach ($Rs as $row) {
                            $db_hncode[] = $row['hncode'];
                            $db_ftype[] = $row['f_type'];
                        }
                    }

                    $d_arr = [];
                    if ($ftype == $row['f_type']) {
                        $result = 'type108';
                        $message = '이미 등록된 event 입니다.';
                    } else {
                        foreach ($d_arr as $d) {
                            $param = [
                                'fk_hncode' => $hncode,
                                'f_type' => $ftype,
                                'regidate' => date('Y-m-d H:i:s')
                            ];
                            $herb_m->Insert_ProductEvent($param);
                        }
                        $result = 'success';
                        $message = count($d_arr) . '건 등록되었습니다.';
                    }
                }
            }
        }
        $return = [
            'result' => $result,
            'message' => $message
        ];
        return $this->respond($return);


    }
}
    