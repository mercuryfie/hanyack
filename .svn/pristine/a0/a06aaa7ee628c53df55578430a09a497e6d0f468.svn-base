    public function Update_Deli_Data(){
        $sessinarr = $this->GetSessionData();
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            $mi_code = $sessinarr['user']['mi_code'];
            if ($mi_type != 'pharm') {
                $result = 'type111';
                $message = '권한이외의 접근입니다.';
            } else {
                $pcode = ($this->request->getPost('pcode') == '') ? '' : $this->request->getPost('pcode');
                if ($pcode == '') {
                    $result = 'type112';
                    $message = '출하 정보를 확인하세요.';
                } else {
                    $order_m = model('Order_m');
                    $Rs = $order_m->Load_Order_Package_List($pcode);
                    if (fn_ArrayCnt($Rs) <= 0) {
                        $result = 'type113';
                        $message = '해당 출고코드에 등록되어 있는 약재가 없습니다.';
                    } else {
                        $t_arr = [];
                        foreach ($Rs as $d) {
                            $t_arr[] = $d['oSN'];
                        }
                        $herb_m = model('Herb_m');
                        $rCnt = $herb_m->Update_Order_Step2($t_arr, ORDER_DELIVERY_READY);

                        $param = [
                            'p_type' => PACKAGE_SHIP_READY
                        ];
                        $Cnt = $order_m->Update_Deli_info($pcode, $param);

                        $result = 'ok';
                        $message = '';
                    }
                }
            }
        }
        $return = [
            'result' => $result,
            'message' => $message
        ];
        return $this->respond($return);
    }

    public function Load_Board_List(){
        $sessinarr = $this->GetSessionData();
        if (!$sessinarr['islogin']) {
            $data = '';
            $result = 'NoLogin';
            $message = 'NOT LOGIN';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            $bid = ($this->request->getPost('bid') == '') ? '1' : ($this->request->getPost('bid'));
            $page = ($this->request->getPost('page') == '') ? '1' : ($this->request->getPost('page'));
            $limit = 15;
            $offset = $limit * ($page - 1);


            $mi_code = $sessinarr['user']['mi_code'];
            $param = [
                'bid' => $bid,
                'limit' => $limit,
                'offset' => $offset
            ];

            $board_m = model('Board_m');
            $dataarr = [];
            $contents_data = $board_m->Load_Board_Page($param);

            if(fn_ArrayCnt($contents_data) <= 0) {
                $result = 'null';
                $info = '';
                $message = '게시글이 없습니다.';

            } else {
                foreach ($contents_data as $d){
                    $temparr = [];

                    $temparr['bcode']       = $d['bcode'];
                    $temparr['bid']         = $d['bid'];
                    $temparr['bTitle']      = $d['bTitle'];
                    $temparr['writer']      = $d['writer'];
                    $temparr['uid']         = $d['uid'];
                    $temparr['userid']         = $d['userid'];
                    $temparr['mitype']         = $mi_type;

                    $btyp_str = '';
                    if ($d['bid'] == 1) {
                        if ($d['btyp'] == 1) {
                            $btyp_str = '일반';
                        } else if ($d['btyp'] == 2) {
                            $btyp_str = '공지';
                        } else if ($d['btyp'] == 3) {
                            $btyp_str = '서버관련';
                        } else if ($d['btyp'] == 4) {
                            $btyp_str = '기타';
                        }
                    } else if ($d['bid'] == 2) {
                        if ($d['btyp'] == 1) {
                            $btyp_str = '시스템오류';
                        } else if ($d['btyp'] == 2) {
                            $btyp_str = '주문/배송';
                        } else if ($d['btyp'] == 3) {
                            $btyp_str = '취소/교환/반품';
                        } else if ($d['btyp'] == 4) {
                            $btyp_str = '기타';
                        }
                    } else if ($d['bid'] == 3) {
                        if ($d['btyp'] == 1) {
                            $btyp_str = '시스템오류';
                        } else if ($d['btyp'] == 2) {
                            $btyp_str = '주문/배송';
                        } else if ($d['btyp'] == 3) {
                            $btyp_str = '취소/교환/반품';
                        } else if ($d['btyp'] == 4) {
                            $btyp_str = '기타';
                        }
                    } else {
                        $btyp_str = '기타';
                    }

                    $temparr['btyp']         = $btyp_str;

                    $temparr['bHit']        = $d['bHit'];
                    $temparr['brecom']      = $d['brecom'];
                    $temparr['bReply']      = $d['bReply'];
                    $temparr['depth']       = $d['depth'];
                    $temparr['bContent']    = $d['bContent'];

                    $temparr['isAgree']     = $d['isAgree'];
                    $temparr['isFix']       = $d['isFix'];
                    $temparr['isDel']       = $d['isDel'];
                    $temparr['regidate']    = $d['regidate'];
                    $temparr['update_date'] = $d['update_date'];

                    $att = $board_m->Load_Board_Attachment($d['bcode']); //파일정보 읽어오기 //path / fname 파일경로 만들고
                    $fileInfo = (is_array($att) && count($att) > 0) ? $att[0] : null;

                    if ($fileInfo) {
                        $filePath = $fileInfo['path'] . '/' . $fileInfo['fname'];
                    } else {
                        $filePath = '';
                    }

                    $temparr['filePath'] = $filePath;

                    $bcode = $d['bcode'];
                    $reply = $board_m->Load_Board_RContent($bcode);

                    $reparr = [];
                    if (fn_ArrayCnt($reply) > 0) {
                        foreach ($reply as $f) {
                            $t_arr = [];
                            $t_arr['fk_bcode'] = $f['fk_bcode'];
                            $t_arr['rContent'] = $f['rContent'];
                            $t_arr['regidate'] = $f['regidate'];
                           array_push($reparr,$t_arr);
                        }
                    }
                    $temparr['reply'] = $reparr;

                    array_push($dataarr, $temparr);
                }
            }

            $info = [
                'page' => ($page + 1),
                'limit' => $limit,
                'offset' => $offset,
                'list' => $dataarr,
            ];

            $result = 'ok';
            $data = $info;
            $message = 'success';
        }

        $return = [
            'result' => $result,
            'info' => $data,
            'message' => $message
        ];
        return $this->respond($return);

    }


    public function Insert_Package_Deli_Data(){
        $sessinarr = $this->GetSessionData();
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            $mi_code = $sessinarr['user']['mi_code'];
            if ($mi_type != 'pharm') {
                $result = 'type111';
                $message = '권한이외의 접근입니다.';
            } else {
                $deltype = ($this->request->getPost('deltype') == '') ? '' : $this->request->getPost('deltype');
                $delcode = ($this->request->getPost('delcode') == '') ? '' : $this->request->getPost('delcode');
                $pcode = ($this->request->getPost('pcode') == '') ? '' : $this->request->getPost('pcode');
                if (($deltype == '') || ($delcode == '') || ($pcode == '')) {
                    $result = 'type112';
                    $message = '출하 정보를 확인하세요.';
                } else {
                    $order_m = model('Order_m');
                    $Rs = $order_m->Load_Order_Package_List($pcode);
                    if (fn_ArrayCnt($Rs) <= 0) {
                        $result = 'type113';
                        $message = '존재하지 않는 출고 내역입니다.';
                    } else {
                        $Log = '';
                        $t_arr = [];
                        foreach ($Rs as $d) {
                            $sn = $d['sn'];
                            $t_arr[] = $d['oSN'];
                            $Log .= $sn . '|' . $d['pa_code'] . '/';
                        }
                        $herb_m = model('Herb_m');
                        $rCnt = $herb_m->Update_Order_Step2($t_arr, ORDER_DELIVERING);
                        $dCnt = $herb_m->Update_Order_delicode($t_arr, $delcode,$deltype);
                        $typ = $this->OrderStepName(ORDER_DELIVERING);
                        $this->Log_Reg($mi_code, $typ, $Log);

                        $param = [
                            'delitype' => $deltype,
                            'delicode' => $delcode,
                            'p_type' => PACKAGE_SHIP_START
                        ];

                        $Cnt = $order_m->Update_Deli_info($pcode, $param);

                        $result = 'ok';
                        $message = '';
                    }
                }
            }
        }
        $return = [
            'result' => $result,
            'message' => $message
        ];
        return $this->respond($return);
    }


    public function Load_Package_Decoc(){
