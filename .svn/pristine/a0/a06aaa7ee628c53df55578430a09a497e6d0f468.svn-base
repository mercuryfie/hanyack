    public function Update_Product_IsOk()
    {
        $sessinarr = $this->GetSessionData();

        // 1. 로그인 체크
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            // 2. 권한 체크 (마스터만 통과)
            if ($mi_type != AUTH_MASTER) {
                $result = 'type101';
                $message = '권한이외의 접근입니다.';
            } else {
                $hncode = ($this->request->getPost('hncode') == '') ? '' : $this->request->getPost('hncode');
                $hntype = ($this->request->getPost('hntype') == '') ? '' : $this->request->getPost('hntype');

                if ((empty($hncode)) || (($hntype == ''))) {
                    $result = 'type102';
                    $message = '잘못된 접근입니다.';
                } else {
                    $herb_m = model('Herb_m');
                    $in_code = explode(',', $hncode);
                    $param = [
                        'hn_isok' => $hntype
                    ];
                    $Cnt = $herb_m->Update_Product_Info_Wherein($in_code, $param);
                    if ($Cnt > 0) {
                        $result = 'ok';
                        $message = 'success';
                    } else {
                        $result = 'error';
                        $message = '적용된 약재가 없습니다.';
                    }
                }
            }
        }

        $return = [
            'result' => $result,
            'message' => $message
        ];
        return $this->respond($return);
    }

    public function Update_Cancel_Product()
    {
        $sessinarr = $this->GetSessionData();

        // 1. 로그인 체크
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            // 2. 권한 체크 (마스터만 통과)
            if ($mi_type != AUTH_MASTER) {
                $result = 'type101';
                $message = '권한이외의 접근입니다.';
            } else {
                foreach ($this->request->getPost() as $key => $value) {
                    $post[$key] = $value;
                }
                if (empty($post)) {
                    $result = 'type102';
                    $message = '잘못된 접근입니다.';
                } else {
                    $hncode = $post['hncode'];
                    $herb_m = model('Herb_m');

                    if (is_array($hncode)) {
                        $allSuccess = true;
                        foreach ($hncode as $code) {
                            $Rs = $herb_m->Load_Product_Code($code);
                            if (fn_ArrayCnt($Rs) <= 0) {
                                $result = 'type102';
                                $message = "해당 약재($code)는 존재하지 않습니다.";
                                $allSuccess = false;
                                break;
                            } else {
                                $data = ['hn_isok' => 0];
                                $param = ['hncode' => $code, 'data' => $data];
                                $Cnt = $herb_m->Update_Product_Info($hncode,$param);
                                if ($Cnt <= 0) {
                                    $result = 'type103';
                                    $message = "승인 실패 하였습니다. (약재코드: $code)";
                                    $allSuccess = false;
                                    break;
                                }
                            }
                        }
                        if ($allSuccess) {
                            $result = 'ok';
                            $message = 'success';
                        }
                    } else {
                        $Rs = $herb_m->Load_Product_Code($hncode);
                        if (fn_ArrayCnt($Rs) <= 0) {
                            $result = 'type102';
                            $message = '해당 약재는 존재하지 않습니다.';
                        } else {
                            $data = ['hn_isok' => 0];
                            $param = ['hncode' => $hncode, 'data' => $data];
                            $Cnt = $herb_m->Update_Product_Info($hncode,$param);
                            if ($Cnt <= 0) {
                                $result = 'type103';
                                $message = '승인 실패 하였습니다.';
                            } else {
                                $result = 'ok';
                                $message = 'success';
                            }
                        }
                    }
                }
            }
        }
        // 결과 반환
        return $this->response->setJSON([
            'result' => $result,
            'message' => $message
        ]);
    }

    public function Insert_Order()
    {
        $str = ($this->request->getPost('str') == '') ? '' : $this->request->getPost('str');
        if ($str == '') {
            $result = 'type101';
            $info = '';
            $message = '구매약재 정보를 확인하여주세요.';
        } else {
            $order = json_decode($str, true);
            if (($order == '') && (fn_ArrayCnt($order) <= 0)) {
                $result = 'type102';
                $info = '';
                $message = '구매약재 정보를 확인하여주세요.';
            } else {
                $sessinarr = $this->GetSessionData();
                if (!$sessinarr['islogin']) {
                    $result = 'NoLogin';
                    $info = '';
                    $message = '로그인을 하셔야 합니다.';
                } else {
                    $total = 0;
                    $mi_code = $sessinarr['user']['mi_code'];
                    $mi_type = $sessinarr['user']['mi_type'];
                    if ($mi_type == AUTH_PHARM) {
                        $result = 'type101';
                        $info = '';
                        $message = '권한이외의 접근입니다.';
                    } else {
                        $herb_m = model('Herb_m');

                        $od_code = $this->Make_Code(3);

                        $arr = [];
                        $tarr = [];
                        foreach ($order as $d) {
                            $p_arr = $this->LoadPrice($d['code']);
                            if (fn_ArrayCnt($p_arr) <= 0) {
                                exit();
                            } else {
                                $Cnt = $d['cnt'];
                                if ($d['ptyp'] == 1) {
                                    $gd_pType = 1;
                                    $gd_price = $p_arr[0]['hn_pPrice'];
                                    $gd_period = 0;
                                } else {
                                    $gd_pType = 2;
                                    $gd_price = $p_arr[1]['hn_pPrice'];
                                    $gd_period = $p_arr[1]['hn_period'];
                                }
                                $ntprice = ((int)$gd_price * (int)$Cnt);
                                $total += $ntprice;

                                $tarr = [
                                    'gd_code' => $this->Make_Code(4),
                                    'fk_odcode' => $od_code,
                                    'fk_hncode' => $d['code'],
                                    'gd_pType' => $gd_pType,
                                    'gd_period' => $gd_period,
                                    'gd_price' => $ntprice,
                                    'gd_cnt' => $Cnt,
                                    'gd_rPrice' => $gd_price,
                                ];

                                array_push($arr, $tarr);
                            }
                        }

                        if (empty($arr)) {
                            $result = 'type104';
                            $info = '';
                            $message = '구매약재 정보를 확인하여주세요.';
                        } else {
                            $param = [
                                'od_micode' => $mi_code,
                                'od_code' => $od_code,
                                'od_price' => $total
                            ];
                            $sn = $herb_m->Insert_Order($param);
                            if ($sn > 0) {
                                $Cnt = $herb_m->Insert_Order_Goods2($arr);
                            }

                            $result = 'ok';
                            $info = $od_code;
                            $message = 'success';
                        }
                    }
                }
            }
        }

        $return = [
            'result' => $result,
            'info' => $info,
            'message' => $message
        ];
        return $this->respond($return);

    }

    public function Insert_BigOrder()
    {
        $str = ($this->request->getPost('str') == '') ? '' : $this->request->getPost('str');
        if ($str == '') {
            $result = 'type101';
            $info = '';
            $message = '구매약재 정보를 확인하여주세요.';
        } else {
            $order = json_decode($str, true);
            if (fn_IsEmpty($order)) {
                $result = 'type102';
                $info = '';
                $message = '구매약재 정보를 확인하여주세요.';
            } else {
                $sessinarr = $this->GetSessionData();
                if (!$sessinarr['islogin']) {
                    $result = 'NoLogin';
                    $info = '';
                    $message = '로그인을 하셔야 합니다.';
                } else {
                    $mi_type = $sessinarr['user']['mi_type'];
                    if ($mi_type != AUTH_MASTER) {
                        $result = 'type101';
                        $data = '';
                        $message = '권한이외의 접근입니다.';
                    } else {
                        $herb_m = model('Herb_m');
                        $hncode = $order[0]['code'];
                        $cnt = $order[0]['cnt'];
                        $pType = $order[0]['ptyp'];
                        $w_code = $order[0]['wicode'];
                        $price = $order[0]['price'];
                        $mi_code = $order[0]['micode'];
                        $total = $price * $cnt;

                        $od_code = $this->Make_Code(3);
                        $param = [
                            'od_micode' => $mi_code,
                            'od_code' => $od_code,
                            'od_price' => $total
                        ];
                        $sn = $herb_m->Insert_Order($param);
                        if ($sn > 0) {

                            $tarr = [
                                'gd_code' => $this->Make_Code(4),
                                'fk_odcode' => $od_code,
                                'fk_hncode' => $hncode,
                                'gd_pType' => $pType,
                                'gd_period' => 0,
                                'gd_price' => $total,
                                'gd_cnt' => $cnt,
                                'gd_rPrice' => $price,
                            ];
                            $Cnt = $herb_m->Insert_Order_Goods2($tarr);

                            $info = [
                                'code' => $od_code
                            ];

                            $result = 'ok';
                            $data = $info;
                            $message = 'success';
                        } else {
                            $result = 'type104';
                            $info = '';
                            $message = '주문등록에 실패 하였습니다.다시 시도하여 주세요';
                        }
                    }
                }
            }
        }

        $return = [
            'result' => $result,
            'info' => $info,
            'message' => $message
        ];
        return $this->respond($return);

    }


    public function Match_Proc()
    {
        foreach ($this->request->getPost() as $key => $value) {
            $post[$key] = $value;
        }
        if (empty($post)) {
            $result = 'type101';
            $message = '필수 입력값을 확인하여주세요.';
        } else {
            $sessinarr = $this->GetSessionData();
            if (!$sessinarr['islogin']) {
                $result = 'NoLogin';
                $message = '로그인을 하셔야 합니다.';
            } else {
                $mi_type = $sessinarr['user']['mi_type'];
                if ($mi_type != AUTH_MASTER) {
                    $result = 'type101';
                    $data = '';
                    $message = '권한이외의 접근입니다.';
                }else {
                    $hn_code = $post['hn_code'];
                    $herb_m = model('Herb_m');
                    $mi_code = $sessinarr['user']['mi_code'];

                    if ($post['typ'] == 2) {

                        $NewCode = $this->Make_Code(2);

                        $param = [
                            'hd_code' => $NewCode,
                            'fk_hncode' => $hn_code,
                            'fk_micode' => $mi_code,
                            'mm_medicine' => $post['mm_medicine'],
                            'mm_title_kor' => $post['mm_title_kor'],
                            'mm_origin_kor' => $post['mm_origin_kor'],
                            'mm_origin' => $post['mm_origin']
                        ];
                        $fk_mmsn = $herb_m->Insert_Product_Match($param);
                        if ($fk_mmsn <= 0) {
                            $result = 'type103';
                            $message = '매칭 약재 등록에 실패 하였습니다.';
                        } else {
                            $param = [
                                'fk_mmsn' => $fk_mmsn
                            ];
                            $Cnt = $herb_m->Update_Product_info($hn_code, $param);
                            if ($Cnt > 0) {

                                $typ = 'HerbMatch';
                                $Log = '약재Matching|' . $hn_code . '|' . $post['mm_medicine'];
                                $this->Log_Reg($mi_code, $typ, $Log);

                                $result = 'ok';
                                $message = 'success';
                            } else {
                                $result = 'type104';
                                $message = '매칭 약재 정보 업데이트에 실패 하였습니다.';
                            }
                        }
                    } else {
                        $Rs = $herb_m->Load_Product_info($hn_code);
                        if (fn_ArrayCnt($Rs) <= 0) {
                            $result = 'type105';
                            $message = '매칭 약재 정보 로드에 실패 하였습니다.';
                        } else {
                            $fk_mmsn = $Rs[0]['fk_mmsn'];
                            $mm_medicine = $Rs[0]['mm_medicine'];
                            $param1 = ['fk_mmsn' => 0];
                            $Cnt = $herb_m->Update_Product_info($hn_code, $param1);
                            $param2 = ['isDel' => 1];
                            $Cnt = $herb_m->Update_Product_Match($fk_mmsn, $param2);
                            $typ = 'HerbUnMatch';
                            $Log = '약재UnMatching|' . $hn_code . '|' . $mm_medicine;
                            $this->Log_Reg($mi_code, $typ, $Log);
                            $result = 'ok';
                            $message = 'success';

                        }
                    }
                }
            }
        }
        $return = [
            'result' => $result,
            'message' => $message
        ];
        return $this->respond($return);
    }

    public function Load_OrginHerb()
    {
        $cfcode = ($this->request->getPost('cfcode') == '') ? '' : $this->request->getPost('cfcode');
        $medicode = ($this->request->getPost('medicode') == '') ? '' : $this->request->getPost('medicode');

        if (($medicode == '') || ($cfcode == '')) {
            $result = 'type101';
            $data = '';
            $message = '잘못된 접근입니다.';
        } else {
            $apiUrl = fn_ENV_URL() ."/manager/medicine/?apiCode=medicinelist&reData=admmedilist2&language=kor&ckCfcode={$cfcode}&mediherb={$medicode}";
            $retVal = fn_CURL($apiUrl, 'get');
            if (empty($retVal)) {
                $result = 'type102';
                $data = '';
                $message = '통신장애로 데이터로드에 실패하였습니다. 다시 시도 하여주세요.[Error101]';
            } else if($retVal['resultCode']=='200'){
                $result = 'ok';
                $data = $retVal['list'];
                $message = '';
            }else{
                $result = 'type103';
                $data = '';
                $message = '통신장애로 데이터로드에 실패하였습니다. 다시 시도 하여주세요.[Error102]';
            }
        }
        $return = [
            'result' => $result,
            'list' => $data,
            'message' => $message
        ];
        return $this->respond($return);
    }

