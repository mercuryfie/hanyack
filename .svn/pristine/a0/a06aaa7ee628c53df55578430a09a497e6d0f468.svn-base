    public function Load_Medicine()
    {
        $word = ($this->request->getPost('word') == '') ? '' : $this->request->getPost('word');
        $target = ($this->request->getPost('target') == '') ? '' : $this->request->getPost('target');

        if ($word == '') {
            $result = 'type101';
            $data = '';
            $message = '잘못된 접근입니다.\n다시 시도 하여주세요.(Error 101)';
        } else {
            //$tUrl = fn_ENV_URL();
            $tUrl = 'https://api.djmedi.net';
            if ($target == 1) {
                $apiUrl = $tUrl . "/manager/medicine/?apiCode=medicinelist&language=kor&ckCfcode=dj&reData=herbGanada2&searchGanada={$word}&searchMedi=&ckStaffid=&v=";
            } else {
                $apiUrl = $tUrl . "/manager/medicine/?apiCode=medicinelist&language=kor&ckCfcode=dj&ckStaffid=&v=&reData=admmedilist2&page=&searchTxt={$word}&searchType=&id=";
            }
            $retVal = fn_CURL($apiUrl, 'get');
            if (empty($retVal)) {
                $i_arr = [
                    'list' => ''
                ];
                $result = 'type102';
                $data = $i_arr;
                $message = '잘못된 접근입니다.<br>다시 시도 하여주세요.[Error 102]';
            } else if(empty($retVal['list'])) {
                $i_arr = [
                    'list' => ''
                ];
                $result = 'type102';
                $data = $i_arr;
                $message = '검색된 약재가 없습니다. ';
            }else{
                $i_arr = [
                    'list' => $retVal['list']
                ];
                $result = 'ok';
                $data = $i_arr;
                $message = 'success';
            }
        }
        $return = [
            'result' => $result,
            'info' => $data,
            'message' => $message
        ];

        return $this->respond($return);
    }


//editor data 전송
    public function Upload_file_editor()
    {
        $key = 'upload';
        $allow = 'jpg,jpeg,gif,png';
        $allowed_extensions = explode(',', $allow);
        $file = $this->request->getFile($key);

        if ($file) {
            if ($file->isValid() && !$file->hasMoved()) {
                $max_file_size = 5242880; // 5M
                $filename = $file->getName();
                $ext = substr($filename, strrpos($filename, '.') + 1);
                $size = $file->getSize();
                if (!in_array($ext, $allowed_extensions)) {
                    $uploaded = '0';
                    $message = ['message' => '업로드는 [' . $allow . '] 확장자만 가능합니다.'];
                } else if ($size >= $max_file_size) {
                    $uploaded = '0';
                    $message = ['message' => '업로드는 [' . fn_Str_File_Sise($max_file_size) . '] 까지만 가능합니다.'];
                } else {
                    $timeNow = date("Ymd");
                    $dir = "././assets/editor/$timeNow";
                    $dir2 = "/assets/editor/$timeNow";
                    $upload_dir = $dir . '/';
                    $upload_dir2 = $dir2 . '/';

                    if (is_dir($dir) != true) {
                        mkdir($dir, 0777, true);
                    }

                    helper('text');
                    $fileName = random_string('alnum', 16);
                    $path = $fileName . '.' . $ext;
                    if (move_uploaded_file($file->getTempName(), $upload_dir . $path)) {
                        $uploaded = 1;
                        $fname = $fileName;
                        $url = $upload_dir2 . $path;

                        $param = [
                            'product_id' => 1,  // 예시 product_id, 실제 값에 맞게 변경
                            'file_name' => $fname,
                            'file_url' => $url,
                            'isDell' => 0 // 파일이 삭제되지 않은 상태
                        ];

                    } else {
                        $uploaded = '0';
                        $message = ['message' => '파일 업로드 정보 업데이트에 실패 하였습니다.(Error102)'];
                    }
                }
            } else {
                $uploaded = '0';
                $message = ['message' => '파일이 선택되지 않았습니다. 다시 시도하여주세요.(Error103)'];
            }
        } else {
            $uploaded = '0';
            $message = ['message' => '파일이 선택되지 않았습니다. 다시 시도하여주세요.(Error104)'];
        }

        if ($uploaded == '1') {
            $return = [
                'uploaded' => '1',
                'fileName' => $fname,
                'url' => $url
            ];
        } else {
            $return = [
                'uploaded' => '0',
                'error' => $message
            ];
        }

        return $this->respond($return);

    }

// maining, attachimg, time folder 생성
    public function Upload_file()
    {
        $key = ($this->request->getPost('key') == '') ? '' : $this->request->getPost('key');
        if ($key == '') {
            $result = 'type101';
            $message = '잘못된 접근입니다.';
        } else {
            $allow = $request->getPost('allow');
            $fn_code = $request->getPost('hn_code');
            $typ = $request->getPost('typ');
            $method = $request->getPost('method');
            $allowed_extensions = explode(',', $allow);
            $file = $this->request->getFile($key);
            if ($file) {
                if ($file->isValid() && !$file->hasMoved()) {
                    $max_file_size = 5242880; // 5M
                    $filename = $file->getName();
                    $ext = substr($filename, strrpos($filename, '.') + 1);
                    $size = $file->getSize();
                    if (!in_array($ext, $allowed_extensions)) {
                        $result = 'type102';
                        $message = '업로드는 [' . $allow . '] 확장자만 가능합니다.';
                    } else if ($size >= $max_file_size) {
                        $result = 'type103';
                        $message = '업로드는 [' . fn_Str_File_Sise($max_file_size) . '] 까지만 가능합니다.';
                    } else {
                        if ($key == 'attachImg') {
                            $dir = "././assets/product/image";
                            $upload_dir = $dir . '/';
                        } else if ($key == 'attachFile') {
                            $dir = "././assets/product/data";
                            $upload_dir = $dir . '/';
                        } else {
                            $timeNow = date("Ymd");
                            $dir = "././assets/upload/$timeNow";
                            $upload_dir = $dir . '/';
                        }
                        if (is_dir($dir) != true) {
                            mkdir($dir, 0777, true);
                        }
                        helper('text');
                        $fileName = random_string('alnum', 16);
                        $path = $fileName . '.' . $ext;
                        if (move_uploaded_file($file->getTempName(), $upload_dir . $path)) {
                            $insert = [
                                'fk_fncode' => $fn_code,
                                'fname' => $path,
                                'typ' => $typ
                            ];
                            $herb_m = model('Herb_m');
                            $insertid = $herb_m->Insert_Attach_File($insert);
                            if ($insertid > 0) {
                                if($method=='edit') {
                                    $param = ['isDel' => 1];
                                    $DelCnt = $herb_m->Update_Product_File2($fn_code,$typ, $insertid, $param);
                                }
                                $result = 'ok';
                                $message = 'success';
                            } else {
                                $result = 'type106';
                                $message = '파일 업로드 정보 업데이트에 실패 하였습니다.(Error101)';
                            }
                        } else {
                            $result = 'type105';
                            $message = '파일 업로드 정보 업데이트에 실패 하였습니다.(Error102)';
                        }
                    }
                } else {
                    $result = 'type104';
                    $message = '파일이 선택되지 않았습니다. 다시 시도하여주세요.(Error103)';
                }
            } else {
                $result = 'type111';
                $message = '파일이 선택되지 않았습니다. 다시 시도하여주세요.(Error104)';
            }
        }
        $return = [
            'result' => $result,
            'info' => '',
            'message' => $message
        ];
        return $this->respond($return);
    }


    public function Update_Product_Edited()
    {
        $sessinarr = $this->GetSessionData();

        // 1. 로그인 체크
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            if ($mi_type != AUTH_PHARM) {
                $result = 'type101';
                $message = '권한이외의 접근입니다.';
            } else {
                foreach ($this->request->getPost() as $key => $value) {
                    $post[$key] = $value;
                }
                if (empty($post)) {
                    $result = 'type102';
                    $message = '잘못된 접근입니다.';
                } else {
                    $hncode = $post['hncode'];
                    $wcode = $post['wcode'];
                    $hnmemo = $post['hnmemo'];
                    $hntype = $post['hntype'];
                    $hnmemo = $post['hnmemo'];
                    $hntype = $post['hntype'];
                    $hnmemo = $post['hnmemo'];

                    $herb_m = model('Herb_m');
                    $Rs = $herb_m->Load_Product_Code($hncode);
                    if (fn_ArrayCnt($Rs) <= 0) {
                        $result = 'type102';
                        $message = '입력하신 약재는 존재하지 않습니다.';
                    } else {
                        $param = [
                            'hn_isok' => 1
                        ];
                        $Cnt = $herb_m->Update_Product_Info($hncode, $param);
                        if ($Cnt <= 0) {
                            $result = 'type103';
                            $message = '반려처리에 실패 하였습니다.';
                        } else {
                            $data = [
                                'fk_hncode' => $hncode,
                                'hn_type' => $hntype,
                                'hn_memo' => $hnmemo
                            ];
                            $insertid = $herb_m->Insert_Reject_Data($data);
                            if ($insertid <= 0) {
                                $result = 'type104';
                                $message = '반려 사유 등록에 실패 하였습니다';
                            } else {
                                $result = 'ok';
                                $message = 'success';
                            }
                        }
                    }
                }
            }
        }

        $return = [
            'result' => $result,
            'message' => $message
        ];
        return $this->respond($return);
    }


    public function del_Reply()
    {
        foreach ($this->request->getPost() as $key => $value) {
            $post[$key] = $value;
        }
        if (empty($post)) {
            $json = $request->getJSON(true);
            if ($json) {
                $post = $json;
            } else {
                $result = 'type101';
                $message = '필수 입력값을 확인하여주세요.';

            }
        } else {
            $sessinarr = $this->GetSessionData();
            if (!$sessinarr['islogin']) {
                $result = 'NoLogin';
                $message = '로그인을 하셔야 합니다.';
            } else {
                $bcode = $post['bcode'];
                $board_m = model('Board_m');
                $mi_type = $sessinarr['user']['mi_type'];
                if ($mi_type == 'master') {

                    $reply = $board_m->Del_Reply($bcode);
                    if ($reply <= 0) {
                        $result = 'type103';
                        $message = 'nothing is replied';
                    } else {
                        $result = 'ok';
                        $message = 'success';
                    }
                }
            }
        }
        $return = [
            'result' => $result,
            'message' => $message
        ];
        return $this->respond($return);
    }

    public function Del_bContent_Data()
    {

        $request = service('request') ;
        $post = [];
        foreach ($request->getPost() as $key => $value) {
            $post[$key] = $value;
        }

        if(empty($post)){
            $result = 'type101';
            $message = '필수 입력값을 확인하여주세요.';
        } else {
            $sessinarr = $this->GetSessionData();
            $uid = $sessionarr['user']['uid'];
            $b_uid = ($request->getPost('b_uid') == '') ? '' : $request->getPost('b_uid');
            if ($uid != $b_uid) {
                $result = 'type102';
                $message = '계정 권한을 확인하여주세요.';

            } else {

                $bcode = ($request->getPost('bcode') == '') ? '' : $request->getPost('bcode');
                $board_m = model('Board_m');
                $Cnt = $board_m->Delete_bContent($bcode);
                if($Cnt <= 0){
                    $result = 'type102';
                    $message  = 'nothing is updated';
                }else{
                    $result = 'ok';
                    $message  = 'success';
                }

            }

            $return = [
                'result' => $result,
                'msg' => $message
            ];
            return $this->respond($return);

        }
    }

    //editor data 전송
    public function Upload_Board_AttachedImg()
    {
        $key = 'imgs';
        $allow = 'jpg,jpeg,gif,png';
        $allowed_extensions = explode(',', $allow);
        $file = $this->request->getFile($key);

        if ($file <=0) {
            if ($file->isValid() && !$file->hasMoved()) {
                $max_file_size = 5242880; // 5M
                $filename = $file->getName();
                $ext = substr($filename, strrpos($filename, '.') + 1);
                $size = $file->getSize();
                if (!in_array($ext, $allowed_extensions)) {
                    $uploaded = '0';
                    $message = ['message' => '업로드는 [' . $allow . '] 확장자만 가능합니다.'];
                } else if ($size >= $max_file_size) {
                    $uploaded = '0';
                    $message = ['message' => ' [' . fn_Str_File_Sise($max_file_size) . '] MB 를 초과합니다.'];
                } else {
                    $timeNow = date("Ymd");
                    $dir = "././assets/board/$timeNow";
                    $dir2 = "/assets/board/$timeNow";
                    $upload_dir = $dir . '/';
                    $upload_dir2 = $dir2 . '/';

                    if (is_dir($dir) != true) {
                        mkdir($dir, 0777, true);
                    }

                    helper('text');
                    $fileName = random_string('alnum', 16);
                    $path = $fileName . '.' . $ext;
                    if (move_uploaded_file($file->getTempName(), $upload_dir . $path)) {
                        $uploaded = 1;
                        $fname = $fileName;
                        $url = $upload_dir2 . $path;

                        $param = [
                            'product_id' => 1,  // 예시 product_id, 실제 값에 맞게 변경
                            'file_name' => $fname,
                            'file_url' => $url,
                            'isDell' => 0 // 파일이 삭제되지 않은 상태
                        ];

                    } else {
                        $uploaded = '0';
                        $message = ['message' => '파일 업로드 정보 업데이트에 실패 하였습니다.(Error102)'];
                    }
                }
            } else {
                $uploaded = '0';
                $message = ['message' => '파일이 선택되지 않았습니다. 다시 시도하여주세요.(Error103)'];
            }
        } else {
            $uploaded = '0';
            $message = ['message' => '파일이 선택되지 않았습니다. 다시 시도하여주세요.(Error104)'];
        }

        if ($uploaded == '1') {
            $return = [
                'uploaded' => '1',
                'fileName' => $fname,
                'url' => $url
            ];
        } else {
            $return = [
                'uploaded' => '0',
                'error' => $message
            ];
        }

        return $this->respond($return);

    }

// maining, attachimg, time folder 생성
    public function Upload_Board_Attachment()
    {
        $key = ($this->request->getPost('key') == '') ? '' : $this->request->getPost('key');
        if ($key == '') {
            $result = 'type101';
            $message = '잘못된 접근입니다.';
        } else {
            $allow = $this->request->getPost('allow');
            $bcode = $this->request->getPost('bcode');
            $typ = $this->request->getPost('typ');
            $allowed_extensions = explode(',', $allow);
            $file = $this->request->getFile($key);
            if ($file) {
                if ($file->isValid() && !$file->hasMoved()) {
                    $max_file_size = 5242880; // 5M
                    $filename = $file->getName();
                    $ext = substr($filename, strrpos($filename, '.') + 1);
                    $size = $file->getSize();
                    if (!in_array($ext, $allowed_extensions)) {
                        $result = 'type102';
                        $message = '업로드는 [' . $allow . '] 확장자만 가능합니다.';
                    } else if ($size >= $max_file_size) {
                        $result = 'type103';
                        $message = '업로드는 [' . fn_Str_File_Sise($max_file_size) . '] 까지만 가능합니다.';
                    } else {
                        $timeNow = date("Ymd");
                        if ($key == 'attachedImg') {
                            $dir = "././assets/board/img/$timeNow";
                            $path2 = "/assets/board/img/$timeNow";
                            $upload_dir = $dir . '/';
                        } else if ($key == 'files') {
                            $path2 = "/assets/board/file/$timeNow";
                            $dir = "././assets/board/file/$timeNow";
                            $upload_dir = $dir . '/';
                        } else {
                            $dir = "././assets/board/$timeNow";
                            $upload_dir = $dir . '/';
                        }
                        if (is_dir($dir) != true) {
                            mkdir($dir, 0777, true);
                        }
                        helper('text');
                        $fileName = random_string('alnum', 16);
                        $path = $fileName . '.' . $ext;
                        if (move_uploaded_file($file->getTempName(), $upload_dir . $path)) {
                            $insert = [
                                'fk_bcode' => $bcode,
                                'fname' => $path,
                                'path' => $path2,
                                'f_type' => $typ
                            ];

                            $board_m = model('Board_m');
                            $Cnt = $board_m->Insert_Board_AttachedImg($insert);
                            if($Cnt <= 0){
                                $result = 'type202';
                                $message  = 'DBError';
                            }else{
                                $result = 'ok';
                                $message  = 'success';
                            }

                        } else {
                            $result = 'type105';
                            $message = '파일 업로드 정보 업데이트에 실패 하였습니다.(Error102)';
                        }
                    }
                } else {
                    $result = 'type104';
                    $message = '파일이 선택되지 않았습니다. 다시 시도하여주세요.(Error103)';
                }
            } else {
                $result = 'type111';
                $message = '파일이 선택되지 않았습니다. 다시 시도하여주세요.(Error104)';
            }
        }
        $return = [
            'result' => $result,
            'msg' => $message
        ];
        return $this->respond($return);
    }

