<?php

namespace App\Controllers;


use App\Libraries\Local_Utils;
use App\Libraries\Utils;
use CodeIgniter\API\ResponseTrait;


class ApiController extends BaseController
{
    use ResponseTrait;

    public function __construct()
    {
        $Auth = [AUTH_MASTER,AUTH_PHARM,AUTH_DECOC];
        $this->Check_Auth($Auth);
    }


    public function Load_Claim_Info(){
        $page = ($this->request->getPost('page') == '') ? '' : $this->request->getPost('page');
        $search = ($this->request->getPost('search') == '') ? [] : $this->request->getPost('search');

        $sessinarr = $this->GetSessionData();
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $data = '';
            $message = '로그인을 하셔야 합니다.';
        }else {
            $mi_type = $sessinarr['user']['mi_type'];
            $mi_code = $sessinarr['user']['mi_code'];
            $order_m = model('Order_m');
            $oRs = $order_m->Load_Order_Return($mi_type,$mi_code);
            if(fn_ArrayCnt($oRs)<=0){
                $result = 'ok';
                $data = '';
                $message = '';
            }else{
                $o_arr = [];
                foreach ($oRs as $d){
                    $t_arr = [];

                    $t_arr['rtyp'] = $d['rtyp'];
                    $t_arr['gd_code'] = $d['gd_code'];
                    $t_arr['fk_odcode'] = $d['fk_odcode'];
                    $t_arr['mi_name'] = $d['mi_name'];
                    $t_arr['hn_name'] = $d['hn_name'];
                    $t_arr['option_str'] = $this->Product_Option_str($d['t1_value'],$d['t2_value']);
                    $t_arr['gd_pType'] = $d['gd_pType'];
                    $t_arr['gd_rPrice'] = $d['gd_rPrice'];
                    $t_arr['gd_price'] = $d['gd_price'];
                    $t_arr['gd_cnt'] = $d['gd_cnt'];
                    $t_arr['od_wname'] = $d['od_wname'];
                    $t_arr['od_regdate'] = fn_Short_Date($d['od_regdate']);

                    array_push($o_arr,$t_arr);
                }
                $result = 'ok';
                $data = ['list' => $o_arr];
                $message = '';
            }
        }

        $return = [
            'result' => $result,
            'info' => $data,
            'message' => $message
        ];
        return $this->respond($return);
    }



    public function Return_Do(){
        $sn = ($this->request->getPost('sn') == '') ? '' : $this->request->getPost('sn');
        $memo = ($this->request->getPost('msg') == '') ? '' : $this->request->getPost('msg');
        $process = ($this->request->getPost('process') == '') ? '' : $this->request->getPost('process');
        $rCnt = ($this->request->getPost('cnt') == '') ? '' : $this->request->getPost('cnt');
        if(($sn=='') || ($process=='')){
            $result = 'error';
            $data = '';
            $message = '잘못된 접근입니다.';
        }else {
            $sessinarr = $this->GetSessionData();
            if (!$sessinarr['islogin']) {
                $result = 'NoLogin';
                $data = '';
                $message = '로그인을 하셔야 합니다.';
            }else {
                $micode = $sessinarr['user']['mi_code'];
                $cfcode = $sessinarr['user']['mi_cf'];

                $order_m = model('Order_m');
                $Rs = $order_m->Load_Order_Goods($sn);
                if (fn_ArrayCnt($Rs) <= 0) {
                    $result = 'error';
                    $data = '';
                    $message = '존재하지 않는 주문입니다.';
                } else {
                    $wicode = $Rs[0]['fk_micode'];
                    $maxCnt = $Rs[0]['gd_cnt'];
                    if($process==5){
                        $mestr = '약재 취소';
                        $Tcnt = 0;
                    }else if($process==6){
                        if($maxCnt <= $rCnt){
                            $mestr = '약재 전체 반품';
                            $Tcnt = $Rs[0]['gd_cnt'];
                        }else if($maxCnt > $rCnt){
                            $mestr = '약재 부분 반품';
                            $Tcnt = $rCnt;
                        }
                    }else if($process==8){
                        if($maxCnt <= $rCnt){
                            $mestr = '약재 전체 교환';
                            $Tcnt = $Rs[0]['gd_cnt'];
                        }else if($maxCnt > $rCnt){
                            $mestr = '약재 부분 교환';
                            $Tcnt = $rCnt;
                        }
                    }
                    $param1 = [
                        'wh_code' => $Rs[0]['fk_hncode'],
                        'wh_stock' => $Rs[0]['mm_medicine'],
                        'wh_cnt' => $Tcnt,
                        'wh_memo' => $mestr
                    ];

                    $body = [
                        'apiCode' => 'medicinereturn',
                        'language' => 'kor',
                        'cfcode' => $cfcode,
                        'data' => $param1
                    ];
                    $apiUrl = fn_ENV_URL() . "/djherb/";
                    $retVal = fn_CURL($apiUrl, 'POST', [], $body);
                    if (empty($retVal)) {
                        $result = 'type102';
                        $data = '';
                        $message = '통신장애로 데이터로드에 실패하였습니다.<br>다시 시도 하여주세요.[Error101]';
                    } else if ($retVal['resultCode'] == '200') {
                        $param2 = [
                            'micode' => $micode,
                            'wicodde' => $wicode,
                            'process' => $process,
                            'nowCnt' => $rCnt,
                            'msg' => $memo,
                            'sn' => $sn
                        ];
                        $bool = $this->CancelorReturn($param2);
                        if ($bool == true) {
                            $result = 'ok';
                            $data = '';
                            $message = 'success';
                        } else {
                            $result = 'error';
                            $data = '';
                            $message = '반품처리에 실패 하였습니다.';
                        }
                    }else{
                        $result = 'error';
                        $data = '';
                        $message = $retVal['resultMessage'];
                    }
                }
            }
        }
        $return = [
            'result' => $result,
            'info' => $data,
            'message' => $message
        ];
        return $this->respond($return);
    }

    public function Like_Do(){
        $hncode = ($this->request->getPost('code') == '') ? '' : $this->request->getPost('code');
        $ptype = ($this->request->getPost('ptype') == '') ? '' : $this->request->getPost('ptype');
        $act = ($this->request->getPost('act') == '') ? 1 : $this->request->getPost('act');
        if(($hncode=='') || ($ptype=='')){
            $result = 'AUTH_FAIL';
            $data = '';
            $message = '접근 권한이 없습니다.';
        }else {
            $sessinarr = $this->GetSessionData();
            if (!$sessinarr['islogin']) {
                $result = 'NoLogin';
                $data = '';
                $message = '로그인을 하셔야 합니다.';
            }else {
                $mi_type = $sessinarr['user']['mi_type'];
                if (($mi_type != AUTH_MASTER) && ($mi_type != AUTH_DECOC)) {
                    $result = 'AUTH_FAIL';
                    $data = '';
                    $message = '접근 권한이 없습니다.';
                } else {
                    $mi_code = $sessinarr['user']['mi_code'];
                    $param = [
                        'fk_hncode' => $hncode,
                        'mi_code' => $mi_code,
                        'ptype' => $ptype
                    ];
                    $herb_m = model('Herb_m');
                    if($act==1) {
                        $Cnt = $herb_m->Insert_Product_Like($param);
                    }else{
                        $Cnt = $herb_m->Delete_Product_Like($param);
                    }
                    $result = 'ok';
                    $data = '';
                    $message = 'success';
                }
            }
        }
        $return = [
            'result' => $result,
            'info' => $data,
            'message' => $message
        ];
        return $this->respond($return);
    }

    public function Incoming_Do(){
        $sn = ($this->request->getPost('sn') == '') ? 1 : $this->request->getPost('sn');
        $sessinarr = $this->GetSessionData();
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $data = '';
            $message = '로그인을 하셔야 합니다.';
        }else {
            $mi_type = $sessinarr['user']['mi_type'];
            if (($mi_type != AUTH_MASTER) && ($mi_type != AUTH_DECOC)) {
                $result = 'AUTH_FAIL';
                $data = '';
                $message = '접근 권한이 없습니다.';
            } else {
                $order_m = model('Order_m');
                $Rs = $order_m->Load_Order_Goods($sn);
                if (fn_ArrayCnt($Rs) <= 0) {
                    $result = 'error';
                    $data = '';
                    $message = '존재하지 않는 주문입니다.';
                } else {
                    $wh_mmmaker = $Rs[0]['memaker'];
                    $wh_origin = $Rs[0]['n_value'];
                    $wh_mmorigin = $Rs[0]['n_key'];
                    $wh_maker = '디제이허브';


                    $param = [
                        'wh_code' => $Rs[0]['fk_hncode'],
                        'wh_prcode' => $Rs[0]['hn_number'],
                        'wh_stock' => $Rs[0]['mm_medicine'],
                        'wh_nhisherb' => $Rs[0]['fk_medicode'],
                        'wh_nhiscode' => '',
                        'wh_qty' => $Rs[0]['gd_cnt'],
                        'wh_price' => $Rs[0]['gd_price'],
                        'wh_expired' => fn_Short_Date($Rs[0]['hn_sellEDate']),
                        'wh_staff' => '',
                        'wh_origin' => $wh_origin,
                        'wh_maker' => $wh_maker,
                        'wh_memo' => '',
                        'wh_mmorigin' => $wh_mmorigin,
                        'wh_mmmaker' => $wh_mmmaker,
                        'wh_notice' => '',
                        'wh_date' => date('Y-m-d')
                    ];

                    $cfcode = $sessinarr['user']['mi_cf'];
                    $body = [
                        'apiCode' => 'medicineinstock',
                        'language' => 'kor',
                        'cfcode' => $cfcode,
                        'data' => $param
                    ];

                    $apiUrl = fn_ENV_URL() . "/djherb/";
                    $retVal = fn_CURL($apiUrl, 'POST', [], $body);
                    if (empty($retVal)) {
                        $result = 'type102';
                        $data = '';
                        $message = '통신장애로 데이터로드에 실패하였습니다.<br>다시 시도 하여주세요.[Error101]';
                    } else if ($retVal['resultCode'] == '200') {

                        $herb_m = model('Herb_m');
                        $rCnt = $herb_m->Update_Order_Step3($sn, ORDER_DELIVERED);
                        $remain = $retVal['data']['wh_remain'];
                        $i_arr = [
                            'remain' => $remain
                        ];

                        $result = 'ok';
                        $data = $i_arr;
                        $message = '';
                    } else {
                        $result = 'type103';
                        $data = '';
                        $message = '통신장애로 데이터로드에 실패하였습니다. <br>다시 시도 하여주세요.[Error102]';
                    }
                }

            }
        }
        $return = [
            'result' => $result,
            'info' => $data,
            'message' => $message
        ];
        return $this->respond($return);
    }


    public function Load_DecocTotalStock(){
        $page = ($this->request->getPost('page') == '') ? 1 : $this->request->getPost('page');
        $stype = ($this->request->getPost('stype') == '') ? 0 : $this->request->getPost('stype');
        $hnname = ($this->request->getPost('skey') == '') ? '' : $this->request->getPost('skey');
        $snation = ($this->request->getPost('snation') == '') ? 0 : $this->request->getPost('snation');

        $sessinarr = $this->GetSessionData();
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $data = '';
            $message = '로그인을 하셔야 합니다.';
        }else {
            $mi_type = $sessinarr['user']['mi_type'];
            if (($mi_type != AUTH_MASTER) && ($mi_type != AUTH_DECOC)) {
                $result = 'AUTH_FAIL';
                $data = '';
                $message = '접근 권한이 없습니다.';
            } else {
                $limit = 100;
                $offset = ($page == 1) ? 0 : $offset = $limit * ($page - 1);

                $search = [
                    'searchTxt' => $hnname,
                    'searchType' => $stype,
                    'searchType1' => $snation
                ];
                $cfcode = $sessinarr['user']['mi_cf'];
                $body = [
                    'apiCode' => 'medicinelist',
                    'language' => 'kor',
                    'cfcode' => $cfcode,
                    'pgnum' => $offset,
                    'pgsize' => $limit,
                    'data' => $search
                ];
                $apiUrl = fn_ENV_URL() . "/djherb/";
                $retVal = fn_CURL($apiUrl, 'POST', [], $body);
                if (empty($retVal)) {
                    $result = 'type102';
                    $data = '';
                    $message = '통신장애로 데이터로드에 실패하였습니다.<br>다시 시도 하여주세요.[Error101]';
                } else if ($retVal['resultCode'] == '200') {
                    if (fn_ArrayCnt($retVal['data']['list']) <= 0) {
                        $d_arr = [];
                    } else {
                        $d_arr = [];
                        foreach ($retVal['data']['list'] as $d) {
                            $mmCapa = $d['mmCapa'];
                            $mmStable = $d['mmStable'];
                            $stock = ($mmCapa > $mmStable) ? 1 : 0;

                            $t_arr = [
                                'mmCnt' => $d['mmCnt'],
                                'mmMedicine' => $d['mmMedicine'],
                                'mdCode' => $d['mdCode'],
                                'mdMedi' => $d['mdMedi'],
                                'mmTitle' => $d['mmTitle'],
                                'mmCapa' => $d['mmCapa'],
                                'mmStable' => $d['mmStable'],
                                'stock' => $stock,
                                'mmdelCnt' => 0
                            ];
                            array_push($d_arr, $t_arr);
                        }
                    }

                    $i_arr = [
                        'list' => $d_arr,
                        'page' => ($page + 1)
                    ];

                    $result = 'ok';
                    $data = $i_arr;
                    $message = '';
                } else {
                    $result = 'type102';
                    $data = '';
                    $message = '통신장애로 데이터로드에 실패하였습니다. <br>다시 시도 하여주세요.[Error102]';
                }
            }
        }

        $return = [
            'result' => $result,
            'info' => $data,
            'message' => $message
        ];
        return $this->respond($return);

    }



    public function Load_OrderList(){
        $page = ($this->request->getPost('page') == '') ? 1 : $this->request->getPost('page');
        $decoc = ($this->request->getPost('decoc') == '') ? '' : $this->request->getPost('decoc');
        $pharm = ($this->request->getPost('pharm') == '') ? '' : $this->request->getPost('pharm');

        $sessinarr = $this->GetSessionData();
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $data = '';
            $message = '로그인을 하셔야 합니다.';
        }else {
            $mi_type = $sessinarr['user']['mi_type'];
            if ($mi_type != AUTH_MASTER) {
                $result = 'AUTH_FAIL';
                $data = '';
                $message = '접근 권한이 없습니다.';
            } else {
                $limit = 15;
                $offset = $limit * ($page - 1);

                $order_m = model("Order_m");
                $param = [
                    'decoc' => $decoc,
                    'pharm' => $pharm,
                    'limit' => $limit,
                    'offset' => $offset
                ];
                $Rs = $order_m->Load_Order_Master($param);
                if (fn_ArrayCnt($Rs) > 0) {
                    $info = [];
                    foreach ($Rs as $d) {

                        if(fn_IsEmpty($d['gd_delicomplete'])){
                            $deli_period = 1;
                        }else{
                            $deli_period = fn_toDaysDiffUp($d['gd_delicomplete'],7);
                        }

                        $temparr = [
                            'sn' => $d['sn'],
                            'gd_code' => $d['gd_code'],
                            'od_regdate' => fn_Short_Date($d['od_regdate']),
                            'mi_name' => $d['mi_name'],
                            'od_wname' => $d['od_wname'],
                            'fk_hncode' => $d['fk_hncode'],
                            'hn_name' => $d['hn_name'],
                            'hn_option' => $this->Product_Option_str($d['t1_value'], $d['t2_value']),
                            'gd_ptype' => $d['gd_pType'],
                            'gd_cnt' => $d['gd_cnt'],
                            'gd_rPrice' => $d['gd_rPrice'],
                            'gd_price' => $d['gd_price'],
                            'gd_status' => $d['gd_status'],
                            'deli_period' => $deli_period

                        ];

                        array_push($info, $temparr);
                    }

                    $result = 'ok';
                    $data = $info;
                    $message = 'success';
                } else {
                    $result = 'ok';
                    $data = '';
                    $message = 'NotFound';
                }
            }
        }

        $i_arr = [
           'list' => $data,
            'page' => ($page+1)
        ];

        $return = [
            'result' => $result,
            'info' => $i_arr,
            'message' => $message
        ];
        return $this->respond($return);

    }


    public function Update_Product_isSale(){
        $sn = ($this->request->getPost('sn') == '') ? '' : $this->request->getPost('sn');
        $issale = ($this->request->getPost('issale') == '') ? '' : $this->request->getPost('issale');
        if (($sn == '') || ($issale == '')) {
            $result = 'type101';
            $data = '';
            $message = '삭제하실 약재 정보를 확인하여주세요.';
        } else {
            $sessinarr = $this->GetSessionData();
            if (!$sessinarr['islogin']) {
                $result = 'NoLogin';
                $data = '';
                $message = '로그인을 하셔야 합니다.';
            }else {
                $mi_type = $sessinarr['user']['mi_type'];
                if ($mi_type == AUTH_DECOC) {
                    $result = 'AUTH_FAIL';
                    $data = '';
                    $message = '접근 권한이 없습니다.';
                } else {
                    $herb_m = model('Herb_m');
                    $Rs = $herb_m->Load_Product_Sn($sn);
                    if (fn_ArrayCnt($Rs) <= 0) {
                        $result = 'type103';
                        $data = '';
                        $message = '존재하지 않는 약재입니다.';
                    } else {
                        $isval = ($issale == 100) ? 0 : 100;

                        $param = ['hn_isok' => $isval];
                        $Cnt = $herb_m->Update_Product_Info_Sn($sn, $param);
                        if ($Cnt <= 0) {
                            $result = 'type104';
                            $data = '';
                            $message = '약재정보 수정에 실패하였습니다.';
                        } else {
                            $i_arr = ['chk' => $isval];
                            $result = 'ok';
                            $data = $i_arr;
                            $message = '';
                        }
                    }
                }
            }
        }
        $return = [
            'result' => $result,
            'info' => $data,
            'message' => $message
        ];
        return $this->respond($return);
    }


    public function Cancel_Order(){
        $sn = ($this->request->getPost('sn') == '') ? '' : $this->request->getPost('sn');
        if ($sn == '') {
            $result = 'type101';
            $data = '';
            $message = '취소하실 주문 정보를 확인하여주세요.';
        } else {
            $order_m = model('Order_m');
            $Rs = $order_m->Load_Order_Goods($sn);
            if (fn_ArrayCnt($Rs) <= 0) {
                $result = 'error';
                $data = '';
                $message = '존재하지 않는 주문입니다.';
            } else {
                $d = $Rs[0];
                $micode = $d['od_wcode'];
                $wicode = $d['fk_micode'];
                $nowCnt = $d['gd_cnt'];
                $msg = '탕전실 주문취소';

                $param = [
                    'micode' => $micode,
                    'wicodde' => $wicode,
                    'process' => ORDER_CANCEL,
                    'nowCnt' => $nowCnt,
                    'msg' => $msg,
                    'sn' => $sn
                ];

                $bool = $this->CancelorReturn($param);
                if ($bool == true) {
                    $result = 'ok';
                    $data = '';
                    $message = 'success';
                } else {
                    $i_arr = [
                        'sn' => $sn
                    ];
                    $result = 'error';
                    $data = $i_arr;
                    $message = "취소처리에 실패 하였습니다.<br>다시 시도 하여주세요.";
                }
            }
        }

        $return = [
            'result' => $result,
            'info' => $data,
            'message' => $message
        ];
        return $this->respond($return);
    }


    public function Del_Cart(){
        $sn = ($this->request->getPost('sn') == '') ? '' : $this->request->getPost('sn');
        if ($sn == '') {
            $result = 'type101';
            $eCnt = 0;
            $message = '삭제하실 약재 정보를 확인하여주세요.';
        } else {
            $herb_m = model('Herb_m');
            $Cnt = $herb_m->Delete_Cart($sn);
            if($Cnt<=0){
                $result = 'type102';
                $eCnt = 0;
                $message = "존재하지 않는 장바구니 정보 입니다.\n 다시 시도하여 주세요.";
            }else{
                $result = 'ok';
                $eCnt = $Cnt;
                $message = "success";
            }
        }

        $i_arr = [
            'tCnt' => $eCnt
        ];

        $return = [
            'result' => $result,
            'info' => $i_arr,
            'message' => $message
        ];
        return $this->respond($return);

    }


    public function Load_Cart_Info(){
        $page = ($this->request->getPost('page') == '') ? '' : $this->request->getPost('page');
        if ($page == '') {
            $result = 'type101';
            $info = '';
            $message = '선택하신 약재 정보를 확인하여주세요.';
        } else {
            $sessinarr = $this->GetSessionData();
            if (!$sessinarr['islogin']) {
                $result = 'NoLogin';
                $info = '';
                $message = '로그인을 하셔야 합니다.';
            } else {
                $mi_code = $sessinarr['user']['mi_code'];
                $mi_type = $sessinarr['user']['mi_type'];
                if($mi_type==AUTH_PHARM) {
                    $result = 'AUTH_FAIL';
                    $info = '';
                    $message = '접근 권한이 없습니다.';
                }else {
                    $herb_m = model('Herb_m');
                    $dRs = $herb_m->distinct_Cart($mi_code);
                    if (fn_ArrayCnt($dRs) <= 0) {
                        $result = 'ok';
                        $info = '';
                        $message = '장바구니가 비어 있습니다.';
                    } else {
                        $data = [];
                        $tCnt = 0;
                        foreach ($dRs as $d) {
                            $m_arr = [];
                            $sRs = $herb_m->Load_Cart_Pharm($mi_code, $d['maker']);
                            if (fn_ArrayCnt($sRs) > 0) {
                                foreach ($sRs as $s) {
//                                    $p_arr = $this->LoadPrice($s['fk_hncode']);
//                                    $position = $s['ct_pType'] - 1;
//                                    if (fn_ArrayCnt($p_arr) > 0) {
//                                        $c_gPrice = $p_arr[$position]['hn_gPrice'];
//                                        $c_pPrice = $p_arr[$position]['hn_pPrice'];
//                                        $c_period = $p_arr[$position]['hn_period'];
//                                    } else {
//                                        $c_gPrice = 0;
//                                        $c_pPrice = 0;
//                                        $c_period = 0;
//                                    }

                                    $t_arr = [
                                        'sn' => $s['sn'],
                                        'hnname' => $s['hn_name'],
                                        'micode' => $s['fk_micode'],
                                        'macode' => $s['fk_macode'],
                                        'maname' => $s['ma_name'],
                                        'hncode' => $s['fk_hncode'],
                                        'ptype' => $s['ct_pType'],
                                        't_cnt' => $s['ct_cnt'],
                                        'hn_boxCnt' => $s['hn_boxCnt'],
                                        't_gPrice' => $s['ct_gPrice'],
                                        't_tPrice' => $s['ct_tPrice'],
                                        'period' => $s['ct_pType'],
                                        'regdate' => fn_Short_Date($s['ct_period']),
                                        'w_name' => $s['w_name'],
                                        'w_value' => $s['w_value'],
                                        'n_key' => $s['n_key'],
                                        'n_value' => $s['n_value'],
                                        't1_value' => $s['t1_value'],
                                        't2_value' => $s['t2_value'],
                                        'thumnail' => $s['thumnail'],
                                        'LowCnt' => $this->LowPrice($s['fk_medicode'], $s['ct_gPrice'], $s['ct_pType'])
                                    ];
                                    $m_arr[] = $t_arr;
                                    $maname = $s['ma_name'];
                                    $macode = $s['fk_macode'];
                                }

                                $nCnt = fn_ArrayCnt($m_arr);
                                $t_arr2 = [
                                    'maname' => $maname,
                                    'macode' => $macode,
                                    'Cnt' => $nCnt,
                                    'list' => $m_arr
                                ];

                                $tCnt += $nCnt;
                                $data[] = $t_arr2;
                            }
                        }

                        $i_arr = [
                            'list' => $data,
                            'tCnt' => $tCnt
                        ];

                        $result = 'ok';
                        $info = $i_arr;
                        $message = '';
                    }
                }
            }
        }

        $return = [
            'result' => $result,
            'info' => $info,
            'message' => $message
        ];
        return $this->respond($return);

    }

    public function Order_Step_Do(){
        $o_data = (fn_IsEmpty($this->request->getPost('data'))) ? [] : $this->request->getPost('data');
        $o_step = ($this->request->getPost('ostep') == '') ? '' : $this->request->getPost('ostep');
        $n_step = ($this->request->getPost('nstep') == '') ? '' : $this->request->getPost('nstep');

        if(($o_data=='') || ($o_step=='')|| ($n_step=='')){
            $result = 'type101';
            $info = '';
            $message = '선택하신 약재 정보를 확인하여주세요.';
        }else {
            $sessinarr = $this->GetSessionData();
            if (!$sessinarr['islogin']) {
                $result = 'NoLogin';
                $info = '';
                $message = '로그인을 하셔야 합니다.';
            } else {
                $mi_code = $sessinarr['user']['mi_code'];
                $mi_type = $sessinarr['user']['mi_type'];
                if($mi_type==AUTH_DECOC) {
                    $result = 'AUTH_FAIL';
                    $info = '';
                    $message = '접근 권한이 없습니다.';
                }else {

                    $data = json_decode($o_data, true);
                    $sn = $data[0]['sn'];
                    $status = $data[0]['status'];
                    $delidate = $data[0]['delidate'];

                    $herb_m = model('Herb_m');
                    $Cnt = $herb_m->Cnt_Order_Step_Check($sn, $o_step, $mi_code);
                    if ($Cnt > 0) {
                        $result = 'type103';
                        $info = '';
                        $message = "주문상태가 잘못되었습니다.\n 입력하신 주문 확인하여주세요.";
                    } else {
                        $order_m = model('Order_m');
                        if ($n_step == ORDER_PROCESSING) {
                            $Rs = $order_m->Load_Order_Goods($sn);
                            if (fn_ArrayCnt($Rs) <= 0) {
                                $result = 'type113';
                                $message = '배송 항목 정보 확인에 실패하였습니다.';
                            } else {
                                $u_Cnt = 0;
                                $u_weight = 0;

                                $t_cnt = $Rs[0]['gd_cnt'];
                                $weight = $Rs[0]['w_value'];
                                $od_code = $Rs[0]['fk_odcode'];
                                $gd_code = $Rs[0]['gd_code'];
                                $od_wcode = $Rs[0]['od_wcode'];
                                $od_wname = $Rs[0]['od_wname'];

                                $tarr = [
                                    'mi_code' => $mi_code,
                                    'w_code' => $od_wcode,
                                    'p_type' => 0
                                ];

                                $Rs2 = $order_m->Load_Package_Goods_Active($tarr);
                                if (fn_ArrayCnt($Rs2) <= 0) {
                                    $fk_pcode = $this->Make_Code(6);
                                    $marr = [
                                        'pcode' => $fk_pcode,
                                        'mi_code' => $mi_code,
                                        'w_code' => $od_wcode,
                                        'w_name' => $od_wname
                                    ];
                                    $Cnt = $order_m->Insert_Package($marr);
                                } else {
                                    $fk_pcode = $Rs2[0]['pcode'];
                                }

                                $sarr = [
                                    'pa_code' => $this->Make_Code(5),
                                    'fk_pcode' => $fk_pcode,
                                    'fk_odcode' => $od_code,
                                    'fk_gdcode' => $gd_code,
                                    't_cnt' => $t_cnt,
                                    't_weight' => ($t_cnt * $weight)
                                ];
                                $Cnt = $order_m->Insert_Package_Goods($sarr);

                                $p_arr = [
                                    'pcode' => $fk_pcode,
                                    'cnt' => $t_cnt,
                                    'weight' => ($t_cnt * $weight)
                                ];
                                $eCnt = $order_m->Update_Package_Info($fk_pcode, $p_arr);

                            }
                        }

                        $rCnt = $herb_m->Update_Order_Step($sn, $delidate, $n_step);
                        $i_arr = [
                            'eCnt' => $rCnt,
                            'sn' => $sn,
                            'n_step' => $n_step
                        ];

                        $typ = 'Order_Step';
                        $Log = 'Order_Step:' . $this->OrderStepName($n_step) . '|ostep:' . $o_step . '|nstep:' . $n_step . '|data:' . $sn;
                        $this->Log_Reg($mi_code, $typ, $Log);

                        $result = 'ok';
                        $info = $i_arr;
                        $message = '';
                    }
                }
            }
        }

        $return = [
            'result' => $result,
            'info' => $info,
            'message' => $message
        ];
        return $this->respond($return);
    }


    public function Order_Step_Do2(){
        $o_data = (fn_IsEmpty($this->request->getPost('data'))) ? [] : $this->request->getPost('data');
        $o_step = ($this->request->getPost('ostep') == '') ? '' : $this->request->getPost('ostep');
        $n_step = ($this->request->getPost('nstep') == '') ? '' : $this->request->getPost('nstep');
        $oCnt = fn_ArrayCnt($o_data);
        if(($oCnt<=0) || ($o_step=='')|| ($n_step=='')){
            $result = 'type101';
            $info = '';
            $message = '선택하신 약재 정보를 확인하여주세요.';
        }else{
            $sessinarr = $this->GetSessionData();
            if (!$sessinarr['islogin']) {
                $result = 'NoLogin';
                $info = '';
                $message = '로그인을 하셔야 합니다.';
            } else {
                $mi_code = $sessinarr['user']['mi_code'];
                $mi_type = $sessinarr['user']['mi_type'];
                if($mi_type==AUTH_PHARM) {
                    $result = 'AUTH_FAIL';
                    $info = '';
                    $message = '접근 권한이 없습니다.';
                }else {
                    $t_arr = array_column($o_data, 'sn');
                    $order_str = implode(",", $t_arr);
                    if ($order_str == '') {
                        $result = 'type102';
                        $info = '';
                        $message = '잘못된 접근입니다.';
                    } else {
                        $herb_m = model('Herb_m');
                        $Cnt = $herb_m->Cnt_Order_Step_Check($order_str, $o_step, $mi_code);
                        if ($Cnt > 0) {
                            $result = 'type103';
                            $info = '';
                            $message = "주문상태가 잘못된 주문이 존재합니다\n 선택된 주문 확인하여주세요.";
                        } else {
                            $order_m = model('Order_m');
                            if ($n_step == ORDER_PROCESSING) {
                                $Rs = $order_m->Load_Order_Goods_IN($t_arr);

                                if (fn_ArrayCnt($Rs) <= 0) {
                                    $result = 'type113';
                                    $message = '배송 항목 정보 확인에 실패하였습니다.';
                                } else {
                                    $u_Cnt = 0;
                                    $u_weight = 0;
                                    foreach ($Rs as $d) {
                                        $sn = $d['sn'];
                                        $t_cnt = $d['gd_cnt'];
                                        $weight = $d['w_value'];
                                        $od_code = $d['fk_odcode'];
                                        $gd_code = $d['gd_code'];
                                        $od_wcode = $d['od_wcode'];
                                        $od_wname = $d['od_wname'];

                                        $tarr = [
                                            'w_code' => $od_wcode,
                                            'p_type' => 0
                                        ];
                                        $Rs2 = $order_m->Load_Package_Goods_Active($tarr);
                                        if (fn_ArrayCnt($Rs2) <= 0) {
                                            $fk_pcode = $this->Make_Code(6);
                                            $marr = [
                                                'pcode' => $fk_pcode,
                                                'mi_code' => $mi_code,
                                                'w_code' => $od_wcode,
                                                'w_name' => $od_wname
                                            ];
                                            $Cnt = $order_m->Insert_Package($marr);
                                        } else {
                                            $fk_pcode = $Rs2[0]['pcode'];
                                        }

                                        $sarr = [
                                            'pa_code' => $this->Make_Code(5),
                                            'fk_pcode' => $fk_pcode,
                                            'fk_odcode' => $od_code,
                                            'fk_gdcode' => $gd_code,
                                            't_cnt' => $t_cnt,
                                            't_weight' => ($t_cnt * $weight),
                                            'delidate' => fn_AddDay(2, 3)
                                        ];
                                        $Cnt = $order_m->Insert_Package_Goods($sarr);

                                        $p_arr = [
                                            'pcode' => $fk_pcode,
                                            'cnt' => $t_cnt,
                                            'weight' => ($t_cnt * $weight)
                                        ];
                                        $eCnt = $order_m->Update_Package_Info($fk_pcode, $p_arr);
                                    }
                                }
                            }

                            $rCnt = $herb_m->Update_Order_Step($t_arr, $n_step);
                            $i_arr = [
                                'eCnt' => $rCnt,
                                'list' => $t_arr
                            ];

                            $typ = 'Order_Step';
                            $Log = 'Order_Step:' . $this->OrderStepName($n_step) . '|ostep:' . $o_step . '|nstep:' . $n_step . '|data:' . $order_str;
                            $this->Log_Reg($mi_code, $typ, $Log);

                            $result = 'ok';
                            $info = $i_arr;
                            $message = '';
                        }
                   }
                }
            }
        }

        $return = [
            'result' => $result,
            'info' => $info,
            'message' => $message
        ];
        return $this->respond($return);
    }
    
    
    public function Insert_Cart()
    {
        $str = ($this->request->getPost('str') == '') ? '' : $this->request->getPost('str');
        if ($str == '') {
            $result = 'type101';
            $info = '';
            $message = '선택하신 약재 정보를 확인하여주세요.';
        } else {
            $cart = json_decode($str, true);
            if (($cart == '') && (fn_ArrayCnt($cart) <= 0)) {
                $result = 'type102';
                $info = '';
                $message = '구매약재 정보를 확인하여주세요.';
            } else {
                $sessinarr = $this->GetSessionData();
                if (!$sessinarr['islogin']) {
                    $result = 'NoLogin';
                    $info = '';
                    $message = '로그인을 하셔야 합니다.';
                } else {
                    $total = 0;
                    $mi_code = $sessinarr['user']['mi_code'];
                    $mi_type = $sessinarr['user']['mi_type'];
                    if ($mi_type == AUTH_PHARM) {
                        $result = 'AUTH_FAIL';
                        $info = '';
                        $message = '접근 권한이 없습니다.';
                    } else {

                        $member_m = model('Member_m');
                        $minfo = $member_m->Load_Company_micode($mi_code);
                        $cfCode = (fn_ArrayCnt($minfo) > 0) ? $minfo[0]['mi_cfcode'] : '';

                        $herb_m = model('Herb_m');
                        $arr = [];
                        foreach ($cart as $d) {
                            $t_arr = [];
                            $pRs = $herb_m->Load_Product_Code($d['code']);
                            if (fn_ArrayCnt($pRs) > 0) {
                                $p_arr = $this->LoadPrice($pRs[0]['hn_code']);

                                if ($d['ptyp'] == 1) {
                                    $gd_pType = 1;
                                    $gd_price = $p_arr[0]['hn_pPrice'];
                                    $gd_period = 0;
                                } else {
                                    $gd_pType = 2;
                                    $gd_price = $p_arr[1]['hn_pPrice'];
                                    $gd_period = $p_arr[1]['hn_period'];
                                }

                                $total = (int)$gd_price * (int)$d['cnt'];

                                $dRs = $herb_m->Load_Cart_Info($mi_code, $d['code'], $d['ptyp']);
                                if (fn_ArrayCnt($dRs) <= 0) {
                                    $t_arr = [
                                        'fk_micode' => $mi_code,
                                        'fk_macode' => $pRs[0]['fk_micode'],
                                        'fk_hncode' => $pRs[0]['hn_code'],
                                        'ct_pType' => $gd_pType,
                                        'ct_cnt' => $d['cnt'],
                                        'ct_gPrice' => $gd_price,
                                        'ct_tPrice' => $total,
                                        'ct_period' => $gd_period
                                    ];
                                    $Cnt = $herb_m->Insert_Cart2($t_arr);
                                } else {
                                    $sn = $dRs[0]['sn'];
                                    $t_arr = [
                                        'ct_cnt' => ($dRs[0]['ct_cnt'] + $d['cnt']),
                                        'ct_tPrice' => ($dRs[0]['ct_tPrice'] + ($d['cnt'] * $gd_price))
                                    ];
                                    $Cnt = $herb_m->Update_Cart($sn, $t_arr);
                                }
                            }
                        }

                        $result = 'ok';
                        $info = '';
                        $message = 'success';
                    }
                }
            }
        }

        $return = [
            'result' => $result,
            'info' => $info,
            'message' => $message
        ];
        return $this->respond($return);

    }

    public function Del_Match_Data2()
    {
        $sessinarr = $this->GetSessionData();
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $data = '';
