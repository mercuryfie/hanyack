    public function Load_Order_Decoc()
    {
        $sessinarr = $this->GetSessionData();
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $info = '';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            if ($mi_type != AUTH_DECOC) {
                $result = 'type111';
                $info = '';
                $message = '권한이외의 접근입니다.';
            } else {
                $mi_code = $sessinarr['user']['mi_code'];
                $page = ($this->request->getPost('page') == '') ? 1 : $this->request->getPost('page');
                $limit = 50;

                $offset = $limit * ($page - 1);
                $param = [
                    'micode' => $mi_code,
                    'offset' => $offset,
                    'limit' => $limit
                ];

                $order_m = model('Order_m');
                $herb_m = model('Herb_m');
                $Rs = $order_m->Load_Order_page($param);
                if (fn_ArrayCnt($Rs) <= 0) {
                    $result = 'ok';
                    $info = '';
                    $message = '주문정보 없습니다.';
                } else {
                    $data = [];
                    foreach ($Rs as $d) {
                        $m_data = [];
                        $Rs2 = $order_m->Load_Order_Goods_Decoc($d['od_code']);
                        if(fn_ArrayCnt($Rs2)>0) {
                            foreach ($Rs2 as $f) {

                                if ($f['gd_pType'] == 1) {
                                    $hn_str = ORDER_TYPE_1;
                                } else if ($f['gd_pType'] == 2) {
                                    $hn_str = ORDER_TYPE_2;
                                } else if ($f['gd_pType'] == 3) {
                                    $hn_str = ORDER_TYPE_3;
                                }

                                $fRs = $herb_m->Load_Product_File_Code($f['fk_hncode']);
                                if (fn_ArrayCnt($fRs) > 0) {
                                    foreach ($fRs as $c) {
                                        if ($c['typ'] == 1) {
                                            $fname['img'] = $c['fname'];
                                        } else if ($c['typ'] == 2) {
                                            $fname['data'] = $c['fname'];
                                        }
                                    }
                                }

                                if (fn_IsEmpty($f['gd_delicomplete'])) {
                                    $diff2 = '';
                                } else {
                                    $diff2 = fn_toDaysDiffUp($f['gd_delicomplete'], 7);
                                }


                                $t_data = [
                                    'sn' => $f['sn'],
                                    'gd_code' => $f['gd_code'],
                                    'hncode' => $f['fk_hncode'],
                                    'gd_pType' => $f['gd_pType'],
                                    'gd_price' => $f['gd_price'],
                                    'gd_cnt' => $f['gd_cnt'],
                                    'gd_rPrice' => $f['gd_rPrice'],
                                    'gd_period' => $f['gd_period'],
                                    'gd_status' => $f['gd_status'],
                                    'gd_delidate' => $f['gd_delidate'],
                                    'delicode' => $f['delicode'],
                                    'delitype' => $f['delitype'],
                                    'hn_name' => $f['hn_name'],
                                    'fk_mdname' => $f['fk_mdname'],
                                    'mi_name' => $f['mi_name'],
                                    'n_key' => $f['n_key'],
                                    'n_value' => $f['n_value'],
                                    't1code' => $f['fk_t1code'],
                                    't1_value' => $f['t1_value'],
                                    't2code' => $f['fk_t2code'],
                                    't2_value' => $f['t2_value'],
                                    'w_name' => $f['w_name'],
                                    'w_value' => $f['w_value'],
                                    'hn_method' => $f['gd_pType'],
                                    'hn_method_str' => $hn_str,
                                    'fname' => $fname,
                                    'od_regdate' => $f['od_regdate'],
                                    'diff' => fn_toDaysDiffUp($f['od_regdate'], 4),
                                    'diff2' => $diff2
                                ];
                                array_push($m_data, $t_data);
                            }
                            $c_data = [
                                'od_code' => $d['od_code'],
                                'mi_code' => $d['od_micode'],
                                'mi_name' => $d['mi_name'],
                                'mi_email' => $d['mi_busiemail'],
                                'mi_address' => $d['mi_busiaddr'],
                                'od_price' => $d['od_price'],
                                'regidate' => fn_Short_Date($d['od_regdate']),
                                'goods' => $m_data
                            ];
                            array_push($data, $c_data);
                        }
                    }

                    $i_arr = [
                        'list' => $data
                    ];
                    $result = 'ok';
                    $info = $i_arr;
                    $message = 'success';
                }
            }
        }
        $return = [
            'result' => $result,
            'info' => $info,
            'message' => $message
        ];
        return $this->respond($return);
    }

