    public function claim()
    {
        $sessinarr = $this->GetSessionData();
        if(!$sessinarr['islogin']){
            return redirect()->to('/Member/Login')->with('msg','로그인이 필요합니다.');
        }else {
            $sn = ($this->request->getGet('gd')=='') ? '' : $this->request->getGet('gd');
            if($sn==''){
                fn_Alert('잘못된 접근입니다.');
            }else{
                $order_m = model('Order_m');
                $oRs = $order_m->Load_Order_Goods($sn);
                if(fn_ArrayCnt($oRs)<=0){
                    fn_Alert('존재하지 않는 주문입니다.');
                }else{
                    $d = $oRs[0];
                    $status = $d['gd_status'];
                    if($status!=4){
                        fn_Alert('배송완료 중인 주문만 가능합니다.');
                    }else if(fn_toDaysDiffUp($d['gd_delicomplete'], 7)){
                        fn_Alert('배송완료후 7일 이전에만 반품이 가능합니다.\n관리자로 문의 해주세요.');
                    }else {
                        $info = [
                            'odcode' => $d['fk_odcode'],
                            'gdcode' => $d['gd_code'],
                            'w_name' => $d['mi_name'],
                            'hn_name' => $d['hn_name'],
                            'n_key' => $d['n_key'],
                            'n_value' => $d['n_value'],
                            'optionstr' => $this->Product_Option_str($d['t1_value'], $d['t2_value']),
                            'gd_pType' => $d['gd_pType'],
                            'gd_pstr' => $this->Order_Type_Name($d['gd_pType']),
                            'gd_price' => $d['gd_price'],
                            'gd_rPrice' => $d['gd_rPrice'],
                            'gd_cnt' => $d['gd_cnt'],
                            'hn_code' => $d['fk_hncode'],
                            'mm_medicine' => $d['mm_medicine']
                        ];

                        $s_data = [];

                        $metaarr = [
                            'h_title' => '반품/교환접수',
                            'h_type' => 1
                        ];

                        $body = [
                            'info' => $info
                        ];

                        $form = new Form;
                        $main_data = [
                            'meta' => $form->fnMake_Meta($metaarr),
                            'header' => $form->fnMake_Header($sessinarr),
                            'left_menu' => $form->fnMake_Left($sessinarr),
                            'search' => $form->fnMake_Search($s_data),
                            'body' => $body
                        ];

                        return view('web/decoc/return_View', $main_data);
                    }
                }
            }
        }
    }


