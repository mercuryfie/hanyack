    function exportListToExcel($list, $filename = 'medicine_list.xlsx') {
        $spreadsheet = new Spreadsheet();
        $sheet = $spreadsheet->getActiveSheet();

        // 헤더 출력 (키 이름을 한글로 원하면 여기서 변경 가능)
        $headers = array_keys($list[0]);
        $sheet->fromArray($headers, NULL, 'A1');

        // 데이터 출력
        $data = [];
        foreach ($list as $item) {
            $data[] = array_values($item);
        }
        $sheet->fromArray($data, NULL, 'A2');

        // 엑셀 파일 쓰기
        $writer = new Xlsx($spreadsheet);
        $writer->save($filename);

        return $filename;
    }

    public function pList()
    {
        $sessinarr = $this->GetSessionData();
        if($sessinarr['islogin']==false) {
            $mi_type = '';
            fn_Alert('로그인이 필요합니다. ','/Member/Login');
        }else {
            $l_typ = ($this->request->getGet('lp') == '') ? '1' : $this->request->getGet('lp');
            $sKey = ($this->request->getGet('skey') == '') ? '' : $this->request->getGet('skey');
            $page = ($this->request->getGet('page') == '') ? 1 : $this->request->getGet('page');

            $header_arr = [
                'skey' => $sKey
            ];


            $metaarr = [
                'h_title' => '상품 리스트',
                'h_type' => 1
            ];

            $limit = 30;
            $offset = $limit * ($page - 1);

            $member_m = model('Member_m');
            $mRs = $member_m->Load_Company_miType('pharm');
            if(fn_ArrayCnt($mRs)>0){
                $option = '';
                foreach ($mRs as $d){
                    $option .= "<option value='{$d['mi_code']}'>{$d['mi_name']}</option>";
                }
            }

            $bodydata = [
                'page'=> $page,
                'typ' => $l_typ,
                'option' => $option
            ];

            $form = new Form;
            $main_data = [
                'meta' => $form->fnMake_Meta($metaarr),
                'header' => $form->fnMake_Header($sessinarr,$header_arr),
                'left_menu' => $form->fnMake_Left($sessinarr),
                'body' => $bodydata
            ];

            if($l_typ==1) {
                return view('web/decoc/mainThum_View', $main_data);
            }else{
                return view('web/decoc/mainList_View', $main_data);
            }
        }
    }

