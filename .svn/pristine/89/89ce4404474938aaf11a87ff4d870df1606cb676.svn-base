<form action="" id="thisForm">
<div class="eventPopCon" id="eventPop"  name="eventPop" style="">
    <div class="eventPop">
        <h2 class="head_title" id="btn_close">이벤트 설정</h2>
        <i class="fa-solid fa-xmark Xbtn" id="XBtn"></i>
        <div class="eventPopBox mt20 ">
            <div class="eventPop1-1">
                <div class="items flexType2">
                    <p class="title">제약사</p>
                    <p class="data" id="miname"></p>
                </div>
                <div class="items flexType2">
                    <p class="title">생산코드</p>
                    <p class="data" id="hncode"></p>
                </div>
                <div class="items flexType2">
                    <p class="title">약재명</p>
                    <p class="data" id="hnname"></p>
                </div>
                <div class="items flexType2">
                    <p class="title">노출영역</p>
                    <select name="" id="eventType" class="inputType160 mr10">
                        <option value="1" >인기 한약재</option>
                        <option value="2">추천 한약재</option>
                        <option value="3">신규 한약재</option>
                    </select>
                    <button type="button" class="btnType1"
                            onclick="addEvent($('#hncode').text());">확인</button>
                </div>
            </div>
            <div class="eventPop1-2 mb40 flexType4"  >
                <table class="eventTable" id="eventTable">
                    <tr>
                        <td class="key key1" name="">생산코드</td>
                        <td class="key key2">약재명</td>
                        <td class="key key3">노출영역</td>
                        <td class="key key3"></td>
                    </tr>
                </table>
                <div class="" name="addEvent" id="addEvent">

                </div>

            </div>
            <div class="eventLast">
                <button class=" btnType99 mr10" id="cnxl">취소</button>
                <button class=" btnType9" id="submitBtn" onclick="add_Event();">확인</button>
            </div>
        </div>
<!--        <div class="machingPop1-4">-->
<!--            <button class="closeMachingPop btnType1" id="btn_close">닫기</button>-->
<!--            <button class="pop btnType2" id="popMatch" name="popMatch" data-hncode="" data-mm_origin="" data-mm_medicine="" data-mm_title_kor="" data-mm_origin_kor="" >매칭하기</button>-->
<!--        </div>-->
    </div>
</div>
</form>