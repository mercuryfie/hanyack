<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>prdBarcodePreview</title>
    <script src="/assets/web/js/prdBarcodePreview_do.js"></script>
    <style>
        .modal_wrapux7 {
            border:1px solid red;
            width: 320px;
            height: 520px;
            color:red;
        }

        .print_box40c {
            border:1px solid blue;
            margin: 10px;
            width: 300px;
            height: 500px;
        }

        .print_box40c .barcodeBox {
            display:flex;
            justify-content: center;
            align-items: center;

        }

        .print_box40c .barcodeBox img {
            border:1px solid red;
            width: 220px;
        }

        .print_boxfv6 {
            width: 300px;
            height: 32px;

        }

        .flexType1 {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .flexType2 {
            display: flex;
            justify-content: flex-start;
            align-items: center;
        }
    </style>
</head>
<body>
    <div class="modal_wrapux7">
        <form action="">
            <div class="print_box40c">
                <div class="barcodeBox ">
                    <img src="/assets/web/src/logo_master.png" alt="img">
                </div>
                <div class="print_boxfv6 flexType2">
                    <p class="category mr10">제조판매원 : </p>

                </div>
                <div class="print_boxfv6 flexType2">
                    <p class="category mr10">제조사 주소 : </p>

                </div>
                <div class="print_boxfv6 flexType2">
                    <p class="category mr10">연락처 : </p>

                </div>
            </div>

            <div class="flexType2">
                <input type="checkbox" name="" id="" class="mr10">
                <p class="category mr10">제조판매원</p>
            </div>
            <div class="flexType2">
                <input type="checkbox" name="" id="" class="mr10">
                <p class="category mr10">제조사 주소</p>
            </div>
            <div class="flexType2">
                <input type="checkbox" name="" id="" class="mr10">
                <p class="category mr10">연락처</p>
            </div>
            <div class="flexType2">
                <input type="checkbox" name="" id="" class="mr10">
                <p class="category mr10">포장중량</p>
            </div>
            <div class="flexType2">
                <input type="checkbox" name="" id="" class="mr10">
                <p class="category mr10">원산지</p>
            </div>
            <div class="flexType2">
                <input type="checkbox" name="" id="" class="mr10">
                <p class="category mr10">제조번호</p>
            </div>
            <div class="flexType2">
                <input type="checkbox" name="" id="" class="mr10">
                <p class="category mr10">허가번호</p>
            </div>
            <div class="flexType2">
                <input type="checkbox" name="" id="" class="mr10">
                <p class="category mr10">사용기한</p>
            </div>
            <div class="flexType7">
                <button type="button" class="btnType3">취소</button>
                <button type="button" class="btnType4">저장</button>
            </div>
        </form>
    </div>
</body>
</html>