$(document).ready(function() {
    Load_Order(1, '','');

    $(document).on('change','#decoc_filter,#pharm_filter',function(){
        let decoc = $('#decoc_filter').val();
        let pharm = $('#pharm_filter').val();

        Form_ini();
        Load_Order(1,decoc,pharm);
    });


});

async function  Load_Order(page,decoc,pharm){
    try {
        start_spinner();
        let dataarr = {"page": page, "decoc": decoc,"pharm" : pharm};
        let url = APIURL + '/Load_OrderList';
        let result = await Load_API(url, dataarr);
        console.log(dataarr);
        if (result.get('status') == 'NoLogin') {
            go_login();
        } else if (result.get('status') == 'ok') {
            let html = '';
            let firstsn = '';
            let data = result.get('data');
            let arr = (data && data.list) ? data.list : [];
            let Cnt = arr.length;
            let gd_ptype_css = ''
            if (Cnt > 0) {
                $.each(arr, function (index, el) {
                    if(el.gd_status==0) {
                        gd_status_css = 'tagType11';
                    } else if (el.gd_status==1){
                        gd_status_css ='tagType12';
                    } else if (el.gd_status==2){
                        gd_status_css ='tagType13';
                    } else if (el.gd_status==3){
                        gd_status_css ='tagType14';
                    } else {
                        gd_status_css ='tagType15';
                    }

                    if(el.gd_ptype=='일반') {
                    gd_ptype_css = 'tagType1';
                    } else if (el.gd_ptype=='정기'){
                        gd_ptype_css ='tagType2';
                    } else {
                        gd_ptype_css ='tagType3';
                    }

                    html +=`
                        <tr>
                            <td><p class="${gd_status_css}">${Order_Step_Name(el.gd_status)}</p></td>
                            <td>${el.gd_code}</td>  
                            <td>${el.od_regdate}</td>
                            <td>${el.mi_name}</td>
                            <td>${el.od_wname}</td>
                            <td>${el.hn_name}</td>
                            <td class="">
                                <p class="${gd_ptype_css}">${el.gd_ptype}</p></td>
                            <td class="">${el.hn_option}</td>
                            <td>${el.gd_cnt}개</td>
                            <td>${number_format(el.gd_rPrice)}원</td>
                            <td>${number_format(el.gd_price)}원</td>
                        </tr>
                    `;
                });
            }else{
                html = '<tr><td colspan="11">주문정보가 없습니다.</td></tr>'
            }
            $('#orderlist').append(html);
        }else{
            Make_Toast(result.get('message'));
        }
        stop_spinner();
    }catch(error){
        Make_Toast('오류가 발생하였습니다. 다시 시도하여주세요.\n[ERROR : ' + error + '}');
        stop_spinner();
    }
}

function Form_ini(){
    $('#orderlist').empty();
}

