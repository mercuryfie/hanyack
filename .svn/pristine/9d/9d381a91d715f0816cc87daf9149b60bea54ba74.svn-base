$(document).ready(function() {
    Load_Data(1);

    $(document).on('change', 'input[type="checkbox"].chkproduct', function(e) {
        let tpriceclass = $(this).closest('.cartgds').find('.tPrice');

        if ($(this).is(':checked')) {
            let total = $('#totalprice').data('tprice');
            let t_price = tpriceclass.data('tprice');
            let n_price = Number(total) + Number(t_price);
            $('#totalprice').html('총 ' + n_price.toLocaleString() + '원');
            $('#totalprice').data('tprice', n_price);
        } else {
            let total = $('#totalprice').data('tprice');
            let t_price = tpriceclass.data('tprice');
            let n_price = Number(total) - Number(t_price);
            if (n_price < 0) n_price = 0;
            $('#totalprice').html('총 ' + n_price.toLocaleString() + '원');
            $('#totalprice').data('tprice', n_price);
        }
    });

    $(document).on('change', 'input[type="checkbox"].ChkMaker', function(e) {
        let code = $(this).attr('data-code');
        let chk_name = 'chk_' + code;
        let isChecked = $(this).is(':checked');
        $('input[type="checkbox"][name="' + chk_name + '"]').each(function(index, element) {
            $(element).prop('checked', isChecked).trigger('change');
        });
    });

    $(document).on('click','#btn_delEdit',function(e){
        let url = '/Mydecoc/deliveryInfo';
        $(location).attr("href", url);
    });

    $(document).on('click','#btn_cartOrder',async function(e){
        let items = [];
        let items1 = [];
        $('input.chkproduct:checked').each(function () {
            let nsn  = $(this).data('sn');
            let code  = $(this).data('code');
            let pType = $(this).data('ptyp');
            let cnt   = $(this).closest('.goodsbox').find('.price_cnt').html();
            items.push({code: code,cnt: cnt,ptyp: pType});
            items1.push({sn:nsn});
        });

        let Cnt = items.length;
        if(Cnt <=0){
            Make_Toast('주문하실 약재를 선택하세요.');
        }else if(window.confirm('주문하시겠습니까?')==true){
            let str = JSON.stringify(items);
            let bool = await Insert_Order(str);
            if(bool){
                await Promise.all(
                    items1.map(async el => {
                        let bool1 = await Cart_Del_Do(el.sn);
                        if (bool1) {
                            $(`#sub_${el.sn}`).remove();
                        }
                    })
                );
            }else{
                Make_Toast('주문 처리에 실패 하였습니다.');
            }
        }
    });

    $(document).on('click','.dltbtn',function(e){
        let sn = $(this).data('sn');
        $('#cart_del').data('sn',sn);
        $('#endOrderDel').show();

    });

    $(document).on('click','.close_dltmer',function(e){
        $('#cart_del').data('sn','');
        $('#endOrderDel').hide();
    });

    $(document).on('click','#cart_del',async function(e){
        let sn = $(this).data('sn');
        let bool = await Cart_Del_Do(sn);
        if(bool){
            $(`#sub_${sn}`).remove();
        }
        $('#endOrderDel').hide();
        location.reload();

    });
});

async function Insert_Order(str){
    let bool = false;
    try {
        start_spinner();
        let dataarr = {"str" : str};
        let url = APIURL + '/Insert_Order';
        let result = await Load_API(url,dataarr);
        if (result.get('status') == 'NoLogin') {
            go_login();
            bool = false;
        }else if(result.get('status') == 'ok') {
            $('#endOrder').show();
            bool = true;
        } else {
            Make_Toast(result.get('message'));
            bool = false;
        }
        stop_spinner();
    } catch (error) {
        Make_Toast('오류가 발생하였습니다. 다시 시도하여주세요.\n[ERROR : ' + error.get('message') + '}');
        stop_spinner();
        bool = false;
    }

    return bool;
}


async function Cart_Del_Do(sn){
    let bool = false;
    try {
        start_spinner();
        INI_Load_Data();
        let dataarr = {"sn": sn};
        let url = APIURL + '/Del_Cart';
        let result = await Load_API(url, dataarr);
        console.log(result);
        if (result.get('status') == 'NoLogin') {
            go_login();
            bool = false;
        } else if (result.get('status') == 'ok') {
            bool = true;
        } else {
            Make_Toast(result.get('message'));
            bool = false;
        }
        stop_spinner();

    } catch (error) {
        Make_Toast('오류가 발생하였습니다. 다시 시도하여주세요.\n[ERROR : ' + error + '}');
        stop_spinner();
        bool = false;
    }
    return bool;
}

function price_minus1(form,price){
    let Cnt =  $(form).parent().find('.price_cnt').html();

    if(Cnt >0){
        let total = $('#totalprice').data('tprice');
        let n_Cnt = Number(Cnt)-1;
        let now_price = Number(price) * Number(n_Cnt);
        let str_price = number_format(now_price) + '원';
        $(form).parent().find('.price_cnt').html(n_Cnt);
        $(form).closest('.goodsright').find('.tPrice').html(str_price);
        $(form).closest('.goodsright').find('.tPrice').data('price', now_price);

        let bool = $(form).parent().parent().parent().find('.chkproduct').is(':checked')
        if(bool){
            let n_price = Number(total) - Number(price);
            if (n_price < 0) n_price = 0;
            $('#totalprice').html('총 ' + n_price.toLocaleString() + '원');
            $('#totalprice').data('tprice', n_price);
        }

        if(n_Cnt<=0) {
            console.log('11');
            $(form).parent().parent().parent().find('.chkproduct').prop("checked", false);
        }
    }
}

function price_plus1(form,price){
    let Cnt =  $(form).parent().find('.price_cnt').html();

    let total = $('#totalprice').data('tprice');
    let n_Cnt = Number(Cnt)+1;
    let now_price = Number(price) * Number(n_Cnt);
    let str_price = number_format(now_price) + '원';
    $(form).parent().find('.price_cnt').html(n_Cnt);
    $(form).closest('.goodsright').find('.tPrice').html(str_price);
    $(form).closest('.goodsright').find('.tPrice').data('price', now_price);


    let bool = $(form).parent().parent().parent().find('.chkproduct').is(':checked')
    if(bool){
        let n_price = Number(total) + Number(price);
        $('#totalprice').html('총 ' + n_price.toLocaleString() + '원');
        $('#totalprice').data('tprice', n_price);
    }
}

function price_minus(form,price){
    let cntClass = $(form).closest('.right').find('.price_cnt');
    let now_cnt = cntClass.html();
    let new_cnt = Number(now_cnt)-1;
    let new_price = new_cnt * price;
    if(now_cnt<=0) now_cnt = 0;
    if(new_cnt<=0) new_cnt = 0;
    if(new_price<=0) new_price = 0;

    cntClass.html(new_cnt);

    let tclass = $(form).closest('.count_boxy2w').find('.left .tPrice');
    tclass.data('tprice',new_price);
    tclass.html(Number(new_price).toLocaleString() + '원');

    let chkclass = $(form).closest('.cartgds').find('.chkproduct');
    let checked = chkclass.prop('checked');
    if(checked==true){
        let totalprice = $('#totalprice').data('tprice');
        let new_tprice =  Number(totalprice) - Number(price);
        if(new_tprice<=0) new_tprice = 0;
        $('#totalprice').data('tprice',new_tprice);
        $('#totalprice').html('총 ' + Number(new_tprice).toLocaleString() + '원');
    }
}

function price_plus(form,price){
    let cntClass = $(form).closest('.right').find('.price_cnt');
    let now_cnt = cntClass.html();
    let new_cnt = Number(now_cnt)+1;
    let new_price = new_cnt * price;

    cntClass.html(new_cnt);

    let tclass = $(form).closest('.count_boxy2w').find('.left .tPrice');
    tclass.data('tprice',new_price);
    tclass.html(Number(new_price).toLocaleString() + '원');

    let chkclass = $(form).closest('.cartgds').find('.chkproduct');
    let checked = chkclass.prop('checked');
    if(checked==true){
        let totalprice = $('#totalprice').data('tprice');
        let new_tprice =  Number(totalprice) + Number(price);
        $('#totalprice').data('tprice',new_tprice);
        $('#totalprice').html('총 ' + Number(new_tprice).toLocaleString() + '원');
    }
}


function box_minus(form,price,boxcnt){
    let cntClass = $(form).closest('.right').find('.price_cnt');
    let now_cnt = cntClass.html();

    let boxclass = $(form).closest('.right').find('.box_cnt');
    let now_box = boxclass.html();
    let new_cnt = Number(now_cnt) - Number(boxcnt);
    let new_box = Number(now_box) - 1;
    if(now_cnt<=0) now_cnt = 0;
    if(now_box<=0) now_box = 0;
    if(new_box<=0) new_box = 0;
    if(new_cnt<=0) new_cnt = 0;
    let new_price = Number(new_cnt) * price;
    let tclass = $(form).closest('.count_boxy2w').find('.left .tPrice');

    boxclass.html(new_box);
    cntClass.html(new_cnt);

    tclass.data('tprice',new_price);
    tclass.html(Number(new_price).toLocaleString() + '원');

    let chkclass = $(form).closest('.cartgds').find('.chkproduct');
    let checked = chkclass.prop('checked');
    if(checked==true){
        let totalprice = $('#totalprice').data('tprice');
        let new_tprice =  Number(totalprice) - (Number(price) * boxcnt);
        if(new_tprice<=0) new_tprice = 0;
        $('#totalprice').data('tprice',new_tprice);
        $('#totalprice').html('총 ' + Number(new_tprice).toLocaleString() + '원');
    }


}


function box_plus(form,price,boxcnt){
    let cntClass = $(form).closest('.right').find('.price_cnt');
    let now_cnt = cntClass.html();
    let boxclass = $(form).closest('.right').find('.box_cnt');
    let now_box = boxclass.html();
    let new_box = Number(now_box) + 1;
    let new_cnt = Number(now_cnt) + Number(boxcnt);
    let new_price = new_cnt * price;
    let tclass = $(form).closest('.count_boxy2w').find('.left .tPrice');

    boxclass.html(new_box);
    cntClass.html(new_cnt);

    tclass.data('tprice',new_price);
    tclass.html(Number(new_price).toLocaleString() + '원');

    let chkclass = $(form).closest('.cartgds').find('.chkproduct');
    let checked = chkclass.prop('checked');
    if(checked==true){
        let totalprice = $('#totalprice').data('tprice');
        let new_tprice =  Number(totalprice) + (Number(price) * boxcnt);
        $('#totalprice').data('tprice',new_tprice);
        $('#totalprice').html('총 ' + Number(new_tprice).toLocaleString() + '원');
    }

}

async function Load_Data(page) {
    try {
        start_spinner();
        INI_Load_Data();
        let dataarr = {"page" : page};
        let url = APIURL + '/Load_Cart_Info';
        let result = await Load_API(url,dataarr);
        if (result.get('status') == 'NoLogin') {
            go_login();
        }else if(result.get('status') == 'ok') {
            let html = '';
            let data = result.get('data');
            let tCnt = data.tCnt;
            let arr = (data && data.list) ? data.list : [];
            console.log(arr);
            let Cnt = arr.length;
            if (Cnt > 0) {
                $.each(arr, function (index, el) {
                    console.log(el.list);
                    let subhtml = '';
                    let lowhtml = '';
                    let typhtml = '';
                    $.each(el.list, function (index, sub){
                        let option_str = '';
                        option_str = concatWithDelimiter(sub.n_value,option_str,' / ');
                        option_str = concatWithDelimiter(sub.t1_value,option_str,' / ');
                        option_str = concatWithDelimiter(sub.t2_value,option_str,' / ');

                        if(sub.LowCnt<=0) {
                            lowhtml = `<span class="lowest">최저가</span>`;
                        }

                        if(sub.ptype==1){
                            typhtml = `<p class="hn_buyTypeStr1">일반</p>`;
                        }else{
                            typhtml = `<p class="hn_buyTypeStr2">정기</p>`;
                        }

                        subhtml += `
                            <div class="cartgds cartgoods1-2" id="sub_${sub.sn}">
                                <div class="goodsbox flexType4">
                                    <div class="goodsleft flexType4">
                                        <input type="checkbox" class="chkproduct" name="chk_${sub.macode}" data-sn="${sub.sn}" data-code="${sub.hncode}" data-ptyp="${sub.ptype}">
                                        <div class="imgBox">
                                            <img class="cartgoodsimg" src="${PRODUCT_IMG_URL}/${sub.thumnail}" alt="img">
                                        </div> 
                                    </div>
                                    <div class="goodsright">
                                        <div class="goodsttl flexType3">
                                            <div class="goodsttl1-1 flexType4">
                                                <p class="hbname">${sub.hnname}</p>
                                                ${typhtml} 
                                                ${lowhtml}
                                                <a href="javascript://" onclick="morelist('${sub.hnname}')" class="moreOption">더보기</a> 
                                            </div>
                                            <div class="goodsttl1-2">
                                                <i class="fa-solid fa-xmark dltbtn" data-sn="${sub.sn}"></i>
                                            </div>
                                        </div>
                                        <p class="option">${option_str}</p>
                                        <div class="count_boxy2w flexType3">  
                                          <div class="left flexType4"> 
                                            <p class="tPrice" data-tprice="${sub.t_tPrice}">${Number(sub.t_tPrice).toLocaleString()}원</p>  
                                          </div> 
                                          <div class="right"> 
                                            <div class="left2 flexType3"> 
                                                <p class="title">박스수량(1박스 ${sub.hn_boxCnt}개)</p> 
                                                <div class="cartcounter flexType3">
                                                    <i class="fa-regular fa-square-minus" onclick="box_minus(this,'${sub.t_gPrice}','${sub.hn_boxCnt}')"></i>
                                                    <p class="box_cnt">0</p>
                                                    <i class="fa-regular fa-square-plus" onclick="box_plus(this,'${sub.t_gPrice}','${sub.hn_boxCnt}')"></i>
                                                </div>
                                            </div>
                                            <div class="right2 flexType3">
                                                <p class="title">개별수량</p>
                                                <div class="cartcounter flexType3">
                                                    <i class="fa-regular fa-square-minus" onclick="price_minus(this,'${sub.t_gPrice}')"></i>
                                                    <p class="price_cnt" data-nprice="${sub.t_tPrice}">${sub.t_cnt}</p>
                                                    <i class="fa-regular fa-square-plus" onclick="price_plus(this,'${sub.t_gPrice}')"></i></td>
                                                </div>
                                            </div>
                                          </div>
                                        </div> 
                                    </div>
                                </div>
                            </div>
                        `;
                    });

                    html += `
                    <div class="clbox cartleft1-1">
                        <div class="cartgds cartgoods1-1">
                            <input type="checkbox" class="ChkMaker" data-code="${el.macode}">
                            <p>${el.maname}</p>
                        </div>
                        ${subhtml}
                    </div>
                    `;
                });
            } else {
                html = `
                    <div class="emptyCart">
                        <i class="fa-solid fa-circle-info"></i>
                        <p class="msg">장바구니에 담긴 상품이 없습니다</p>
                    </div>
                `;

            }
            $('#s_End').text(tCnt);
            $('#cartlist').append(html);
        } else {
            Make_Toast(result.get('message'));
        }
        stop_spinner();
    } catch (error) {
        Make_Toast('오류가 발생하였습니다. 다시 시도하여주세요.\n[ERROR : ' + error + '}');
        stop_spinner();
    }
}


function INI_Load_Data(){
    $('#s_Start').html('0');
    $('#s_End').html('0');
}

function morelist(key){
    let url = '/Product/pList?lp=2&skey=' + key;
    $(location).attr('href',url);
}