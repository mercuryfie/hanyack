const pharm = {
    /*
     Use : 제약사 약재 검색
     params :
     */
    async Search_Medicine_Pharm(params) {
        const res = await commonRequest('/Search_Medicine_Pharm', params);
        if (!res) return { list : [],total : 0};
        const [item = {}] = res?.data || [];
        return {
            list: item.list || [],
            total: item.tcnt || 0
        };
    }
};

window.pharm = pharm;