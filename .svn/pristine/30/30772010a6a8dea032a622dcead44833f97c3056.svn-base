function printWindow(id) {
    var init_body = document.body.innerHTML;
    var printContent = document.getElementById(id).innerHTML;

    // 인쇄하기 전 수행: 바로 수행하지 말고, print() 호출 전에 본문 교체
    document.body.innerHTML = printContent;

    // window.print를 바로 호출하지 말고, 약간의 지연을 줌 (렌더링 시간이 필요)
    setTimeout(function () {
        window.print();

        // 인쇄 완료 후 원래 내용 복원 (print 이후에 실행되도록 변경)
        document.body.innerHTML = init_body;
    }, 500);
}

function dataCopy(text) {
    let textArea = document.createElement("textarea");
    textArea.value = text;

    // 화면 밖으로 위치 이동시키기
    textArea.style.position = "fixed";
    textArea.style.left = "-9999px";
    textArea.style.top = "-9999px";

    document.body.appendChild(textArea);
    textArea.focus();
    textArea.select();

    try {
        document.execCommand('copy');
        Make_Toast('복사완료');
    } catch (err) {
        Make_Toast('복사실패');
        console.error('Fallback: 복사 실패', err);
    }

    document.body.removeChild(textArea);
}
