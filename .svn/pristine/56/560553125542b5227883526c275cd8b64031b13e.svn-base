<div class="machingPopCon" id="matchingpop"  name="matchingpop" style="display: none;">
    <div class="machingPop">
        <h2 class="head_title" id="btn_close">약재 매칭</h2>
        <i class="fa-solid fa-xmark" id="XBtn"></i>
        <div class="machingPop1-1 mt20">
            <div class="machingTitle">
                <p class="herbList ">매칭된 약재</p>
                <div class="machingContents ">
                    <div class="list" id="yaklist1" name="yaklist1" >

                    </div>
                </div>
            </div>
            <div class="machingPop1-4">
                <button class="closeMachingPop btnType1" id="btn_match_del" name="btn_match_del" data-cfcode="" data-meMed=""  data-medicine="">매칭해제</button>
            </div>
            <div class="machingTitle">
                <p class="herbList">매칭할 약재</p>
                <div class="machingContents" id="yaklist2" name="yaklist2">



                </div>
            </div>
            <div class="stockBox">
                <p class="title">적정재고</p>
                <input type="text" name="mm_stock" id="mm_stock" class="inputType240" placeholder="숫자만 입력" value="1500">
            </div>
            <div class="machingPop1-4">
                <button class="closeMachingPop btnType1" id="btn_match" data-hncode="" data-seq="" data-cfcode="" data-meMed="" data-medicine="" data-origin="" data-title="" data-maker="" >매칭하기</button>
            </div>
        </div>
    </div>
</div>