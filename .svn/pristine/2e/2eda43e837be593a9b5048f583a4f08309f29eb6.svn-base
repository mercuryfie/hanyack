$(document).ready(function () {

    Load_Order(1,'');

    $('#more, #more2').on('click',function(e){
        let page = $('#more').data('page');
        let skey = '';
        Load_Order(page,skey);
    });

    $('#btn_cancle').on('click',function(e){
        location.reload();
    });

    $('#btn_deli').on('click',function(e){
        let o_code ='';
        $('input:checkbox[name="chkorder"]').each(function (e) {

            if ($(this).is(':checked') == true) {
                if(o_code==''){
                    o_code = $(this).val();
                }else{
                    o_code += ',' +  $(this).val();
                }
            }
        });

        if(o_code!=''){
            if(window.confirm('선택하신 상품을 출하처리 하시겠습니까?')==true){
                ship_Step(o_code);
            }
        }
    });

});

async function Load_Order(page, skey) {
    try {
        start_spinner();
        INI_Load_Data();

        let dataarr = {"page" : page,"skey" : skey};
        let url = APIURL + '/Load_Order_Pharm';

        let result = await Load_API(url,dataarr);
        if (result.get('status') == 'NoLogin') {
            go_login();
        }else if(result.get('status') == 'ok') {
            let html = '';
            let data = result.get('data');
            let arr = (data && data.list) ? data.list : [];
            let Cnt = arr.length;
            if (Cnt > 0) {
                $.each(arr, function (index, el) {
                    let gd_status_str = '';
                    let gd_typ_str = '';
                    if (el.gd_status == 1) {
                        gd_status_str = 'disabled';
                    }
                    if (el.gd_status == 0) {
                        gd_typ_str = '미확인';
                    } else if (el.gd_status == 1) {
                        gd_typ_str = '주문확인중';
                    } else if (el.gd_status == 2) {
                        gd_typ_str = '출하요청';
                    } else if (el.gd_status == 3) {
                        gd_typ_str = '출하완료';
                    } else if (el.gd_status == 4) {
                        gd_typ_str = '배송중';
                    } else if (el.gd_status == 5) {
                        gd_typ_str = '배송완료';
                    }
                    html += `
                        <tr>
                            <td><input type="checkbox" name="chkorder" value="${el.sn}" ${gd_status_str}/></td>
                            <td>${gd_typ_str}</td>
                            <td>${el.od_code}</td>
                            <td>${el.gd_code}</td>
                            <td>${el.hn_name}</td>
                            <td>${el.od_wname}</td>
                            <td>${el.n_value}</td>
                            <td>${el.t1_value}</td>
                            <td>${el.t2_value}</td>
                            <td>${el.w_name}</td>
                            <td>${number_format(el.gd_price)}원</td>
                            <td>${number_format(el.gd_rPrice)}원</td>
                        </tr >
                    `;
                });
            }else{
                html = '<td colspan="11">주문내역이 없습니다.</td>';
            }
            $('#more,#more2').data('page',result.get('data').page);
            $('#orderlist').append(html);
        }else if(result.get('status') == 'last') {
            let tcnt = $('#orderlist tr').length;
            if(tcnt > 0) alert('마지막 입니다.');
            $('.moreListBox').css('display','none');
        } else {
            alert(result.get('message'));
        }
        stop_spinner();
    } catch (error) {
        alert('오류가 발생하였습니다. 다시 시도하여주세요.\n[ERROR : ' + error + '}');
        stop_spinner();
    }
}

async function ship_Step(key) {
    try {
        start_spinner();
        let dataarr = {"key": key};
        let url = APIURL + '/Ship_Step';
        let result = await Load_API(url,dataarr);
        //let result = await ship_Process(page, skey);
        if (result.get('status') == 'NoLogin') {
            go_login();
        }else if(result.get('status') == 'ok') {
            location.reload();
        } else {
            alert(result.get('message'));
        }
        stop_spinner();
    } catch (error) {
        alert('오류가 발생하였습니다. 다시 시도하여주세요.\n[ERROR : ' + error + '}');
        stop_spinner();
    }
}

