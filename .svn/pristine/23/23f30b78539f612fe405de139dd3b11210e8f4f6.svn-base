<?php

namespace App\Controllers;

use App\Libraries\Form;
use App\Libraries\Utils;
use App\Model;
use CodeIgniter\API\ResponseTrait;

class HerbController extends BaseController
{
    use ResponseTrait;


    public function __construct ()
    {
        $Auth = [AUTH_MASTER];
        $this->Check_Auth($Auth);
    }

    public function herbList()
    {
        $sessinarr = $this->GetSessionData();
        if(!$sessinarr['islogin']){
            return redirect()->to('/Member/Login')->with('msg','로그인이 필요합니다.');
        }else {
            $skey = ($this->request->getPost('skey')=='') ? '' : $this->request->getPost('skey');
            $page = ($this->request->getPost('page')=='') ? 1 : $this->request->getPost('page');
            $limit = 50;

            $s_data = [];

            $metaarr = [
                'h_title' => '상품리스트',
                'h_type' => 1
            ];

            $body = [
                'skey' => $skey,
                'page' => $page,
                'limit' => $limit
            ];

            $form = new Form;
            $main_data = [
                'meta' => $form->fnMake_Meta($metaarr),
                'header' => $form->fnMake_Header($sessinarr),
                'left_menu' => $form->fnMake_Left($sessinarr),
                'search' => $form->fnMake_Search($s_data),
                'body' => $body
            ];

            return view('web/master/herbListMaster_View', $main_data);
        }
    }

    public function herbMatch()
    {
        $sessinarr = $this->GetSessionData();
        if(!$sessinarr['islogin']){
            return redirect()->to('/Member/Login')->with('msg','로그인이 필요합니다.');
        }else {
            $cf_code = ($this->request->getPost('cf')=='') ? '' : $this->request->getPost('cf');
            $hn_name = ($this->request->getPost('hn')=='') ? '' : $this->request->getPost('hn');
            $page = ($this->request->getPost('page')=='') ? 1 : $this->request->getPost('page');
            $limit = 50;

            $s_data = [];

            $metaarr = [
                'h_title' => '약재매칭',
                'h_type' => 1
            ];

            $body = [
                'cf_code' => $cf_code,
                'hn_name' => $hn_name,
                'decoc' => $this->LoadDecocOption(AUTH_DECOC,$cf_code),
                'nation' => $this->LoadNationOption(''),
                'page' => $page,
                'limit' => $limit
            ];

            $form = new Form;
            $main_data = [
                'meta' => $form->fnMake_Meta($metaarr),
                'header' => $form->fnMake_Header($sessinarr),
                'left_menu' => $form->fnMake_Left($sessinarr),
                'search' => $form->fnMake_Search($s_data),
                'body' => $body
            ];

            return view('web/master/herbMatch_View', $main_data);
        }
    }

    public function updateApproval() {
        $authentifier = $this->request->getPost('authentifier');
        $model = new Herb_m();
        $model->updateHnIsok($authentifier, 1); // 1로 업데이트
        return $this->respond(['status' => 'success']);
    }


    public function orderList()
    {
        $sessinarr = $this->GetSessionData();
        if(!$sessinarr['islogin']){
            return redirect()->to('/Member/Login')->with('msg','로그인이 필요합니다.');
        }else{
            $uid = $sessinarr['user']['uid'];
            $mi_type = $sessinarr['user']['mi_type'];
            $metaarr = [
                'h_title' => '전체주문내역',
                'h_type' => 1
            ];
            $micode = ($this->request->getPost('micode')=='') ? '' : $this->request->getPost('micode');
            $wocode = ($this->request->getPost('wocode')=='') ? '' : $this->request->getPost('wocode');


            $decocarr = $this->LoadDecoc(AUTH_DECOC);
            $decocoption = '';
            if(fn_ArrayCnt($decocarr)>0){
                foreach ($decocarr as $c){
                    if($micode==$c['mi_code']){
                        $decocoption .= "<option selected value='{$c['mi_code']}'>{$c['mi_name']}</option>";
                    }else{
                        $decocoption .= "<option value='{$c['mi_code']}'>{$c['mi_name']}</option>";
                    }
                }
            }

            $pharmarr = $this->LoadDecoc(AUTH_PHARM);
            $pharmoption = '';
            if(fn_ArrayCnt($pharmarr)>0){
                foreach ($pharmarr as $c){
                    if($wocode==$c['mi_code']){
                        $pharmoption .= "<option selected value='{$c['mi_code']}'>{$c['mi_name']}</option>";
                    }else{
                        $pharmoption .= "<option value='{$c['mi_code']}'>{$c['mi_name']}</option>";
                    }
                }
            }

            $body_data = [
                'uid' => $uid,
                'option1' => $decocoption,
                'option2' => $pharmoption,
            ];

            $form = New Form;
            $main_data = [
                'meta' => $form->fnMake_Meta($metaarr),
                'header' => $form->fnMake_Header($sessinarr),
                'left_menu' => $form->fnMake_Left($sessinarr),
                'body' => $body_data
            ];

            return view('web/master/orderListMaster_View', $main_data);
        }
    }
