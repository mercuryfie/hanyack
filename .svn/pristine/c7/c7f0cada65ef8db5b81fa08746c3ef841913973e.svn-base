    public function Load_Product_Code($hncode,$fields=array('ALL')){
        $util = new Utils;
        $separated_val = $util->fnMake_Fields($fields);
        $builder = $this->db->table('v_product_info_all');
        $builder->select($separated_val);
        $builder->where('hn_code', $hncode);
        $query = $builder->get();

        return $query->getResultArray();
    }

