        $builder->update();
        $affected_rows = $this->db->affectedRows();
        $this->db->transComplete();

        return $affected_rows;
    }


   public function Product_Match_Load($hncode,$fields=array('ALL')){
       $util = new Utils;
       $separated_val = $util->fnMake_Fields($fields);
       $sql = "SELECT {$separated_val} from herb_product_match a,v_product_info_all b WHERE a.fk_hncode=b.hn_code and a.fk_hncode=:ID:;";
       $bindparam = array(
           'ID' => $hncode
       );
       $Query = $this->db->query($sql,$bindparam);
       return $Query->getResultArray();
   }

    public function Decoc_Match_Load($micode,$mmcode,$fields=array('ALL')){
        $util = new Utils;
        $separated_val = $util->fnMake_Fields($fields);
        $sql = "SELECT {$separated_val} from herb_product_match where fk_micode=:MICODE: and mm_medicine=:MMCODE:";
        $bindparam = array(
            'MICODE' => $micode,
            'MMCODE' => $mmcode
        );
        $Query = $this->db->query($sql,$bindparam);
        return $Query->getResultArray();
    }


    public function Load_ItemDetail($hncode,$fields=array('ALL')){
        $util = new Utils;
        $separated_val = $util->fnMake_Fields($fields);
        $sql = "SELECT {$separated_val} from v_product_info_all a WHERE a.hn_code=:HNCODE:;";
        $bindparam = array(
            'HNCODE' => $hncode
        );
        $Query = $this->db->query($sql, $bindparam);
        return $Query->getResultArray();
    }


