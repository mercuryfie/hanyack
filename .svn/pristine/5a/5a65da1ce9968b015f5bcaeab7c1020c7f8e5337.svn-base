    public function Ship_Step()
    {
        $util = new Utils();
        $sessinarr = $util->fnGetSessionData();
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            $mi_code = $sessinarr['user']['mi_code'];
            if ($mi_type != 'pharm') {
                $result = 'type111';
                $message = '권한이외의 접근입니다.';
            } else {
                $request = service('request');
                $key = ($request->getPost('key') == '') ? '' : $request->getPost('key');
                if ($key == '') {
                    $result = 'type112';
                    $message = '출하처리 할 목록을 확인하세요.';
                } else {
                    $order_m = model('Order_m');
                    $k_arr = explode(',', $key);
                    $Rs = $order_m->Load_Order_Goods_IN($k_arr);
                    if ($util->fnArrayCnt($Rs) <= 0) {
                        $result = 'type113';
                        $message = '출하 항목 정보 로드에 실패하였습니다.';
                    } else {
                        $u_Cnt = 0;
                        $u_weight = 0;
                        foreach ($Rs as $d) {
                            $sn = $d['sn'];
                            $t_cnt = $d['gd_cnt'];
                            $weight = $d['w_value'];
                            $od_code = $d['fk_odcode'];
                            $gd_code = $d['gd_code'];
                            $od_wcode = $d['od_wcode'];
                            $od_wname = $d['od_wname'];

                            $tarr = array(
                                'w_code' => $od_wcode,
                                'p_type' => 0
                            );
                            $Rs2 = $order_m->Load_Package_Goods_Active($tarr);
                            if ($util->fnArrayCnt($Rs2) <= 0) {
                                $fk_pcode = $util->fnMake_Code(6);
                                $marr = array(
                                    'pcode' => $fk_pcode,
                                    'mi_code' => $mi_code,
                                    'w_code' => $od_wcode,
                                    'w_name' => $od_wname
                                );
                                $Cnt = $order_m->Insert_Package($marr);
                            } else {
                                $fk_pcode = $Rs2[0]['pcode'];
                            }

                            $sarr = array(
                                'pa_code' => $util->fnMake_Code(5),
                                'fk_pcode' => $fk_pcode,
                                'fk_odcode' => $od_code,
                                'fk_gdcode' => $gd_code,
                                't_cnt' => $t_cnt,
                                't_weight' => ($t_cnt * $weight),
                                'delidate' => $util->fnAddDay(2, 3)
                            );
                            $Cnt = $order_m->Insert_Package_Goods($sarr);

                            $p_arr = array(
                                'pcode' => $fk_pcode,
                                'cnt' => $t_cnt,
                                'weight' => ($t_cnt * $weight)
                            );
                            $eCnt = $order_m->Update_Package_Info($fk_pcode, $p_arr);
                            $oCnt = $order_m->Update_Order_Goods_Sn($sn, READY_TO_SHIP);
                        }

                        $result = 'ok';
                        $message = 'success';
                    }
                }
            }
        }

        $return = array(
            'result' => $result,
            'message' => $message
        );
        return $this->respond($return);
    }

    public function Load_Order_Pharm()
    {
        $util = new Utils();
        $sessinarr = $util->fnGetSessionData();
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $info = '';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_code = $sessinarr['user']['mi_code'];
            $mi_type = $sessinarr['user']['mi_type'];
            if ($mi_type != 'pharm') {
                $result = 'type111';
                $info = '';
                $message = '권한이외의 접근입니다.';
            } else {

                $request = service('request');
                $page = ($request->getPost('page') == '') ? 1 : $request->getPost('page');
                $step = ($request->getPost('step') == '') ? 2 : $request->getPost('step');
                $limit = 50;

                $offset = $limit * ($page - 1);
                $param = array(
                    'step' => $step,
                    'micode' => $mi_code,
                    'offset' => $offset,
                    'limit' => $limit
                );

                $order_m = model('Order_m');
                $herb_m =  model('Herb_m');
                $Rs = $order_m->Load_Order_Goods_Pharm_Page($param);
                if ($util->fnArrayCnt($Rs) <= 0) {
                    $result = 'last';
                    $info = '';
                    $message = '주문정보 없습니다.';
                } else {
                    $data = array();
                    foreach ($Rs as $f) {

                        $fRs = $herb_m->Load_Product_File_Code($f['fk_hncode']);
                        if($util->fnArrayCnt($fRs)>0){
                            foreach ($fRs as $c){
                                if($c['typ']==1){
                                    $fname['img'] = $c['fname'];
                                }else if($c['typ']==2){
                                    $fname['data'] = $c['fname'];
                                }
                            }
                        }


                        $t_data = array(
                            'sn' => $f['sn'],
                            'gd_code' => $f['gd_code'],
                            'od_code' => $f['fk_odcode'],
                            'hncode' => $f['fk_hncode'],
                            'gd_price' => $f['gd_price'],
                            'gd_pType' => $f['gd_pType'],
                            'gd_cnt' => $f['gd_cnt'],
                            'gd_status' => $f['gd_status'],
                            'gd_rPrice' => $f['gd_rPrice'],
                            'hn_name' => $f['hn_name'],
                            'mi_name' => $f['mi_name'],
                            'n_key' => $f['n_key'],
                            'n_value' => $f['n_value'],
                            't1code' => $f['fk_t1code'],
                            't1_value' => $f['t1_value'],
                            't2code' => $f['fk_t2code'],
                            't2_value' => $f['t2_value'],
                            'w_name' => $f['w_name'],
                            'w_value' => $f['w_value'],
                            'fname' => $fname,
                            'od_wname' => $f['od_wname'],
                            'oddate' => $util->fnShort_Date($f['od_regdate'])
                        );
                        array_push($data, $t_data);
                    }

                    $i_arr = array(
                        'page' => ($page + 1),
                        'list' => $data
                    );

                    $result = 'ok';
                    $info = $i_arr;
                    $message = 'success';
                }
            }
        }
        $return = array(
            'result' => $result,
            'info' => $info,
            'message' => $message
        );
        return $this->respond($return);
    }


