<?php

namespace App\Controllers;


use App\Libraries\Utils;
use CodeIgniter\API\ResponseTrait;


class ApiController extends BaseController
{
    use ResponseTrait;

    
    public function Order_Step_Do(){
        $util = new Utils();
        $request = service('request');
        $o_data = (!$request->getPost('data')) ? [] : $request->getPost('data');
        $o_step = ($request->getPost('ostep') == '') ? '' : $request->getPost('ostep');
        $n_step = ($request->getPost('nstep') == '') ? '' : $request->getPost('nstep');
        $oCnt = $util->fnArrayCnt($o_data);
        if(($oCnt<=0) || ($o_step=='')|| ($n_step=='')){
            $result = 'type101';
            $info = '';
            $message = '선택하신 약재 정보를 확인하여주세요.';
        }else{
            $sessinarr = $util->fnGetSessionData();
            if (!$sessinarr['islogin']) {
                $result = 'NoLogin';
                $info = '';
                $message = '로그인을 하셔야 합니다.';
            } else {
                $mi_code = $sessinarr['user']['mi_code'];

                $t_arr = array_column($o_data, 'sn');
                $order_str = implode(",", $t_arr);
                if ($order_str == '') {
                    $result = 'type102';
                    $info = '';
                    $message = '잘못된 접근입니다.';
                } else {
                    $herb_m = model('Herb_m');
                    $Cnt = $herb_m->Cnt_Order_Step_Check($order_str,$o_step,$mi_code);
                    if($Cnt>0){
                        $result = 'type103';
                        $info = '';
                        $message = "주문상태가 잘못된 주문이 존재합니다\n 선택된 주문 확인하여주세요.";
                    }else{
                        $order_m = model('Order_m');
                        if($n_step==ORDER_SHIPMENT_VAL){
                            $Rs = $order_m->Load_Order_Goods_IN($t_arr);
                            if ($util->fnArrayCnt($Rs) <= 0) {
                                $result = 'type113';
                                $message = '출하 항목 정보 확인에 실패하였습니다.';
                            } else {
                                $u_Cnt = 0;
                                $u_weight = 0;
                                foreach ($Rs as $d) {
                                    $sn = $d['sn'];
                                    $t_cnt = $d['gd_cnt'];
                                    $weight = $d['w_value'];
                                    $od_code = $d['fk_odcode'];
                                    $gd_code = $d['gd_code'];
                                    $od_wcode = $d['od_wcode'];
                                    $od_wname = $d['od_wname'];

                                    $tarr = array(
                                        'w_code' => $od_wcode,
                                        'p_type' => 0
                                    );
                                    $Rs2 = $order_m->Load_Package_Goods_Active($tarr);
                                    if ($util->fnArrayCnt($Rs2) <= 0) {
                                        $fk_pcode = $util->fnMake_Code(6);
                                        $marr = array(
                                            'pcode' => $fk_pcode,
                                            'mi_code' => $mi_code,
                                            'w_code' => $od_wcode,
                                            'w_name' => $od_wname
                                        );
                                        $Cnt = $order_m->Insert_Package($marr);
                                    } else {
                                        $fk_pcode = $Rs2[0]['pcode'];
                                    }

                                    $sarr = array(
                                        'pa_code' => $util->fnMake_Code(5),
                                        'fk_pcode' => $fk_pcode,
                                        'fk_odcode' => $od_code,
                                        'fk_gdcode' => $gd_code,
                                        't_cnt' => $t_cnt,
                                        't_weight' => ($t_cnt * $weight),
                                        'delidate' => $util->fnAddDay(2, 3)
                                    );
                                    $Cnt = $order_m->Insert_Package_Goods($sarr);

                                    $p_arr = array(
                                        'pcode' => $fk_pcode,
                                        'cnt' => $t_cnt,
                                        'weight' => ($t_cnt * $weight)
                                    );
                                    $eCnt = $order_m->Update_Package_Info($fk_pcode, $p_arr);
                                }
                            }
                        }

                        $rCnt = $herb_m->Update_Order_Step($t_arr, $n_step);
                        $i_arr = array(
                            'eCnt' => $rCnt,
                            'list' => $t_arr
                        );

                        $typ = 'Order_Step';
                        $Log = 'Order_Step:'.$util->fn_OrderStepName($n_step).'|ostep:' . $o_step . '|nstep:' .$n_step . '|data:'.$order_str;
                        $util->fnLog_Reg($mi_code, $typ, $Log);

                        $result = 'ok';
                        $info = $i_arr;
                        $message = '';
                    }

                }
            }
        }

        $return = array(
            'result' => $result,
            'info' => $info,
            'message' => $message
        );
        return $this->respond($return);
    }
    
    
    public function Insert_Cart()
    {
        $request = service('request');
        $str = ($request->getPost('str') == '') ? '' : $request->getPost('str');
        if ($str == '') {
            $result = 'type101';
            $info = '';
            $message = '선택하신 약재 정보를 확인하여주세요.';
        } else {
            $util = new Utils();
            $str = '[' . $str . ']';
            $cart = json_decode($str, true);
            if (($cart == '') && ($util->fnArrayCnt($cart) <= 0)) {
                $result = 'type102';
                $info = '';
                $message = '구매약재 정보를 확인하여주세요.';
            } else {
                $sessinarr = $util->fnGetSessionData();
                if (!$sessinarr['islogin']) {
                    $result = 'NoLogin';
                    $info = '';
                    $message = '로그인을 하셔야 합니다.';
                } else {
                    $total = 0;
                    $mi_code = $sessinarr['user']['mi_code'];

                    $member_m = model('Member_m');
                    $minfo = $member_m->Load_Company_micode($mi_code);
                    $cfCode = ($util->fnArrayCnt($minfo) > 0) ? $minfo[0]['mi_cfcode'] : '';

                    $herb_m = model('Herb_m');
                    $arr = array();
                    foreach ($cart as $d) {
                        $t_arr = array();
                        $pRs = $herb_m->Load_Product_Code($d['code']);
                        if($util->fnArrayCnt($pRs)>0){
                            $p_arr = $util->fnLoadPrice($pRs[0]['hn_code']);

                            if($d['ptyp']==1){
                                $gd_pType = 1;
                                $gd_price = $p_arr[0]['hn_pPrice'];
                                $gd_period = 0;
                            }else{
                                $gd_pType = 2;
                                $gd_price = $p_arr[1]['hn_pPrice'];
                                $gd_period = $p_arr[1]['hn_period'];
                            }

                            $total = $gd_price*$d['cnt'];


                            $t_arr = array(
                                'fk_cfcode' => $cfCode,
                                'fk_micode' => $pRs[0]['fk_micode'],
                                'fk_hncode' => $pRs[0]['hn_code'],
                                'ct_pType' => $gd_pType,
                                'ct_cnt' => $d['cnt'],
                                'ct_gPrice' => $gd_price,
                                'ct_tPrice' => $total,
                                'ct_period' => $gd_period
                            );

                            array_push($arr, $t_arr);
                        }
                    }

                    if (empty($arr)) {
                        $result = 'type104';
                        $info = '';
                        $message = '구매약재 정보를 확인하여주세요.';
                    } else {
                        $Cnt = $herb_m->Insert_Cart($arr);

                        $i_arr = array(
                            'Cnt' => $util->fnArrayCnt($cart)
                        );

                        $result = 'ok';
                        $info = $i_arr;
                        $message = 'success';
                    }
                }
            }
        }

        $return = array(
            'result' => $result,
            'info' => $info,
            'message' => $message
        );
        return $this->respond($return);

    }


    public function Del_Match_Data()
    {
        $util = new Utils();
        $sessinarr = $util->fnGetSessionData();
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $data = '';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            if ($mi_type != 'master') {
                $result = 'type111';
                $data = '';
                $message = '권한이외의 접근입니다.';
            } else {
                $request = service('request');
                $sn_arr = ($request->getPost('data1') == '') ? array() : $request->getPost('data1');
                $cfcode = ($request->getPost('cfcode') == '') ? '' : $request->getPost('cfcode');
                $mdMedi = ($request->getPost('mdMedi') == '') ? '' : $request->getPost('mdMedi');
                $mm_medicine  = ($request->getPost('mmMedi') == '') ? '' : $request->getPost('mmMedi');

                if(($util->fnArrayCnt($sn_arr)<=0) || ($mdMedi=='') || ($cfcode=='')){
                    $result = 'type113';
                    $data = '';
                    $message = '잘못된 접근입니다.';
                }else{
                    $herb_m = model('Herb_m');
                    $Cnt = $herb_m->Delete_Product_Matches($cfcode,$mdMedi,$sn_arr);

                    $MCnt =  $herb_m->Cnt_Product_Match($mdMedi,$cfcode,$mm_medicine);

                    $i_arr = array(
                        'Match' =>  $MCnt
                    );

                    $result = 'ok';
                    $data = $i_arr;
                    $message = '';
                }
            }
        }

        $return = array(
            'result' => $result,
            'info' => $data,
            'message' => $message
        );
        return $this->respond($return);
    }

    public function Insert_Match_Data(){
        $util = new Utils();
        $sessinarr = $util->fnGetSessionData();
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $data = '';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            if ($mi_type != 'master') {
                $result = 'type111';
                $data = '';
                $message = '권한이외의 접근입니다.';
            } else {
                $request = service('request');
                $d_arr = ($request->getPost('data1') == '') ? array() : $request->getPost('data1');
                $cfcode = ($request->getPost('cfcode') == '') ? '' : $request->getPost('cfcode');
                $mdMedi = ($request->getPost('mdMedi') == '') ? '' : $request->getPost('mdMedi');
                $mm_medicine = ($request->getPost('mm_medicine') == '') ? '' : $request->getPost('mm_medicine');
                $mm_origin = ($request->getPost('mm_origin') == '') ? '' : $request->getPost('mm_origin');
                $md_title_kor = ($request->getPost('md_title_kor') == '') ? '' : $request->getPost('md_title_kor');
                $md_maker = ($request->getPost('md_maker') == '') ? '' : $request->getPost('md_maker');
                $mm_stock = ($request->getPost('mm_stock') == '') ? '' : $request->getPost('mm_stock');
                if(($util->fnArrayCnt($d_arr)<=0) || ($mdMedi=='') || ($cfcode=='') || ($mm_medicine=='') || ($mm_origin=='') || ($md_title_kor=='') || ($md_maker=='')){
                    $result = 'type113';
                    $data = '';
                    $message = '잘못된 접근입니다.';
                }else{
                    $herb_m = model('Herb_m');
                    $param = array();
                    $hncode = '';
                    $Cnt = $util->fnArrayCnt($d_arr);
                    for($i=0;$i<=($Cnt-1);$i++){
                        $hncode = $d_arr[$i];
                        $t_arr = array();
                        $cRs = $herb_m->Load_Product_Code($hncode);
                        if($util->fnArrayCnt($cRs)>0){
                            $t_arr['fk_hncode'] = $hncode;
                            $t_arr['fk_cfcode'] = $cfcode;
                            $t_arr['fk_micode'] = $cRs[0]['fk_micode'];
                            $t_arr['fk_mdMedi'] = $mdMedi;
                            $t_arr['fk_mdcode'] = $cRs[0]['fk_mdcode'];
                            $t_arr['mm_medicine'] = $mm_medicine;
                            $t_arr['mm_origin'] = $mm_origin;
                            $t_arr['md_title_kor'] = $md_title_kor;
                            $t_arr['md_maker'] = $md_maker;
                            $t_arr['mm_stock'] = $mm_stock;

                            array_push($param,$t_arr);
                        }
                    }

                    if($util->fnArrayCnt($param)>0){
                        $eCnt = $herb_m->Insert_Product_Matches($param);

                    }

                    $MCnt =  $herb_m->Cnt_Product_Match($mdMedi,$cfcode,$mm_medicine);

                    $i_arr = array(
                        'Match' =>  $MCnt
                    );

                    $result = 'ok';
                    $data = $i_arr;
                    $message = '';
                }
            }
        }

        $return = array(
            'result' => $result,
            'info' => $data,
            'message' => $message
        );
        return $this->respond($return);

    }


    public function Load_Decoc_Herb_List(){
        $util = new Utils();
        $sessinarr = $util->fnGetSessionData();
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $data = '';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            if ($mi_type != 'master') {
                $result = 'type111';
                $data = '';
                $message = '권한이외의 접근입니다.';
            }else{
                $psize = 300;
                $request = service('request');
                $page = ($request->getPost('page') == '') ? '' : $request->getPost('page');
                $cfcode = ($request->getPost('cf') == '') ? '' : $request->getPost('cf');
                $hnname = ($request->getPost('hn') == '') ? '' : $request->getPost('hn');

                if ($cfcode == '') {
                    $result = 'type101';
                    $data = '';
                    $message = '잘못된 접근입니다.';
                } else {
                    $apiUrl = "https://api.djmedi.net/manager/medicine/?apiCode=medicineclientlist&language=kor&ckCfcode={$cfcode}&ckStaffid=afsafd&v=1747622142118&page={$page}&psize={$psize}&searchTxt={$hnname}&searchStatus=undefined&searchmedicinetype=undefined&reData=smartorder";
                    $retVal = $this->fnCallPost($apiUrl, 'get');
                    if (empty($retVal)) {
                        $result = 'type102';
                        $data = '';
                        $message = '통신장애로 데이터로드에 실패하였습니다. .\n다시 시도 하여주세요.(101)';
                    } else {
                        $d_arr = array();
                        $herb_m = model('Herb_m');
                        foreach($retVal['list'] as $d){
                            $t_arr = array();

                            $t_arr['mm_seq'] = $d['mm_seq'];
                            $t_arr['mdMedi'] = $d['mdMedi'];
                            $t_arr['mdMediName'] = $d['mdMediName'];
                            $t_arr['mm_medicine'] = $d['mm_medicine'];
                            $t_arr['md_title_kor'] = $d['md_title_kor'];
                            $t_arr['md_maker'] = $d['md_maker'];
                            $t_arr['mdMedi'] = $d['mdMedi'];
                            $t_arr['mm_origin'] = $d['mm_origin'];
                            $t_arr['md_maker'] = $d['md_maker'];
                            $t_arr['m_cnt'] = $herb_m->Cnt_Product_Match($d['mdMedi'],$cfcode,$d['mm_medicine']);

                            array_push($d_arr,$t_arr);
                        }

                        $i_arr = array(
                            'list' =>  $d_arr
                        );

                        $result = 'ok';
                        $data = $i_arr;
                        $message = '';
                    }
                }
            }
        }

        $return = array(
            'result' => $result,
            'info' => $data,
            'message' => $message
        );
        return $this->respond($return);
    }

    public function Load_Decoc_Match_Info(){
        $util = new Utils();
        $sessinarr = $util->fnGetSessionData();
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $data = '';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            if ($mi_type != 'master') {
                $result = 'type111';
                $data = '';
                $message = '권한이외의 접근입니다.';
            }else{
                $request = service('request');
                $cfcode = ($request->getPost('cf') == '') ? '' : $request->getPost('cf');
                $mdMedi = ($request->getPost('mdMedi') == '') ? '' : $request->getPost('mdMedi');
                $mm_medicine = ($request->getPost('mmcode') == '') ? '' : $request->getPost('mmcode');
                if (($cfcode == '')&&($mdMedi=='')&&($mm_medicine=='')) {
                    $result = 'type101';
                    $data = '';
                    $message = '잘못된 접근입니다.';
                } else {
                    $d_arr = array();
                    $h_arr = array();
                    $not_in = array();
                    $herb_m = model('Herb_m');
                    $fields = ['a.sn','b.hn_code','b.mi_name','b.hn_name','b.n_value','b.w_name','b.t1_value','b.t2_value'];
                    $dRs = $herb_m->Load_Product_Match1($mm_medicine,$cfcode,$fields);
                    if($util->fnArrayCnt($dRs) > 0){

                        foreach($dRs as $d){
                            $t_arr = array();
                            $t_arr['sn'] = $d['sn'];
                            $t_arr['hn_code'] = $d['hn_code'];
                            $t_arr['mi_name'] = $d['mi_name'];
                            $t_arr['hn_name'] = $d['hn_name'];
                            $t_arr['n_value'] = $d['n_value'];
                            $t_arr['w_name'] = $d['w_name'];
                            $t_arr['t1_value'] = $d['t1_value'];
                            $t_arr['t2_value'] = $d['t2_value'];

                            $not_in[] = $d['hn_code'];

                            array_push($d_arr,$t_arr);
                        }
                    }

                    $hRs = $herb_m->Load_Product_mdMedi2($mdMedi,$not_in);
                    if($util->fnArrayCnt($hRs) > 0){
                        foreach($hRs as $c){
                            $c_arr = array();
                            $c_arr['sn'] = $c['sn'];
                            $c_arr['hn_code'] = $c['hn_code'];
                            $c_arr['hn_name'] = $c['hn_name'];
                            $c_arr['fk_micode'] = $c['fk_micode'];
                            $c_arr['fk_medicode'] = $c['fk_medicode'];
                            $c_arr['fk_mdcode'] = $c['fk_mdcode'];
                            $c_arr['n_value'] = $c['n_value'];
                            $c_arr['mi_name'] = $c['mi_name'];
                            $c_arr['w_name'] = $c['w_name'];
                            $c_arr['t1_value'] = $c['t1_value'];
                            $c_arr['t2_value'] = $c['t2_value'];

                            array_push($h_arr,$c_arr);
                        }
                    }

                    $i_arr = array(
                        'list1' =>  $d_arr,
                        'list2' =>  $h_arr
                    );

                    $result = 'ok';
                    $data = $i_arr;
                    $message = '';
                }
            }
        }

        $return = array(
            'result' => $result,
            'info' => $data,
            'message' => $message
        );
        return $this->respond($return);
    }



    public function Update_Deli_Data(){
        $util = new Utils();
        $sessinarr = $util->fnGetSessionData();
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            $mi_code = $sessinarr['user']['mi_code'];
            if ($mi_type != 'pharm') {
                $result = 'type111';
                $message = '권한이외의 접근입니다.';
            } else {
                $request = service('request');
                $pcode = ($request->getPost('pcode') == '') ? '' : $request->getPost('pcode');
                if ($pcode == '') {
                    $result = 'type112';
                    $message = '출하 정보를 확인하세요.';
                } else {
                    $order_m = model('Order_m');
                    $Rs = $order_m->Load_Order_Package_List($pcode);
                    if ($util->fnArrayCnt($Rs) <= 0) {
                        $result = 'type113';
                        $message = '해당 출고코드에 등록되어 있는 약재가 없습니다.';
                    } else {
                        $t_arr = [];
                        foreach ($Rs as $d) {
                            $t_arr[] = $d['oSN'];
                        }
                        $herb_m = model('Herb_m');
                        $rCnt = $herb_m->Update_Order_Step($t_arr, ORDER_SHIP_COMPLETE_VAL);

                        $param = array(
                            'p_type' => PACKAGE_SHIP_START_VAL
                        );
                        $Cnt = $order_m->Update_Deli_info($pcode, $param);

                        $result = 'ok';
                        $message = '';
                    }
                }
            }
        }
        $return = array(
            'result' => $result,
            'message' => $message
        );
        return $this->respond($return);
    }

    public function Load_Board_List()
    {
        $util = new Utils;
        $sessinarr = $util->fnGetSessionData();
        if (!$sessinarr['islogin']) {
            $data = '';
            $result = 'NoLogin';
            $message = 'NOT LOGIN';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            $request = service('request');

            $bid = ($request->getPost('bid') == '') ? '1' : ($request->getPost('bid'));
            $page = ($request->getPost('page') == '') ? '1' : ($request->getPost('page'));
            $limit = 15;
            $offset = $limit * ($page - 1);


            $mi_code = $sessinarr['user']['mi_code'];
            $param = array(
                'bid' => $bid,
                'limit' => $limit,
                'offset' => $offset
            );

            $board_m = model('Board_m');
            $dataarr = array();
            $contents_data = $board_m->Load_Board_Page($param);

            if($util->fnArrayCnt($contents_data) <= 0) {
                $result = 'null';
                $info = '';
                $message = '게시글이 없습니다.';

            } else {
                foreach ($contents_data as $d){
                    $temparr = array();

                    $temparr['bcode']       = $d['bcode'];
                    $temparr['bid']         = $d['bid'];
                    $temparr['bTitle']      = $d['bTitle'];
                    $temparr['writer']      = $d['writer'];
                    $temparr['uid']         = $d['uid'];
                    $temparr['userid']         = $d['userid'];
                    $temparr['mitype']         = $mi_type;

                    $btyp_str = '';
                    if ($d['bid'] == 1) {
                        if ($d['btyp'] == 1) {
                            $btyp_str = '일반';
                        } else if ($d['btyp'] == 2) {
                            $btyp_str = '공지';
                        } else if ($d['btyp'] == 3) {
                            $btyp_str = '서버관련';
                        } else if ($d['btyp'] == 4) {
                            $btyp_str = '기타';
                        }
                    } else if ($d['bid'] == 2) {
                        if ($d['btyp'] == 1) {
                            $btyp_str = '시스템오류';
                        } else if ($d['btyp'] == 2) {
                            $btyp_str = '주문/배송';
                        } else if ($d['btyp'] == 3) {
                            $btyp_str = '취소/교환/반품';
                        } else if ($d['btyp'] == 4) {
                            $btyp_str = '기타';
                        }
                    } else if ($d['bid'] == 3) {
                        if ($d['btyp'] == 1) {
                            $btyp_str = '시스템오류';
                        } else if ($d['btyp'] == 2) {
                            $btyp_str = '주문/배송';
                        } else if ($d['btyp'] == 3) {
                            $btyp_str = '취소/교환/반품';
                        } else if ($d['btyp'] == 4) {
                            $btyp_str = '기타';
                        }
                    } else {
                        $btyp_str = '기타';
                    }

                    $temparr['btyp']         = $btyp_str;

                    $temparr['bHit']        = $d['bHit'];
                    $temparr['brecom']      = $d['brecom'];
                    $temparr['bReply']      = $d['bReply'];
                    $temparr['depth']       = $d['depth'];
                    $temparr['bContent']    = $d['bContent'];

                    $temparr['isAgree']     = $d['isAgree'];
                    $temparr['isFix']       = $d['isFix'];
                    $temparr['isDel']       = $d['isDel'];
                    $temparr['regidate']    = $d['regidate'];
                    $temparr['update_date'] = $d['update_date'];

                    $att = $board_m->Load_Board_Attachment($d['bcode']); //파일정보 읽어오기 //path / fname 파일경로 만들고
                    $fileInfo = (is_array($att) && count($att) > 0) ? $att[0] : null;

                    if ($fileInfo) {
                        $filePath = $fileInfo['path'] . '/' . $fileInfo['fname'];
                    } else {
                        $filePath = '';
                    }

                    $temparr['filePath'] = $filePath;

                    $bcode = $d['bcode'];
                    $reply = $board_m->Load_Board_RContent($bcode);

                    $reparr = array();
                    if ($util->fnArrayCnt($reply) > 0) {
                        foreach ($reply as $f) {
                            $t_arr = array();
                            $t_arr['fk_bcode'] = $f['fk_bcode'];
                            $t_arr['rContent'] = $f['rContent'];
                            $t_arr['regidate'] = $f['regidate'];
                           array_push($reparr,$t_arr);
                        }
                    }
                    $temparr['reply'] = $reparr;

                    array_push($dataarr, $temparr);
                }
            }

            $info = array(
                'page' => ($page + 1),
                'limit' => $limit,
                'offset' => $offset,
                'list' => $dataarr,
            );

            $result = 'ok';
            $data = $info;
            $message = 'success';
        }

        $return = array(
            'result' => $result,
            'info' => $data,
            'message' => $message
        );
        return $this->respond($return);

    }


    public function Insert_Package_Deli_Data()
    {
        $util = new Utils();
        $sessinarr = $util->fnGetSessionData();
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            $mi_code = $sessinarr['user']['mi_code'];
            if ($mi_type != 'pharm') {
                $result = 'type111';
                $message = '권한이외의 접근입니다.';
            } else {
                $request = service('request');
                $deltype = ($request->getPost('deltype') == '') ? '' : $request->getPost('deltype');
                $delcode = ($request->getPost('delcode') == '') ? '' : $request->getPost('delcode');
                $pcode = ($request->getPost('pcode') == '') ? '' : $request->getPost('pcode');
                if (($deltype == '') || ($delcode == '') || ($pcode == '')) {
                    $result = 'type112';
                    $message = '출하 정보를 확인하세요.';
                } else {
                    $order_m = model('Order_m');
                    $Rs = $order_m->Load_Order_Package_List($pcode);
                    if ($util->fnArrayCnt($Rs) <= 0) {
                        $result = 'type113';
                        $message = '존재하지 않는 출고 내역입니다.';
                    } else {
                        $Log = '';
                        $t_arr = [];
                        foreach ($Rs as $d) {
                            $sn = $d['sn'];
                            $t_arr[] = $d['oSN'];
                            $Log .= $sn . '|' . $d['pa_code'] . '/';
                        }
                        $herb_m = model('Herb_m');
                        $rCnt = $herb_m->Update_Order_Step($t_arr, ORDER_DELIVERY_VAL);
                        $typ = ORDER_SHIP_COMPLETE;
                        $util->fnLog_Reg($mi_code, $typ, $Log);

                        $param = array(
                            'delitype' => $deltype,
                            'delicode' => $delcode,
                            'p_type' => PACKAGE_SHIP_END_VAL
                        );

                        $Cnt = $order_m->Update_Deli_info($pcode, $param);

                        $result = 'ok';
                        $message = '';
                    }
                }
            }
        }
        $return = array(
            'result' => $result,
            'message' => $message
        );
        return $this->respond($return);
    }


