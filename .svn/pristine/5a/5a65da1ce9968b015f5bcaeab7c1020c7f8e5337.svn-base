                            }

                            $t_data = array(
                                'gd_code' => $f['gd_code'],
                                'hncode' => $f['fk_hncode'],
                                'gd_pType' => $f['gd_pType'],
                                'gd_price' => $f['gd_price'],
                                'gd_cnt' => $f['gd_cnt'],
                                'gd_rPrice' => $f['gd_rPrice'],
                                'gd_period' => $f['gd_period'],
                                'gd_status' => $f['gd_status'],
                                'hn_name' => $f['hn_name'],
                                'fk_mdname' => $f['fk_mdname'],
                                'mi_name' => $f['mi_name'],
                                'n_key' => $f['n_key'],
                                'n_value' => $f['n_value'],
                                't1code' => $f['fk_t1code'],
                                't1_value' => $f['t1_value'],
                                't2code' => $f['fk_t2code'],
                                't2_value' => $f['t2_value'],
                                'w_name' => $f['w_name'],
                                'w_value' => $f['w_value'],
                                'hn_method' => $f['gd_pType'],
                                'hn_method_str' => $hn_str,
                                'gd_status' => $f['gd_status'],
                                'fname' => $fname
                            );
                            array_push($m_data, $t_data);
                        }
                        $c_data = array(
                            'od_code' => $d['od_code'],
                            'mi_code' => $d['od_micode'],
                            'mi_name' => $d['mi_name'],
                            'mi_email' => $d['mi_busiemail'],
                            'mi_address' => $d['mi_busiaddr'],
                            'od_price' => $d['od_price'],
                            'regidate' => $util->fnShort_Date($d['od_regdate']),
                            'goods' => $m_data
                        );
                        array_push($data, $c_data);
                    }

                    $i_arr = array(
                        'list' => $data
                    );


                    $result = 'ok';
                    $info = $i_arr;
                    $message = 'success';
                }
            }
        }
        $return = array(
            'result' => $result,
            'info' => $info,
            'message' => $message
        );
        return $this->respond($return);
    }

    public function Load_DelInfo()
    {
        $util = new Utils();
        $sessinarr = $util->fnGetSessionData();
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $info = '';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            $mi_code = $sessinarr['user']['mi_code'];
            if ($mi_type != 'decoc') {
                $result = 'type111';
                $info = '';
                $message = '권한이외의 접근입니다.';
            } else {
                $herb_m = model('Herb_m');
                $Rs = $herb_m->Load_DelInfo(['fk_micode' => $mi_code]);
//                log_message('error', 'param: ' . print_r($param, true));
                if ($util->fnArrayCnt($Rs) <= 0) {
                    $result = 'type101';
                    $info = '';
                    $message = '탕전실 정보가 없습니다.';
                } else {

                    $data = array();
                    foreach ($Rs as $d) {
                        $add_data = array(
                            'sn' => $d['sn'],
                            'fk_micode' => $d['fk_micode'],
                            'mi_zip' => $d['mi_zip'],
                            'mi_address1' => $d['mi_address1'],
                            'mi_address2' => $d['mi_address2'],
                            'mi_name' => $d['mi_name'],
                            'mi_tel' => $d['mi_tel'],
                            'isDefault' => $d['isDefault'],
//                                'hn_method_str' => $hn_str,
//                                'gd_status' => $f['gd_status'],
//                                'fname' => $fname
                        );
                        array_push($data, $add_data);
                    }

                    $db_micode = $d['fk_micode'];
                    if ($mi_code != $db_micode) {
                        $result = 'type200';
                        $message = 'micode is not mached. ';

                    }  else {
                        $result = 'ok';
                        $info = $data;
                        $message = 'success';

                    }
                }
            }
        }
        $return = array(
            'result' => $result,
            'info' => $info,
            'message' => $message
        );
        return $this->respond($return);
    }

    public function Insert_DeliInfo()
    {
        $util = new Utils();
        $sessinarr = $util->fnGetSessionData();

        // 1. 로그인 체크
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            $mi_code = $sessinarr['user']['mi_code'];

            // 2. 권한 체크 (마스터만 통과)
            if ($mi_type != 'decoc') {
                $result = 'type101';
                $message = '권한이외의 접근입니다.';
            } else {
                $request = service('request');
                foreach ($request->getPost() as $key => $value) {
                    $post[$key] = $value;
                }
                if (empty($post)) {
                    $result = 'type102';
                    $message = '잘못된 접근입니다.';
                } else {
                    $pcode = $post['zonecode'];
                    $Add1 = $post['Add1'];
                    $Add2 = $post['Add2'];
                    $miname = $post['miname'];
                    $ctc = $post['ctc'];
                    $isDefault = $post['isDefault'];

                    $herb_m = model('Herb_m');
                    $Rs = $herb_m->Load_DelInfo(['fk_micode' => $mi_code]);

                    $db_micode = '';
                    if (!empty($Rs)) {
                        $db_micode = $Rs[0]['fk_micode'];
                    }
                    if ($db_micode != $mi_code) {
                        $result = 'type108';
                        $message = '변경 권한이 없습니다.';
                    } else {
                        if ($util->fnArrayCnt($Rs) <= 0) {
                            $result = 'type102';
                            $message = '해당 제약사가 존재하지 않습니다.';
                        } else {
                            if ($isDefault == 1) {
                                $isZero = 0;

                                $Cnt = $herb_m->Update_DelInfo_SetAllAsZero($mi_code,$isZero);
                                if ($Cnt <= 0) {
                                    $result = 'type103';
                                    $message = '기본 배송지 저장에 실패 하였습니다.';
                                    echo ($mi_code);
                                } else {
                                    $param2 = array(
                                        'fk_micode' => $mi_code,
                                        'mi_zip' => $pcode,
                                        'mi_Address1' => $Add1,
                                        'mi_Address2' => $Add2,
                                        'mi_name' => $miname,
                                        'mi_tel' => $ctc,
                                        'isDefault' => 1
                                    );
                                    $Cnt2 = $herb_m->Insert_DelInfo($param2);
                                    if ($Cnt2 <= 0) {
                                        $result = 'type104';
                                        $message = '새로운 주소 등록 실패';
                                    } else {
                                        $result = 'ok';
                                        $message = 'success';

                                    }
                                }
                            } else if ($isDefault == 0){
                                $param3 = array(
                                    'fk_micode' => $mi_code,
                                    'mi_zip' => $pcode,
                                    'mi_Address1' => $Add1,
                                    'mi_Address2' => $Add2,
                                    'mi_name' => $miname,
                                    'mi_tel' => $ctc,
                                    'isDefault' => 0
                                );

                                $Cnt3 = $herb_m->Insert_DelInfo($param3);
                                if ($Cnt3 <= 0) {
                                    $result = 'type105';
                                    $message = '새로운 주소 등록 실패2';
                                } else {
                                    $result = 'ok';
                                    $message = 'success';
                                }
                            } else {
                                $result = 'type106';
                                $message = '새로운 주소 등록 실패3';

                            }
                        }

                    }
                }
            }
        }

        $return = array(
            'result' => $result,
            'message' => $message
        );
        return $this->respond($return);
    }

