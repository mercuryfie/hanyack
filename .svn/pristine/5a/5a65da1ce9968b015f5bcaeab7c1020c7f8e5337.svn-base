    public function Load_herb_Decoc()
    {
        $util = new Utils;
        $sessinarr = $util->fnGetSessionData();
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $info = '';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            $mi_code = $sessinarr['user']['mi_code'];
            // 2. 권한 체크 (마스터만 통과)
            if ($mi_type != 'decoc') {
                $result = 'type101';
                $info = '';
                $message = '권한이외의 접근입니다.';
            } else {
                $request = service('request');
                $page = ($request->getPost('page') == '') ? 1 : $request->getPost('page');
                $maxcnt = ($request->getPost('maxcnt') == '') ? 100 : $request->getPost('maxcnt');


                $member_m = model('Member_m');
                $minfo = $member_m->Load_Company_micode($mi_code);
                $cfCode = ($util->fnArrayCnt($minfo) > 0) ? $minfo[0]['mi_cfcode'] : '';
                //$apiUrl = 'https://api.djmedi.net/manager/medicine/?apiCode=medicineclientlist&language=kor&ckCfcode=' . $cfCode . '&ckStaffid=afsafd&v=1747622142118&page=' . $page . '&searchTxt=&searchStatus=undefined&searchmedicinetype=undefined';
                $apiUrl = 'https://api.djmedi.net/manager/medicine/?apiCode=medicineclientlist&language=kor&ckCfcode=' . $cfCode . '&ckStaffid=afsafd&v=1747622142118&page=' . $page . '&psize=' . $maxcnt . '&searchTxt=&searchStatus=undefined&searchmedicinetype=undefined&reData=smartorder';
                $retVal = $this->fnCallPost($apiUrl, 'get');
                if (empty($retVal)) {
                    $dataarr = array();
                } else {
                    $herb_m = model('Herb_m');
                    $dataarr = array();
                    foreach($retVal['list'] as $d){
                        $temparr = array();

                        $temparr['mdMediName'] = $d['mdMediName'];
                        $temparr['md_maker'] = $d['md_maker'];
                        $temparr['md_code'] = $d['md_code'];
                        $temparr['md_medi'] = $d['md_medi'];
                        $temparr['boxcnt'] = $d['boxcnt'];
                        $temparr['mm_stable'] = $d['mm_stable'];
                        $temparr['md_title_kor'] = $d['md_title_kor'];
                        $temparr['mm_title_kor'] = $d['mm_title_kor'];
                        $temparr['mm_medicine'] = $d['mm_medicine'];
                        $temparr['mm_origin'] = $d['mm_origin'];

                        $info1 = $herb_m->Decoc_Match_Load($mi_code,$d['mm_medicine']);
                        $temparr['match_sn'] = ($util->fnArrayCnt($info1)>0) ? $info1[0]['sn'] : '';

                        array_push($dataarr,$temparr);
                    }
                }

                $info = array(
                    'page' => ($page + 1),
                    'list' => $dataarr
                );

                $result = 'ok';
                $data = $info;
                $message = 'success';
            }
        }
        $return = array(
            'result' => $result,
            'info' => $data,
            'message' => $message
        );
        return $this->respond($return);
    }

    public function Load_Sale_Herb(){
        $util = new Utils;
        $sessinarr = $util->fnGetSessionData();
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $info = '';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_code = $sessinarr['user']['mi_code'];
            $request = service('request');
            $sKey = ($request->getPost('skey') == '') ? '' : $request->getPost('skey');
            $page = ($request->getPost('page') == '') ? 1 : $request->getPost('page');
            $pType = ($request->getPost('ptyp') == '') ? '' : $request->getPost('ptyp');
            $micode = ($request->getPost('pharm') == '') ? '' : $request->getPost('pharm');

            $member_m = model('Member_m');
            $minfo = $member_m->Load_Company_micode($mi_code);
            $cfCode = ($util->fnArrayCnt($minfo) > 0) ? $minfo[0]['mi_cfcode'] : '';

            $limit = 50;
            $offset = ($sKey=='') ? $limit * ($page - 1) : '';
            $herb_m = model('Herb_m');
            $param = array(
                'skey' => $sKey,
                'micode' => $micode,
                'ptyp' => $pType,
                'limit' => $limit,
                'offset' => $offset
            );
            $Rs = $herb_m->Load_Product_Page_Sale($param);
            if ($util->fnArrayCnt($Rs) > 0) {
                $dataarr = array();
                $loadstock = array();
                $i = 0;
                $location = array();
                foreach ($Rs as $d) {
                    $temparr = array();

                    $temparr['sn'] = $d['sn'];
                    $temparr['hn_ID'] = $d['hn_ID'];
                    $temparr['hn_code'] = $d['hn_code'];
                    $temparr['fk_mdcode'] = $d['fk_mdcode'];
                    $temparr['fk_mdname'] = $d['fk_mdname'];
                    $temparr['fk_medicode'] = $d['fk_medicode'];
                    $temparr['fk_micode'] = $d['fk_micode'];
                    $temparr['mi_name'] = $d['mi_name'];
                    $temparr['fk_ncode'] = $d['fk_ncode'];
                    $temparr['n_value'] = $d['n_value'];

                    $temparr['fk_t1code'] = $d['fk_t1code'];
                    $temparr['t1_value'] = ($d['fk_t1code'] == '0') ? '' : $d['t1_value'];
                    $temparr['fk_t2code'] = $d['fk_t2code'];
                    $temparr['t2_value'] = $d['t2_value'];
                    $temparr['fk_wcode'] = $d['fk_wcode'];
                    $temparr['w_value'] = $d['w_value'];
                    $temparr['w_name'] = $d['w_name'];
                    $temparr['hn_name'] = $d['hn_name'];

                    $temparr['hn_sale'] = $d['hn_sale'];
                    $temparr['hn_MakeDate'] = $util->fnShort_Date($d['hn_MakeDate']);
                    $temparr['hn_sellSDate'] = $util->fnShort_Date($d['hn_sellSDate']);
                    $temparr['hn_sellEDate'] = $util->fnShort_Date($d['hn_sellEDate']);
                    $temparr['hn_tax'] = $d['hn_tax'];
                    $temparr['hn_desc'] = $d['hn_desc'];
                    $temparr['hn_isSell'] = $d['hn_isSell'];
                    $temparr['sn'] = $d['sn'];
                    $temparr['hn_isok'] = $d['hn_isok'];
                    $temparr['hn_regdate'] = $d['hn_regdate'];
                    $temparr['fname'] = $d['thumnail'];

                    $temparr['hn_gPrice'] = $d['hn_gPrice'];
                    $temparr['hn_pPrice'] = $d['hn_pPrice'];
                    $temparr['hn_method'] = $d['hn_method'];
                    $temparr['hn_period'] = $d['hn_period'];

                    $cRs = $herb_m->Load_Product_MatchedForPharm($d['hn_code'],$cfCode);
                    if($util->fnArrayCnt($cRs)>0){
                        $temparr['isMatch'] = 1;

                        $temparr['mm_medicine'] = $cRs[0]['mm_medicine'];
                        $temparr['stock'] = '-';
                        $temparr['common_stock'] = '-';
                        $temparr['month_stock'] = '-';
                        $temparr['recommand_stock'] = '-';

                        if (!in_array($cRs[0]['mm_medicine'], $loadstock)) {
                            $loadstock[] = $cRs[0]['mm_medicine'];
                        }

                        $data = array(
                            'code' => $cRs[0]['mm_medicine'],
                            'location' => $i,
                            'r_stock' => $cRs[0]['mm_stock']
                        );
                        array_push($location, $data);

                    } else {
                        $temparr['isMatch'] = 0;
                        $temparr['stock'] = '';
                        $temparr['common_stock'] = '';
                        $temparr['month_stock'] = '';
                        $temparr['recommand_stock'] = '';
                    }
                    array_push($dataarr, $temparr);
                    $i++;
                }

                if ($util->fnArrayCnt($loadstock)>0) {
                    $apiUrl = 'https://api.djmedi.net/manager/medicine/?apiCode=medicinestock&language=kor&ckCfcode=' . $cfCode . '&mmMedicine=' . implode(',',$loadstock);
                    //echo($apiUrl);
                    $retVal = $this->fnCallPost($apiUrl, 'get');
                    if (!empty($retVal)) {
                        foreach ($retVal['list'] as $d) {
                            $key = $d[0];
                            $index = array_search($key, array_column($location, 'code'));
                            $loca = $location[$index]['location'];
                            $r_stock = $location[$index]['r_stock'];

                            $dataarr[$loca]['stock'] = number_format($d[2]);
                            $dataarr[$loca]['common_stock'] = number_format($d[1]);
                            $dataarr[$loca]['month_stock'] = number_format($d[3]);
                            $dataarr[$loca]['recommand_stock'] = number_format($r_stock);

                        }
                    }
                }

                if($sKey!='') {
                    //$n_arr = $util->fn_ArraySorting($dataarr, 'stock', 'desc');
                    $n_arr = $util->fn_ArrayMutiSorting($dataarr,'stock','desc','hn_code','asc');
                }else{
                    $n_arr = $dataarr;
                }


                $info = array(
                    'page' => ($page + 1),
                    'list' => $n_arr,
                    'tCnt' => $herb_m->Cnt_Product_Page_Sale($param)
                );

                $result = 'ok';
                $data = $info;
                $message = 'success';
            } else {
                $info = array(
                    'tCnt' => $herb_m->Cnt_Product_Page_Sale($param)
                );

                $result = 'ok';
                $data = $info;
                $message = 'Empty';
            }
        }

        $return = array(
            'result' => $result,
            'info' => $data,
            'message' => $message
        );
        return $this->respond($return);
    }



    public function Load_SmartOrderHerb()
    {
        $util = new Utils;
        $sessinarr = $util->fnGetSessionData();
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $info = '';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            $mi_code = $sessinarr['user']['mi_code'];
            // 2. 권한 체크 (마스터만 통과)
            if ($mi_type != 'decoc') {
                $result = 'type101';
                $info = '';
                $message = '권한이외의 접근입니다.';
            } else {
                $request = service('request');
                $page = ($request->getPost('page') == '') ? 1 : $request->getPost('page');
                $maxcnt = ($request->getPost('maxcnt') == '') ? 100 : $request->getPost('maxcnt');


                $member_m = model('Member_m');
                $minfo = $member_m->Load_Company_micode($mi_code);
                $cfCode = ($util->fnArrayCnt($minfo) > 0) ? $minfo[0]['mi_cfcode'] : '';
                //$apiUrl = 'https://api.djmedi.net/manager/medicine/?apiCode=medicineclientlist&language=kor&ckCfcode=' . $cfCode . '&ckStaffid=afsafd&v=1747622142118&page=' . $page . '&searchTxt=&searchStatus=undefined&searchmedicinetype=undefined';
                $apiUrl = 'https://api.djmedi.net/manager/medicine/?apiCode=medicineclientlist&language=kor&ckCfcode=' . $cfCode . '&ckStaffid=afsafd&v=1747622142118&page=1&psize=' . $maxcnt . '&searchTxt=&searchStatus=undefined&searchmedicinetype=undefined&reData=smartorder';
                $retVal = $this->fnCallPost($apiUrl, 'get');
                if (empty($retVal)) {
                    $dataarr = array();
                } else {
                    $dataarr = array();
                    $herb_m = model('Herb_m');
                    foreach($retVal['list'] as $d){
                        $temparr = array();

                        $mm_medicine = $d['mm_medicine'];
                        $md_Medi = $d['mdMedi'];
                        $param = array('micode'=>$mi_code,'mdmedi'=>$md_Medi,'mmmedi'=>$mm_medicine);
                        $Rs = $herb_m->Load_Product_Matched($param);
                        if($util->fnArrayCnt($Rs)>0) {









                            array_push($dataarr, $temparr);
                        }
                    }


                }

                $info = array(
                    'page' => ($page + 1),
                    'list' => $dataarr
                );

                $result = 'ok';
                $data = $info;
                $message = 'success';
            }
        }
        $return = array(
            'result' => $result,
            'info' => $data,
            'message' => $message
        );
        return $this->respond($return);
    }

    public function Load_PharmHerbList()
    {
        $util = new Utils;
        $sessinarr = $util->fnGetSessionData();
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $data = '';
            $message = '로그인을 하셔야 합니다.';
        } else {

            $request = service('request');
            $skey = ($request->getPost('skey') == '') ? '' : $request->getPost('skey');
            $page = ($request->getPost('page') == '') ? 1 : $request->getPost('page');
            $limit = 50;

            $mi_code = $sessinarr['user']['mi_code'];

            $offset = $limit * ($page - 1);
            $param = array(
                'micode' => $mi_code,
                'offset' => $offset,
                'limit' => $limit,
                'skey' => $skey
            );

            $herb_m = model('Herb_m');
            $Rs = $herb_m->Load_Product_SellListPage($param);
            $dataarr = array();
            $loadstock = '';
            $location = array();
            if ($util->fnArrayCnt($Rs) > 0) {
                $i = 0;
                foreach ($Rs as $d) {
                    $temparr = array();

                    $temparr['sn'] = $d['sn'];
                    $temparr['hn_ID'] = $d['hn_ID'];
                    $temparr['hn_code'] = $d['hn_code'];
                    $temparr['fk_mdcode'] = $d['fk_mdcode'];
                    $temparr['fk_mdname'] = $d['fk_mdname'];
                    $temparr['fk_medicode'] = $d['fk_medicode'];
                    $temparr['fk_micode'] = $d['fk_micode'];
                    $temparr['mi_name'] = $d['mi_name'];
                    $temparr['fk_ncode'] = $d['fk_ncode'];
                    $temparr['n_value'] = $d['n_value'];
                    $temparr['fk_t1code'] = $d['fk_t1code'];
                    $temparr['t1_value'] = ($d['fk_t1code'] == '0') ? '' : $d['t1_value'];
                    $temparr['fk_t2code'] = $d['fk_t2code'];
                    $temparr['t2_value'] = $d['t2_value'];
                    $temparr['fk_wcode'] = $d['fk_wcode'];
                    $temparr['w_value'] = $d['w_value'];
                    $temparr['w_name'] = $d['w_name'];
                    $temparr['hn_name'] = $d['hn_name'];


                    $pricearr = $util->fnLoadPrice($d['hn_code']);

                    $temparr['hn_gPrice'] = $pricearr[0]['hn_gPrice'];
                    $temparr['hn_pPrice'] = $pricearr[0]['hn_pPrice'];
                    $temparr['hn_method'] = $pricearr[0]['hn_method'];

                    $temparr['hn_sale'] = $d['hn_sale'];
                    $temparr['hn_MakeDate'] = $util->fnShort_Date($d['hn_MakeDate']);
                    $temparr['hn_sellSDate'] = $util->fnShort_Date($d['hn_sellSDate']);
                    $temparr['hn_sellEDate'] = $util->fnShort_Date($d['hn_sellEDate']);
                    $temparr['hn_tax'] = $d['hn_tax'];
                    $temparr['hn_desc'] = $d['hn_desc'];
                    $temparr['hn_isSell'] = $d['hn_isSell'];
                    $temparr['sn'] = $d['sn'];
                    $temparr['hn_isok'] = $d['hn_isok'];


                    $temparr['LowCnt'] = $d['LowCnt'];


                    $temparr['hn_regdate'] = $d['hn_regdate'];

                    $matched = $herb_m->Cnt_Product_MatchedForPharm($d['hn_code']);
                    if ($matched > 0) {
                        $temparr['isMatch'] = 1;

                        $temparr['mm_medicine'] = $d['mm_medicine'];
                        $temparr['mm_title_kor'] = $d['mm_title_kor'];
                        $temparr['stock'] = '-';
                        $temparr['common_stock'] = '-';
                        $temparr['month_stock'] = '-';
                        $temparr['recommand_stock'] = '-';


                        if ($loadstock == '') {
                            $loadstock = $d['mm_medicine'];
                        } else {
                            $loadstock .= ',' . $d['mm_medicine'];
                        }
                        $data = array(
                            'code' => $d['mm_medicine'],
                            'location' => $i,
                            'r_stock' => $d['recommand_stock']
                        );
                        array_push($location, $data);
                    } else {
                        $temparr['isMatch'] = 0;
                        $temparr['stock'] = '';
                        $temparr['common_stock'] = '';
                        $temparr['month_stock'] = '';
                        $temparr['recommand_stock'] = '';
                    }

                    array_push($dataarr, $temparr);
                    $i++;
                }

                if ($loadstock != '') {
                    $member_m = model('Member_m');
                    $minfo = $member_m->Load_Company_micode($mi_code);
                    $cfCode = ($util->fnArrayCnt($minfo) > 0) ? $minfo[0]['mi_cfcode'] : '';
                    $apiUrl = 'https://api.djmedi.net/manager/medicine/?apiCode=medicinestock&language=kor&ckCfcode=' . $cfCode . '&mmMedicine=' . $loadstock;
                    $retVal = $this->fnCallPost($apiUrl, 'get');
                    if (!empty($retVal)) {

                        foreach ($retVal['list'] as $d) {
                            $key = $d[0];
                            $index = array_search($key, array_column($location, 'code'));
                            $loca = $location[$index]['location'];
                            $r_stock = $location[$index]['r_stock'];

                            $dataarr[$loca]['stock'] = number_format($d[2]);
                            $dataarr[$loca]['common_stock'] = number_format($d[1]);
                            $dataarr[$loca]['month_stock'] = number_format($d[3]);
                            $dataarr[$loca]['recommand_stock'] = number_format($r_stock);

                        }
                    }
                }


            } else {
                $result = 'type1';
                $data = '';
                $message = '사용하실수 있는 약재가 없습니다.';
            }

            $info = array(
                'page' => ($page+1),
                'list' => $dataarr
            );


            $result = 'ok';
            $data = $info;
            $message = 'success';
        }

        $return = array(
            'result' => $result,
            'info' => $data,
            'message' => $message
        );
        return $this->respond($return);

    }


    public function Load_herbList()
    {
        $util = new Utils;
        $sessinarr = $util->fnGetSessionData();
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $data = '';
            $message = 'NOT LOGIN';
        } else {
            $request = service('request');
            $skey = ($request->getPost('skey') == '') ? '' : $request->getPost('skey');
            $page = ($request->getPost('page') == '') ? 1 : ($request->getPost('page'));
            $type = ($request->getPost('typ') == '') ? '1' : ($request->getPost('typ'));
            $limit = 100;

            $mi_code = $sessinarr['user']['mi_code'];
            $offset = $limit * ($page - 1);
            $param = array(
                'micode' => $mi_code,
                'offset' => $offset,
                'limit' => $limit,
                'skey' => $skey
            );

            $herb_m = model('Herb_m');
            if ($type == 100) {
                $Rs = $herb_m->Load_Product_Page_All($param);
            } else {
                if ($skey == '') {
                    $Rs = $herb_m->Load_Product_Page($param);
                } else {
                    $Rs = $herb_m->Load_Product_SearchPage($param);
                }
            }
            $dataarr = array();
            if ($util->fnArrayCnt($Rs) > 0) {
                foreach ($Rs as $d) {
                    $temparr = array();

                    $temparr['sn'] = $d['sn'];
                    $temparr['hn_ID'] = $d['hn_ID'];
                    $temparr['hn_code'] = $d['hn_code'];
                    $temparr['fk_mdcode'] = $d['fk_mdcode'];
                    $temparr['fk_mdname'] = $d['fk_mdname'];
                    $temparr['fk_micode'] = $d['fk_micode'];
                    $temparr['mi_name'] = $d['mi_name'];
                    $temparr['fk_ncode'] = $d['fk_ncode'];
                    $temparr['n_value'] = $d['n_value'];

                    $temparr['fk_t1code'] = $d['fk_t1code'];
                    $temparr['t1_value'] = ($d['fk_t1code'] == '0') ? '-' : $d['t1_value'];
                    $temparr['fk_t2code'] = $d['fk_t2code'];
                    $temparr['t2_value'] = $d['t2_value'];
                    $temparr['fk_wcode'] = $d['fk_wcode'];
                    $temparr['w_value'] = $d['w_value'];
                    $temparr['w_name'] = $d['w_name'];
                    $temparr['hn_name'] = $d['hn_name'];
                    $temparr['hn_number'] = $d['hn_number'];
                    $temparr['hn_bigsell'] = $d['hn_bigsell'];
                    $temparr['hn_sale'] = $d['hn_sale'];
                    $temparr['hn_MakeDate'] = $util->fnShort_Date($d['hn_MakeDate']);
                    $temparr['hn_sellSDate'] = $util->fnShort_Date($d['hn_sellSDate']);
                    $temparr['hn_sellEDate'] = $util->fnShort_Date($d['hn_sellEDate']);
                    $temparr['hn_tax'] = $d['hn_tax'];
                    $temparr['hn_desc'] = $d['hn_desc'];
                    $temparr['hn_isSell'] = $d['hn_isSell'];

                    $fname = array(
                        'img' => '',
                        'data' => ''
                    );
                    $fRs = $herb_m->Load_Product_File_Code($d['hn_code']);
                    if($util->fnArrayCnt($fRs)>0){
                        foreach ($fRs as $c){
                            if($c['typ']==1){
                                $fname['img'] = $c['fname'];
                            }else if($c['typ']==2){
                                $fname['data'] = $c['fname'];
                            }
                        }
                    }

                    $temparr['fname'] = $fname;
                    if ($type == 100) {
                        $pricearr = $util->fnLoadPrice($d['hn_code']);
                        $temparr['hn_gPrice'] = $pricearr[0]['hn_gPrice'];
                        $temparr['hn_pPrice'] = $pricearr[0]['hn_pPrice'];
                        $temparr['hn_method'] = $pricearr[0]['hn_method'];
                        $temparr['hn_stock'] = $pricearr[0]['hn_stock'];
                    }else {
                        $temparr['price'] = $util->fnLoadPrice($d['hn_code']);
                    }

                    if ($d['hn_isok'] == 100) {
                        $hn_isok_str = '승인';
                    } else if ($d['hn_isok'] == 1) {
                        $hn_isok_str = '반려';
                    } else if ($d['hn_isok'] == 0) {
                        $hn_isok_str = '미승인';
                    }

                    $temparr['hn_isok_str'] = $hn_isok_str;
                    $temparr['hn_isok'] = $d['hn_isok'];
                    $temparr['hn_regdate'] = $d['hn_regdate'];

                    $reject = $herb_m->Load_Product_isOk($d['hn_code']);
                    if($util->fnArrayCnt($reject)>0){
                        $temparr['hn_memo'] = $reject[0]['hn_memo'];
                        $temparr['hn_type'] = $reject[0]['hn_type'];
                    }else{
                        $temparr['hn_memo'] = '';
                        $temparr['hn_type'] = '';
                    }
                    array_push($dataarr, $temparr);
                }
                $new_page = $page + 1;
            } else {
                $new_page = $page;
            }

            $info = array(
                'page' => $new_page,
                'list' => $dataarr
            );

            $result = 'ok';
            $data = $info;
            $message = 'success';
        }

        $return = array(
            'result' => $result,
            'info' => $data,
            'message' => $message
        );
        return $this->respond($return);
    }

