                    if (!in_array($ext, $allowed_extensions)) {
                        $result = 'type102';
                        $message = '업로드는 [' . $allow . '] 확장자만 가능합니다.';
                    } else if ($size >= $max_file_size) {
                        $result = 'type103';
                        $message = '업로드는 [' . $util->Str_File_Sise($max_file_size) . '] 확장자만 가능합니다.';
                    } else {
                        if ($key == 'attachedImg') {
                            $dir = "././assets/board/img";
                            $upload_dir = $dir . '/';
                        } else if ($key == 'attachedFile') {
                            $dir = "././assets/board/file";
                            $upload_dir = $dir . '/';
                        } else {
                            $timeNow = date("Ymd");
                            $dir = "././assets/board/$timeNow";
                            $upload_dir = $dir . '/';
                        }
                        if (is_dir($dir) != true) {
                            mkdir($dir, 0777, true);
                        }
                        helper('text');
                        $fileName = random_string('alnum', 16);
                        $path = $fileName . '.' . $ext;
                        if (move_uploaded_file($file->getTempName(), $upload_dir . $path)) {
                            $insert = array(
                                'fk_bode' => $bcode,
                                'fname' => $path,
                                'f_type' => $typ
                            );
                            $board_m = model('Board_m');
                            $Cnt = $board_m->Insert_Board_AttachedImg($insert);
                            if ($Cnt > 0) {
                                $result = 'ok';
                                $message = 'success';
                            } else {
                                $result = 'type106';
                                $message = '파일 업로드 정보 업데이트에 실패 하였습니다.(Error101)';
                            }
                        } else {
                            $result = 'type105';
                            $message = '파일 업로드 정보 업데이트에 실패 하였습니다.(Error102)';
                        }
                    }
                } else {
                    $result = 'type104';
                    $message = '파일이 선택되지 않았습니다. 다시 시도하여주세요.(Error103)';
                }
            } else {
                $result = 'type111';
                $message = '파일이 선택되지 않았습니다. 다시 시도하여주세요.(Error104)';
            }
        }
        $return = array(
            'result' => $result,
            'msg' => $message
        );
        return $this->respond($return);
    }


//    public function Update_product_Edited()
    public function Insert_BContent(){

        $request = service('request');
        foreach ($request->getPost() as $key => $value) {
            $post[$key] = $value;
        }

        if(empty($post)){
            $result = 'type101';
            $code = '';
            $message = '필수 입력값을 확인하여주세요.';
        }else{
            $util = new Utils;
            $sessionarr = $util->fnGetSessionData();
            $userid = $sessionarr['user']['userid'];
            $data = array(
                'uid' => $post['p_uid'],
                'writer' => $userid,
                'bid' => $post['bid'],
                'btyp' => $post['btyp'],
                'bTitle' => $post['bTitle'],
                'bContent' => $post['bContent'],
                'isDel' => 0,
                'regidate' => date('Y-m-d H:i:s')
            );

            $board_m = model('Board_m');
            $bcode = $board_m->Insert_Board($data);
            if($bcode <= 0){
                $result = 'type102';
                $code = '';
                $message  = '';
            }else{
                $result = 'ok';
                $code = $bcode;
                $message  = 'success';
            }
        }

        $return = array(
            'result' => $result,
            'code' => $code,
            'msg' => $message
        );
        return $this->respond($return);
    }


    public function Update_Edited_BContent()
    {

        $request = service('request') ;
        $post = [];
        foreach ($request->getPost() as $key => $value) {
            $post[$key] = $value;
        }

        if(empty($post)){
            $result = 'type101';
            $message = '필수 입력값을 확인하여주세요.';
        } else {
            $util = new Utils;
            $sessionarr = $util->fnGetSessionData();
            $uid = $sessionarr['user']['uid'];
            $b_uid = ($request->getPost('b_uid') == '') ? '' : $request->getPost('b_uid');
            $bcode = ($request->getPost('bcode') == '') ? '' : $request->getPost('bcode');
            if ($uid != $b_uid) {
                $result = 'type102';
                $message = '계정 권한을 확인하여주세요.';

            } else {

                $data = array(
                    'btyp' => $post['btyp'],
                    'bTitle' => $post['bTitle'],
                    'bContent' => $post['bContent'],
                    'isDel' => 0,
                    'update_date' => date('Y-m-d H:i:s')
                );

                $board_m = model('Board_m');
                $bcode = $board_m->Update_Board($bcode,$data);
                if($bcode <= 0){
                    $result = 'type102';
                    $message  = 'nothing updated';
                }else{
                    $result = 'ok';
                    $message  = 'success';
                }

            }

            $return = array(
                'result' => $result,
                'msg' => $message
            );
            return $this->respond($return);

        }
    }

    public function Insert_RContent()
    {

        $request = service('request') ;
        $post = [];
        foreach ($request->getPost() as $key => $value) {
            $post[$key] = $value;
        }

        if(empty($post)){
            $result = 'type101';
            $message = '필수 입력값을 확인하여주세요.';
        } else {
            $util = new Utils;
            $sessionarr = $util->fnGetSessionData();
            $mi_type = $sessionarr['user']['mi_type'];
            $bcode = ($request->getPost('bcode') == '') ? '' : $request->getPost('bcode');
            if ($mi_type != 'master') {
                $result = 'type102';
                $message = '계정 권한을 확인하여 주세요.';

            } else {

                $data = array(
                    'fk_bcode' => $bcode,
                    'rContent' => $post['rContent'],
                    'isDel' => 0,
                    'regidate' => date('Y-m-d H:i:s')
                );

                $board_m = model('Board_m');
                $bcode = $board_m->Insert_Board_Reply($data);
                if($bcode <= 0){
                    $result = 'type102';
                    $message  = 'nothing inserted';
                }else{
                    $result = 'ok';
                    $message  = 'success';
                }

            }

            $return = array(
                'result' => $result,
                'msg' => $message
            );
            return $this->respond($return);

        }
    }

    public function Re_Approval(){
        $util = new Utils();
        $sessinarr = $util->fnGetSessionData();

        // 1. 로그인 체크
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];

            // 2. 권한 체크 (마스터만 통과)
            if ($mi_type != 'pharm') {
                $result = 'type101';
                $message = '권한이외의 접근입니다.';
            } else {
                $request = service('request');
                $hncode = ($request->getPost('hncode') == '') ? '' : $request->getPost('hncode');
                if ($hncode == '') {
                    $result = 'type102';
                    $message = '잘못된 접근입니다.';
                }else{
                    $param = array(
                        'hn_isok' => 0
                    );
                    $herb_m = model('Herb_m');
                    $Cnt = $herb_m->Update_Product_Info($hncode,$param);
                    if($Cnt <= 0){
                        $result = 'type104';
                        $message = '반려 사유 등록에 실패 하였습니다';

                    }else{
                        $result = 'ok';
                        $message = 'success';
                    }
                }
            }
        }

        $return = array(
            'result' => $result,
            'data' => '',
            'message' => $message
        );
        return $this->respond($return);
    }

    public function Load_ProductEvent()
    {
        $util = new Utils;
        $sessinarr = $util->fnGetSessionData();
        if (!$sessinarr['islogin']) {
            $data = '';
            $result = 'NoLogin';
            $message = 'NOT LOGIN';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            if ($mi_type != 'master') {
                $result = 'authorization issue';
                $message = '권한이 없습니다.';

            } else {
                $herb_m = model('Herb_m');
                $dataarr = array();
                $Rs = $herb_m->Load_ProductEvent(['fk_hncode' => $fk_hncode]);
                if($util->fnArrayCnt($Rs) <= 0) {
                    $result = 'null';
                    $message = '게시글이 없습니다.';

                } else {
                    foreach ($Rs as $d){
                        $temparr = array();

                        $temparr['fk_hncode']    = $d['fk_hncode'];
                        $temparr['f_type'] = $d['f_type'];

                        array_push($dataarr, $temparr);
                    }
                }

            }

            $result = 'ok';
            $data = $dataarr;
            $message = 'success';
        }

        $return = array(
            'result' => $result,
            'info' => $data,
            'message' => $message
        );
        return $this->respond($return);

    }

    public function Insert_ProductEvent(){
        $util = new Utils;
        $sessionarr = $util->fnGetSessionData();
        if (!$sessionarr['islogin']) {
            $result = 'NoLogin';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessionarr['user']['mi_type'];
            if ($mi_type != 'master') {
                $result = 'type111';
                $message = '권한이외의 접근입니다.';
            }else{
                $data = $this->request->getJSON(true);
                $hncode = isset($data['hncode']) ? $data['hncode'] : '1';
                $dataTypeArr = isset($data['dataType']) ? $data['dataType'] : [];

                if (empty($hncode) || empty($dataTypeArr)) {
                    $result = 'type101';
                    $message = '필수 입력값을 확인하여주세요.';

                }  else {
//                    $post = $data;

                    $herb_m = model('Herb_m');
                    $param = array();
                    $hncode = '';
                    $Cnt = $util->fnArrayCnt($dataTypeArr);
                    $Rs = $herb_m->Load_ProductEvent($hncode);

                    for($i=0;$i<=($Cnt-1);$i++){
                        $hncode = $dataTypeArr[$i];
                        $t_arr = array();
                        $Rs = $herb_m->Load_ProductEvent($hncode);
                        if($util->fnArrayCnt($Rs)>0){
                            $t_arr['fk_hncode'] = $hncode;
                            $t_arr['f_type'] = isset($Rs[0]['f_type']) ? $Rs[0]['f_type'] : null;

                            array_push($param,$t_arr);
                        }
                    }

                    if($util->fnArrayCnt($param)>0){
                        $eCnt = $herb_m->Insert_ProductEvent($param);

                    }

                    $ECnt =  $herb_m->Cnt_Event($hncode);


                    $i_arr = array(
                        'event' =>  $ECnt
                    );
                }

                $result = 'ok';
                $data2 = $i_arr;
                $message = '';
            }
        }
        $return = array(
            'result' => $result,
            'info' => $data2,
            'message' => $message
        );
        return $this->respond($return);


    }
}
    