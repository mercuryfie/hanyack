    public function Update_DeliInfo()
    {
        $util = new Utils();
        $sessinarr = $util->fnGetSessionData();

        // 1. 로그인 체크
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            $mi_code = $sessinarr['user']['mi_code'];

            // 2. 권한 체크 (마스터만 통과)
            if ($mi_type != 'decoc') {
                $result = 'type101';
                $message = '권한이외의 접근입니다.';
            } else {
                $request = service('request');
                foreach ($request->getPost() as $key => $value) {
                    $post[$key] = $value;
                }
                if (empty($post)) {
                    $result = 'type102';
                    $message = '잘못된 접근입니다.';
                } else {
                    $sn = $post['sn'];
                    $pcode = $post['zonecode'];
                    $Add1 = $post['Add1'];
                    $Add2 = $post['Add2'];
                    $miname = $post['miname'];
                    $ctc = $post['ctc'];
                    $isDefault = $post['isDefault'];

                    $herb_m = model('Herb_m');
                    $param = array();
                    $Rs = $herb_m->Load_DelInfo_Sn(['sn' => $sn]);
                    $Cnt = $util->fnArrayCnt($Rs);
                    if ($util->fnArrayCnt($Rs) <= 0) {
                        $result = 'type102';
                        $message = '해당 주소 정보가 존재하지 않습니다.';
                    } else {
                        $dbSn = '';
                        $db_micode = '';
                        if (!empty($Rs)) {
                            $dbSn = $Rs[0]['sn'];
                            $db_micode = $Rs[0]['fk_micode'];
                            $echo = $sn;
                            $echo2 = $dbSn;
                        }
                        if ($db_micode != $mi_code) {
                            $result = 'type108';
                            $message = '변경 권한이 없습니다.';
                        } else {
                            if ($dbSn != $sn) {
                                $result = 'type109';
                                $message = '해당 주소가 없습니다.';
                            } else {
                                if ($isDefault == 1) {
                                    $isZero = 0;

                                    $Cnt = $herb_m->Update_DelInfo_SetAllAsZero($mi_code,$isZero);
                                    if ($Cnt <= 0) {
                                        $result = 'type103';
                                        $message = '기본 배송지 저장에 실패 하였습니다.';
                                        echo ($mi_code);
                                    } else {
                                        $param2 = array(
                                            'sn' => $sn,
                                            'fk_micode' => $mi_code,
                                            'mi_zip' => $pcode,
                                            'mi_Address1' => $Add1,
                                            'mi_Address2' => $Add2,
                                            'mi_name' => $miname,
                                            'mi_tel' => $ctc,
                                            'isDefault' => 1
                                        );
                                        $Cnt2 = $herb_m->Update_DelInfo($param2);
                                        if ($Cnt2 <= 0) {
                                            $result = 'type104';
                                            $message = '새로운 주소 등록 실패';
                                        } else {
                                            $result = 'ok';
                                            $message = 'success';

                                        }
                                    }
                                } else if ($isDefault == 0){
                                    $param3 = array(
                                        'fk_micode' => $mi_code,
                                        'mi_zip' => $pcode,
                                        'mi_Address1' => $Add1,
                                        'mi_Address2' => $Add2,
                                        'mi_name' => $miname,
                                        'mi_tel' => $ctc,
                                        'isDefault' => 0
                                    );

                                    $Cnt3 = $herb_m->Update_DelInfo($param3);
                                    if ($Cnt3 <= 0) {
                                        $result = 'type105';
                                        $message = '새로운 주소 등록 실패2';
                                    } else {
                                        $result = 'ok';
                                        $message = 'success';
                                    }
                                } else {
                                    $result = 'type106';
                                    $message = '새로운 주소 등록 실패3';

                                }
                            }


                        }

                    }
                }
            }
        }

        $return = array(
            'result' => $result,
            'message' => $message,
            'param' => $param
        );
        return $this->respond($return);
    }

    public function Delete_DeliInfo()
    {
        $util = new Utils();
        $sessinarr = $util->fnGetSessionData();

        // 1. 로그인 체크
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            $mi_code = $sessinarr['user']['mi_code'];

            if ($mi_type != 'decoc') {
                $result = 'type101';
                $message = '권한이외의 접근입니다.';
            } else {
                $request = service('request');
                foreach ($request->getPost() as $key => $value) {
                    $post[$key] = $value;
                }
                if (empty($post)) {
                    $result = 'type102';
                    $message = '잘못된 접근입니다.';
                } else {
                    $sn = $post['sn'];

                    $herb_m = model('Herb_m');
                    $param = array();

                    $Rs = $herb_m->Load_DelInfo_Sn(['sn' => $sn]);
                    $Cnt = $util->fnArrayCnt($Rs);
                    if ($Cnt <= 0) {
                        $result = 'type102';
                        $message = '해당 제약사가 존재하지 않습니다.';
                    } else {

                        $db_micode = '';
                        $dbSn = '';
                        if (!empty($Rs)) {
                            $dbSn = $Rs[0]['sn'];
                            $db_micode = $Rs[0]['fk_micode'];
                            $echo = $sn;
                            $echo2 = $dbSn;
                        }
                        if ($db_micode != $mi_code) {
                            $result = 'type108';
                            $message = '권한이 없습니다.';
                        } else {
                            if ($dbSn != $sn) {
                                $result = 'type109';
                                $message = '해당 주소가 없습니다.';
                            } else {
                                $Cnt = $herb_m->Delete_DelInfo($sn);
                                if ($Cnt <= 0) {
                                    $result = 'type110';
                                    $message = '삭제 실패 하였습니다.';
                                } else {
                                    $result = 'ok';
                                    $message = 'success';
                                }
                            }
                        }

                    }
                }
            }
        }

        $return = array(
            'result' => $result,
            'message' => $message,
            'param' => $param,
            'ehoc' => $echo,
            'ehoc2' => $echo2
        );
        return $this->respond($return);
    }

    public function Update_Product_Reject()
    {
        $util = new Utils();
        $sessinarr = $util->fnGetSessionData();

        // 1. 로그인 체크
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];

            // 2. 권한 체크 (마스터만 통과)
            if ($mi_type != 'master') {
                $result = 'type101';
                $message = '권한이외의 접근입니다.';
            } else {
                $request = service('request');
                foreach ($request->getPost() as $key => $value) {
                    $post[$key] = $value;
                }
                if (empty($post)) {
                    $result = 'type102';
                    $message = '잘못된 접근입니다.';
                } else {
                    $hncode = $post['hncode'];
                    $hntype = $post['hntype'];
                    $hnmemo = $post['hnmemo'];

                    $herb_m = model('Herb_m');
                    $Rs = $herb_m->Load_Product_Code($hncode);
                    if ($util->fnArrayCnt($Rs) <= 0) {
                        $result = 'type102';
                        $message = '입력하신 약재는 존재하지 않습니다.';
                    } else {
                        $param = array(
                            'hn_isok' => 1
                        );
                        $Cnt = $herb_m->Update_Product_Info($hncode, $param);
                        if ($Cnt <= 0) {
                            $result = 'type103';
                            $message = '반려처리에 실패 하였습니다.';
                        } else {
                            $data = array(
                                'fk_hncode' => $hncode,
                                'hn_type' => $hntype,
                                'hn_memo' => $hnmemo
                            );
                            $insertid = $herb_m->Insert_Reject_Data($data);
                            if ($insertid <= 0) {
                                $result = 'type104';
                                $message = '반려 사유 등록에 실패 하였습니다';
                            } else {
                                $result = 'ok';
                                $message = 'success';
                            }
                        }
                    }
                }
            }
        }

        $return = array(
            'result' => $result,
            'message' => $message
        );
        return $this->respond($return);
    }

    public function Update_Product_IsOk()
    {
        $util = new Utils();
        $sessinarr = $util->fnGetSessionData();

        // 1. 로그인 체크
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            // 2. 권한 체크 (마스터만 통과)
            if ($mi_type != 'master') {
                $result = 'type101';
                $message = '권한이외의 접근입니다.';
            } else {
                $request = service('request');
                $hncode = ($request->getPost('hncode') == '') ? '' : $request->getPost('hncode');
                $hntype = ($request->getPost('hntype') == '') ? '' : $request->getPost('hntype');

                if ((empty($hncode)) || (($hntype == ''))) {
                    $result = 'type102';
                    $message = '잘못된 접근입니다.';
                } else {
                    $herb_m = model('Herb_m');
                    $in_code = explode(',', $hncode);
                    $param = array(
                        'hn_isok' => $hntype
                    );
                    $Cnt = $herb_m->Update_Product_Info_Wherein($in_code, $param);
                    if ($Cnt > 0) {
                        $result = 'ok';
                        $message = 'success';
                    } else {
                        $result = 'error';
                        $message = '적용된 약재가 없습니다.';
                    }
                }
            }
        }

        $return = array(
            'result' => $result,
            'message' => $message
        );
        return $this->respond($return);
    }

    public function Update_Cancel_Product()
    {
        $util = new Utils();
        $sessinarr = $util->fnGetSessionData();

        // 1. 로그인 체크
        if (!$sessinarr['islogin']) {
            $result = 'NoLogin';
            $message = '로그인을 하셔야 합니다.';
        } else {
            $mi_type = $sessinarr['user']['mi_type'];
            // 2. 권한 체크 (마스터만 통과)
            if ($mi_type != 'master') {
                $result = 'type101';
                $message = '권한이외의 접근입니다.';
            } else {
                $request = service('request');
                foreach ($request->getPost() as $key => $value) {
                    $post[$key] = $value;
                }
                if (empty($post)) {
                    $result = 'type102';
                    $message = '잘못된 접근입니다.';
                } else {
                    $hncode = $post['hncode'];
                    $herb_m = model('Herb_m');
                    $util = new Utils();

                    if (is_array($hncode)) {
                        $allSuccess = true;
                        foreach ($hncode as $code) {
                            $Rs = $herb_m->Load_Product_Code($code);
                            if ($util->fnArrayCnt($Rs) <= 0) {
                                $result = 'type102';
                                $message = "해당 약재($code)는 존재하지 않습니다.";
                                $allSuccess = false;
                                break;
                            } else {
                                $data = array('hn_isok' => 0);
                                $param = array('hncode' => $code, 'data' => $data);
                                $Cnt = $herb_m->Update_Product_Info($hncode,$param);
                                if ($Cnt <= 0) {
                                    $result = 'type103';
                                    $message = "승인 실패 하였습니다. (약재코드: $code)";
                                    $allSuccess = false;
                                    break;
                                }
                            }
                        }
                        if ($allSuccess) {
                            $result = 'ok';
                            $message = 'success';
                        }
                    } else {
                        $Rs = $herb_m->Load_Product_Code($hncode);
                        if ($util->fnArrayCnt($Rs) <= 0) {
                            $result = 'type102';
                            $message = '해당 약재는 존재하지 않습니다.';
                        } else {
                            $data = array('hn_isok' => 0);
                            $param = array('hncode' => $hncode, 'data' => $data);
                            $Cnt = $herb_m->Update_Product_Info($hncode,$param);
                            if ($Cnt <= 0) {
                                $result = 'type103';
                                $message = '승인 실패 하였습니다.';
                            } else {
                                $result = 'ok';
                                $message = 'success';
                            }
                        }
                    }
                }
            }
        }
        // 결과 반환
        return $this->response->setJSON([
            'result' => $result,
            'message' => $message
        ]);
    }

    public function Insert_Order()
    {
        $request = service('request');
        $str = ($request->getPost('str') == '') ? '' : $request->getPost('str');
        if ($str == '') {
            $result = 'type101';
            $info = '';
            $message = '구매약재 정보를 확인하여주세요.';
        } else {
            $util = new Utils();
            $str = '[' . $str . ']';
            $order = json_decode($str, true);
            if (($order == '') && ($util->fnArrayCnt($order) <= 0)) {
                $result = 'type102';
                $info = '';
                $message = '구매약재 정보를 확인하여주세요.';
            } else {
                $sessinarr = $util->fnGetSessionData();
                if (!$sessinarr['islogin']) {
                    $result = 'NoLogin';
                    $info = '';
                    $message = '로그인을 하셔야 합니다.';
                } else {
                    $total = 0;
                    $mi_code = $sessinarr['user']['mi_code'];
                    $herb_m = model('Herb_m');

                    $od_code = $util->fnMake_Code(3);

                    $arr = array();
                    $tarr = array();
                    foreach ($order as $d) {
                        $p_arr = $util->fnLoadPrice($d['code']);
                        if ($util->fnArrayCnt($p_arr) <= 0) {
                            exit();
                        } else {
                            $Cnt = $d['cnt'];
                            if($d['ptyp']==1){
                                $gd_pType = 1;
                                $gd_price = $p_arr[0]['hn_pPrice'];
                                $gd_period = 0;
                            }else{
                                $gd_pType = 2;
                                $gd_price = $p_arr[1]['hn_pPrice'];
                                $gd_period = $p_arr[1]['hn_period'];
                            }
                            $ntprice = ((int)$gd_price * (int)$Cnt);
                            $total += $ntprice;

                            $tarr = array(
                                'gd_code' => $util->fnMake_Code(4),
                                'fk_odcode' => $od_code,
                                'fk_hncode' => $d['code'],
                                'gd_pType' => $gd_pType,
                                'gd_period' => $gd_period,
                                'gd_price' => $ntprice,
                                'gd_cnt' => $Cnt,
                                'gd_rPrice' => $gd_price,
                            );

                            array_push($arr, $tarr);
                        }
                    }

                    if (empty($arr)) {
                        $result = 'type104';
                        $info = '';
                        $message = '구매약재 정보를 확인하여주세요.';
                    } else {
                        $param = array(
                            'od_micode' => $mi_code,
                            'od_code' => $od_code,
                            'od_price' => $total
                        );
                        $sn = $herb_m->Insert_Order($param);
                        if ($sn > 0) {
                            $Cnt = $herb_m->Insert_Order_Goods2($arr);
                        }

                        $result = 'ok';
                        $info = $od_code;
                        $message = 'success';
                    }
                }
            }
        }

        $return = array(
            'result' => $result,
            'info' => $info,
            'message' => $message
        );
        return $this->respond($return);

    }

    public function Match_Proc()
    {
        $request = service('request');
        foreach ($request->getPost() as $key => $value) {
            $post[$key] = $value;
        }
        if (empty($post)) {
            $result = 'type101';
            $message = '필수 입력값을 확인하여주세요.';
        } else {
            $util = new Utils;
            $sessinarr = $util->fnGetSessionData();
            if (!$sessinarr['islogin']) {
                $result = 'NoLogin';
                $message = '로그인을 하셔야 합니다.';
            } else {
                $hn_code = $post['hn_code'];
                $herb_m = model('Herb_m');
                $mi_code = $sessinarr['user']['mi_code'];
                if ($post['typ'] == 2) {

                    $NewCode = $util->fnMake_Code(2);

                    $param = array(
                        'hd_code' => $NewCode,
                        'fk_hncode' => $hn_code,
                        'fk_micode' => $mi_code,
                        'mm_medicine' => $post['mm_medicine'],
                        'mm_title_kor' => $post['mm_title_kor'],
                        'mm_origin_kor' => $post['mm_origin_kor'],
                        'mm_origin' => $post['mm_origin']
                    );
                    $fk_mmsn = $herb_m->Insert_Product_Match($param);
                    if ($fk_mmsn <= 0) {
                        $result = 'type103';
                        $message = '매칭 약재 등록에 실패 하였습니다.';
                    } else {
                        $param = array(
                            'fk_mmsn' => $fk_mmsn
                        );
                        $Cnt = $herb_m->Update_Product_info($hn_code, $param);
                        if ($Cnt > 0) {

                            $typ = 'HerbMatch';
                            $Log = '약재Matching|' . $hn_code . '|' . $post['mm_medicine'];
                            $util->fnLog_Reg($mi_code, $typ, $Log);

                            $result = 'ok';
                            $message = 'success';
                        } else {
                            $result = 'type104';
                            $message = '매칭 약재 정보 업데이트에 실패 하였습니다.';
                        }
                    }
                } else {
                    $Rs = $herb_m->Load_Product_info($hn_code);
                    if ($util->fnArrayCnt($Rs) <= 0) {
                        $result = 'type105';
                        $message = '매칭 약재 정보 로드에 실패 하였습니다.';
                    } else {
                        $fk_mmsn = $Rs[0]['fk_mmsn'];
                        $mm_medicine = $Rs[0]['mm_medicine'];
                        $param1 = array('fk_mmsn' => 0);
                        $Cnt = $herb_m->Update_Product_info($hn_code, $param1);
                        $param2 = array('isDel' => 1);
                        $Cnt = $herb_m->Update_Product_Match($fk_mmsn, $param2);
                        $typ = 'HerbUnMatch';
                        $Log = '약재UnMatching|' . $hn_code . '|' . $mm_medicine;
                        $util->fnLog_Reg($mi_code, $typ, $Log);
                        $result = 'ok';
                        $message = 'success';

                    }
                }
            }
        }
        $return = array(
            'result' => $result,
            'message' => $message
        );
        return $this->respond($return);
    }

    public function Load_OrginHerb()
    {
        $request = service('request');
        $cfcode = ($request->getPost('cfcode') == '') ? '' : $request->getPost('cfcode');
        $medicode = ($request->getPost('medicode') == '') ? '' : $request->getPost('medicode');

        if (($medicode == '') || ($cfcode == '')) {
            $result = 'type101';
            $data = '';
            $message = '잘못된 접근입니다.';
        } else {
            $apiUrl = 'https://api.djmedi.net/manager/medicine/?apiCode=medicinelist&reData=admmedilist2&language=kor&ckCfcode=' . $cfcode . '&mediherb=' . $medicode;
            $retVal = $this->fnCallPost($apiUrl, 'get');
            if (empty($retVal)) {
                $result = 'type102';
                $data = '';
                $message = '통신장애로 데이터로드에 실패하였습니다. .\n다시 시도 하여주세요.(101)';
            } else {
                $result = 'ok';
                $data = $retVal['list'];
                $message = '';
            }
        }
        $return = array(
            'result' => $result,
            'list' => $data,
            'message' => $message
        );
        return $this->respond($return);
    }

