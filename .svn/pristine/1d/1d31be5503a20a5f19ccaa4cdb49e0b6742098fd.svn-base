        font-size: 14px;
    }

    .periodSelected {
        border: 1px solid var(--second-color) !important;
        color: var(--second-color);
    }

    .lastBox {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        height: 80px;
        margin-bottom: 20px;
    }

    .modiLastBox {
        margin-right: 60px;
    }

    .mb40 {
