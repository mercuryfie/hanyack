        /* color:#fff; */
        border-radius: 5px;
        width: 140px;
        height: 38px;
        line-height: 38px;
        padding: 0px 10px;
        font-size: 16px;
        text-align: center;

    }

    .btntype8 {
        border: 1px solid #ccc;
