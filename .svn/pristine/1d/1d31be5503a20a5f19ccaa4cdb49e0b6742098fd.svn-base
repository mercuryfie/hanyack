    }

    .fontColor1 {
        color: #5c5c5c;
    }

    .m220 {
        margin-left: 200px;

    }

    .btnTypeTItle {
        border: none;
        border-left: 2px solid #000;
        /*border-radius: 5px;*/
        width: auto;
        height: 24px;
        font-size: 16px;
