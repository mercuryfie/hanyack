@media screen and (max-width: 768px) {
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: "Noto Sans KR", sans-serif;
    }

    ul {
        list-style-type: none;
    }

    a {
        text-decoration: none;
        color: inherit;
    }


    .main-container {
        width: fit-content;
        margin-left: auto;
        margin-right: auto;
    }

    .ck-content {
        line-height: 1.6;
        word-break: break-word;
    }

    .editor-container_classic-editor .editor-container__editor {
        min-width: 795px;
        max-width: 795px;
    }

    :root {
        --main-color: #4b6957;
        --sub-color: #edf1ef;
        --second-color: #5e9b76;
        --third-color: #b0ddc2;
        --forth-color: #8bffb9;
        --fifth-color: #1d3627;
        --sixth-color: #fc88ad;
        --orange: #fb932b;
        --eigth-color: #c975ed;
        --ninth-color: #6eec9a;
        --mint-color: #79f8d8;
        --bg-color1: #f1f1f16f;
        --bg-color2: #ececec;
        --bg-color3: #ccc;
        --bg-color4: #dedede;
        --cartbg: #f2f5f8;
        --gray-cart001: #848f9a;
        --grayColor1: #848f9a;
        --yellow: #f3df14;
        --ck-z-default: 100;
        --ck-z-panel: calc(var(--ck-z-default) + 999);
    }

    ::selection {
        background-color: #b0ddc2; /* 드래그 배경색 */
        color: #000; /* 드래그된 텍스트 색상 */
    }

    input[type="checkbox"] {
        accent-color: #5e9b76; /* 체크 표시 색상 (예: 토마토색) */
    }

    input[type="search"] {
        outline: none;
    }

    input[type="radio"] {
        accent-color: #4b6957;
        margin-right: 5px;
    }

    .mt20 {
        margin-top: 20px;
    }

    .mt40 {
        margin-top: 40px;
    }

    .pt10 {
        padding-top: 10px;
    }

    .noto-sans-kr {
        font-family: "Noto Sans KR", sans-serif;
        font-optical-sizing: auto;
        font-weight: 200;
        font-style: normal;
    }

    /*header start */
    .header_boxm9k {
        background-color: var(--main-color);
        width: 100vw;
        height: 60px;
        position: sticky;
        top: 0;
        left: 0;

    }

    * {
        color: red !important;
    }

    /*header end */
    /* spinnerBox start --------------- */
    .spinnerBox,
    .spinner {
        display: none;
    }

    .spinnerBox {
        position: fixed;
        z-index: 30;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.05);

    }

    .spinner {
        width: 24px;
        height: 24px;
        z-index: 32;
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    .spinnerBox.active, .spinner.active {
        display: block;
    }


    /* spinnerBox end --------------- */
    .btnType1 {
        border: 1px solid #ccc;
        background-color: #fff;
        border-radius: 5px;
        width: auto;
        height: 24px;
        line-height: 24px;
        padding: 0px 10px;
        font-size: 12px;
        text-align: center;

    }

    .btnType1-1 {

        border: 1px solid var(--second-color);
        color: var(--second-color);
        background-color: transparent;
        border-radius: 5px;
        width: auto;
        height: 24px;
        line-height: 24px;
        padding: 0px 10px;
        font-size: 12px;
        text-align: center;

    }


    .btnType2 {
        border: 1px solid var(--second-color);
        background-color: var(--second-color);
        color: #fff;
        border-radius: 5px;
        width: auto;
        height: 24px;
        line-height: 24px;
        padding: 0px 10px;
        font-size: 12px;
        text-align: center;

    }

    .fff {
        background-color: #fff;
    }


    .btntype2 {
        font-size: 10px;
        width: 40px;
        height: 20px;
        border: none;
        border-radius: 2px;
    }

    .btnType32 {
        border: 1px solid #ccc;
        background-color: #fff;
        border-radius: 5px;
        width: auto;
        height: 32px;
        line-height: 32px;
        padding: 0px 10px;
        font-size: 14px;
        text-align: center;
        margin-left: 10px;
        color: #2c2c2c;

    }


    .btnType3 {
        border: 1px solid #ccc;
