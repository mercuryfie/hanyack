$(document).ready(function() {
    Load_Order(1, '');
});



async function  Load_Order(page,decoc){
    try {
        start_spinner();
        let dataarr = {"page": page, "decec": decoc};
        let url = APIURL + '/Load_OrderList';
        let result = await Load_API(url, dataarr);
        console.log(dataarr);
        if (result.get('status') == 'NoLogin') {
            go_login();
        } else if (result.get('status') == 'ok') {
            let html = '';
            let firstsn = '';
            let data = result.get('data');
            let arr = (data && data.list) ? data.list : [];
            let Cnt = arr.length;
            if (Cnt > 0) {
                $.each(arr, function (index, el) {
                    html +=`
                        <tr>
                            <td>${el.gd_status}</td>
                            <td>${el.gd_code}</td>  
                            <td>${el.od_regdate}</td>
                            <td>${el.mi_name}</td>
                            <td>${el.od_wname}</td>
                            <td>${el.hn_name}</td>
                            <td>${el.gd_ptype}</td>
                            <td>${el.hn_option}</td>
                            <td>${el.gd_cnt}개</td>
                            <td>${number_format(el.gd_rPrice)}원</td>
                            <td>${number_format(el.gd_price)}원</td>
                        </tr>
                    `;
                });
            }else{
                html = '<tr><td colspan="11">주문정보가 없습니다.</td></tr>'
            }
            $('#orderlist').append(html);
        }else{
            Make_Toast(result.get('message'));
        }
        stop_spinner();
    }catch(error){
        Make_Toast('오류가 발생하였습니다. 다시 시도하여주세요.\n[ERROR : ' + error + '}');
        stop_spinner();
    }





}

