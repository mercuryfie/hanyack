<div class="machingPopCon2" id="matchingpop2"  name="matchingpop2" style="">
    <div class="machingPop2">
        <h2 class="head_title">약재 매칭</h2>
        <i class="fa-solid fa-xmark" id="XBtn2"></i>
        <div class="machingPop1-1">
            <div class="machingTitle">
                <p class="herbList">약재 목록</p>
                <div class="machingContents">
                    <div class="list" id="yaklist" name="yaklist" >
                    </div>
                </div>
            </div>
            <div class="resultBox">
                <div class="result1">
                    <p class="nation">원산지</p>
                    <p class="herbCode">약재코드</p>
                    <p class="pharm_hname">제약사 약재명</p>

                </div>
                <div class="result2">
                    <p  class="nation" id="yakorigin" name="yakorigin"></p>
                    <p class="herbCode" id="yakcode" name="yakcode"></p>
                    <p class="herbName" id="yakname" name="yakname"></p>

                </div>
            </div>
        </div>
        <div class="machingPop1-5">
            <button type="button"
                    class="btnType1" id="btn_close">닫기</button>
            <button class="btnType2" id="popMatch" name="popMatch"
                    type="button"
                    data-hncode="" data-mm_origin=""
                    data-mm_medicine="" data-mm_title_kor=""
                    data-mm_origin_kor="" >매칭하기</button>
        </div>
    </div>
</div>