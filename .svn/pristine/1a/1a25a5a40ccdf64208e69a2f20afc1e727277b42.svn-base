$(document).ready(function(){
    let page = $('#more').data('page');
    let skey = $('#hnname').val();

    Load_Stock(page,skey);

    $(document).on('click','#more1,#more2',function(){
        let page = $('#more1').data('page');
        let skey = $('#hnname').val();

        Load_Stock(page,skey);
    });

    $(document).on('keydown', '#hnname', function(e) {
        if (e.key === 'Enter' || e.keyCode === 13) {
            let hnname = $('#hnname').val();
            Form_ini();
            Load_Stock(1,hnname);
        }
    });

    $('#spinner2').remove();

});


async function Load_Stock(page,skey){
    try {
        start_spinner();
        let dataarr = {"page": page, "skey": skey};
        let url = APIURL + '/Load_DecocTotalStock';
        let result = await Load_API(url, dataarr);
        if (result.get('status') == 'NoLogin') {
            go_login();
        } else if (result.get('status') == 'ok') {
            let html = '';
            let data = result.get('data');
            let arr = (data && data.list) ? data.list : [];
            let Cnt = arr.length;
            let stylestr = '';
            if (Cnt > 0) {
                $.each(arr, function (index, el) {
                    if(el.stock==1){
                        stylestr = '';
                    }else{
                        stylestr = `style="background-color: #f8d7da;`;
                    }


                    html += `
                        <tr ${stylestr}>
                            <td>${el.mmCnt}</td>
                            <td>${el.mmMedicine}</td>
                            <td>${el.mmTitle}</td>
                            <td>${number_format(el.mmCapa)}개</td>
                            <td>${number_format(el.mmStable)}개</td>
                            <td>${number_format(el.mmdelCnt)}건</td>
                        </tr>
                    `;
                });
            }else{
                if(page==1) {
                    html = '<tr><td colspan="6">재고 정보가 없습니다.</td></tr>'
                }else{
                    Make_Toast('마지막입니다.');
                }
            }
            $('#stocklist').append(html);
            $('#more1').data('page',data.page);
        }else{
            Make_Toast(result.get('message'));
        }
        stop_spinner();
    }catch(error){
        Make_Toast('오류가 발생하였습니다. 다시 시도하여주세요.\n[ERROR : ' + error + '}');
        stop_spinner();
    }
}

function Form_ini(){
    $('#stocklist').empty();
    $('#more1').data('page',1);
}