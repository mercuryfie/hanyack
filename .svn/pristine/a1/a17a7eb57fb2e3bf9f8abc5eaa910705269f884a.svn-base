$(document).ready(function () {
    let pcode = $("#barcodeDiv").data("pcode");
    Prn_Barcode(pcode);

    $(document).on('click','#btn_close',function(){
        window.close();
    });

    $(document).on('click','#btn_prn',function(){
        printWindow('org_area');
    });


});

function Prn_Barcode(pcode) {
    console.log("cpcode=" + pcode);
    if (pcode == "") {
        alert("잘못된 접근입니다.");
        window.close();
    } else {
        $("#barcodeDiv").barcode(pcode, "code128", {
            barWidth: 1,
            barHeight: 32,
            fontSize: 12,
            showHRI: false,
        });
        $("#barcodeDiv").css("overflow", "hidden");
        $("#barcodeDiv").css("display", "flex");
        $("#barcodeDiv").css("justifyContent", "center");
        // $("#barcodeDiv").css("alignItens", "center");

        $("#barcodeDiv").css("width", "100%");
        $("#barcodeDiv").css("height", "32px");

    }
}
