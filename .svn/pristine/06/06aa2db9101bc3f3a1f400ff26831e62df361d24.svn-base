function price_minus(form,price){
    let Cnt =  $(form).parent().find('.price_cnt').html();
    let n_Cnt = Number(Cnt)-1;
    if(n_Cnt<=0) n_Cnt=0;
    $(form).parent().find('.price_cnt').html(n_Cnt);

    if(Cnt >0){
        let now_price = $(form).parent().parent().parent().find("[name='chkproduct']").data('nprice');
        let new_price = Number(price) * Number(n_Cnt);
        $(form).parent().parent().parent().find("[name='chkproduct']").data('nprice',new_price);

        let bool = $(form).parent().parent().parent().find("[name='chkproduct']").is(':checked');
        if(bool){
            let total = $('#totalprice').data('tprice');
            let n_price = (Number(total) - Number(now_price)) + Number(new_price);
            if (n_price < 0) n_price = 0;
            $('#totalprice').html('총 ' + n_price.toLocaleString() + '원');
            $('#totalprice').data('tprice', n_price);
        }
    }

    console.log('minus=' + $(form).parent().parent().parent().find("[name='chkproduct']").data('nprice'));

}

function price_plus(form,price){
    let Cnt =  $(form).parent().find('.price_cnt').html();
    let n_Cnt = Number(Cnt)+1;
    $(form).parent().find('.price_cnt').html(n_Cnt);
    let now_price = $(form).parent().parent().parent().find("[name='chkproduct']").data('nprice');
    let new_price = Number(price) * Number(n_Cnt);
    $(form).parent().parent().parent().find("[name='chkproduct']").data('nprice',new_price);

    let bool = $(form).parent().parent().parent().find("[name='chkproduct']").is(':checked');
    if(bool){
        let total = $('#totalprice').data('tprice');
        let n_price = (Number(total) - Number(now_price)) + Number(new_price);
        $('#totalprice').html('총 ' + n_price.toLocaleString() + '원');
        $('#totalprice').data('tprice', n_price);
    }

    console.log('plus=' + $(form).parent().parent().parent().find("[name='chkproduct']").data('nprice'));
}

function box_minus(form,price,box){
    let Cnt = $(form).parent().parent().parent().find('.price_cnt').html();
    let Box = $(form).parent().find('.box_cnt').html();
    let n_Cnt = Number(Cnt)-Number(box);
    let n_Box = Number(Box) -1;
    if(n_Cnt <=0) n_Cnt=0;
    if(n_Box <=0) n_Box=0;
    $(form).parent().parent().parent().find('.price_cnt').html(n_Cnt);
    $(form).parent().find('.box_cnt').html(n_Box);

    if(Cnt >0){
        let now_price = $(form).parent().parent().parent().find("[name='chkproduct']").data('nprice');
        let new_price = Number(price) * Number(n_Cnt);
        $(form).parent().parent().parent().find("[name='chkproduct']").data('nprice',new_price);

        let bool = $(form).parent().parent().parent().find("[name='chkproduct']").is(':checked');
        if(bool){
            let total = $('#totalprice').data('tprice');
            let n_price = (Number(total) - Number(now_price)) + Number(new_price);
            if (n_price < 0) n_price = 0;
            $('#totalprice').html('총 ' + n_price.toLocaleString() + '원');
            $('#totalprice').data('tprice', n_price);
        }
    }

    console.log('boxminus=' + $(form).parent().parent().parent().find("[name='chkproduct']").data('nprice'));

}

function box_plus(form,price,box){
    let Cnt =  $(form).parent().parent().parent().find('.price_cnt').html();
    let Box = $(form).parent().find('.box_cnt').html();
    let n_Cnt = Number(Cnt)+Number(box);
    let n_Box = Number(Box) +1;
    $(form).parent().parent().parent().find('.price_cnt').html(n_Cnt);
    $(form).parent().find('.box_cnt').html(n_Box);

    let now_price = $(form).parent().parent().parent().find("[name='chkproduct']").data('nprice');
    let new_price = Number(price) * Number(n_Cnt);
    $(form).parent().parent().parent().find("[name='chkproduct']").data('nprice',new_price);

    let bool = $(form).parent().parent().parent().find("[name='chkproduct']").is(':checked');
    if(bool){
        let total = $('#totalprice').data('tprice');
        let n_price = (Number(total) - Number(now_price)) + Number(new_price);
        $('#totalprice').html('총 ' + n_price.toLocaleString() + '원');
        $('#totalprice').data('tprice', n_price);
    }

    console.log('boxplus=' + $(form).parent().parent().parent().find("[name='chkproduct']").data('nprice'));
}

function add_thum_cart(code,cnt,ptype){
    console.log(code + '/' + cnt + '/' + ptype);

    if((code!='') && (cnt!='') && (ptype!='')) {
        let items = [];
        items.push({code: code, cnt: cnt, ptyp: ptype});
        let str = JSON.stringify(items);
        Herb_Cart_Do(str);
        Make_Toast('장바구니에 담았습니다.');
    }else{
        Make_Toast('잘못된 접근입니다..[Error101]');
    }

}