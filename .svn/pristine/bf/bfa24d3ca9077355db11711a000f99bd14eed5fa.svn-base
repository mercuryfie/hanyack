$(document).ready(function(){
    $(document).on('click','button[name="pCnt"]', function() {
        $(this).addClass('active').siblings().removeClass('active');
        $('#pageArea').data('page',1);
        Make_Html(Make_Option());
    });

    $('#oby').on('click',function(){
        const optval = $(this).data('sort');
        const $icon = $(this).find('i');
        if(optval==1){
            $(this).data('sort',2);
            $icon
                .removeClass('fa-angle-down')
                .addClass('fa-angle-up');
        }else{
            $(this).data('sort',1);
            $icon
                .removeClass('fa-angle-up')
                .addClass('fa-angle-down');

        }
        $('#pageArea').data('page',1);
        Make_Html(Make_Option());
    });

    $(document).on('click','button[name="btnLinkPaging"]',function(){
        $('#pageArea').data('page',$(this).data('page'));
        Make_Html(Make_Option());
    });

    $(document).on('click','button[name="popBuy"]',function(){
        const cfcode = $('#cList').data('cfcode');
        const mm_code = $(this).data('mmcode');
        console.log(cfcode +'/'+mm_code);
        $('#pop_buy_item').show();
    });

    $('#pop_buy_item #Xbtn, #pop_buy_item #Xbtn2').click(function () {
        $('#pop_buy_item').hide();
    });

    $('#matchingpop #Xbtn, #matchingpop #Xbtn2').click(function () {
        $('#matchingpop').hide();
    });

    $(document).on('click','button[name="mmMatch"]',function(){
        const cfcode = $('#cList').data('cfcode');
        const mm_medicine = $(this).data('mmcode');
        const mm_title = $(this).data('mname');
        const medicode = $(this).data('medicode');
        console.log(medicode);
        Ini_Match_Pop();
        Open_Match_Pop(cfcode,mm_medicine,mm_title,medicode);



        $('#matchingpop').show();
    });

    $('#btnHSearch').on('click',function(){
        Search_Herb();
    });

    $('#h_sKey').on('keypress',function(e){
        if (e.which === 13 || e.keyCode === 13) {
            Search_Herb();
        }
    })

    $('#txtMatchPopSearch').on('focus',function(){
        $('#resSearch').empty();
        $('#resSearch').hide();
        $('#txtMatchPopSearch').val('');
    });

    $('#txtMatchPopSearch').on('blur',function(){
        $('#resSearch').empty();
        $('#resSearch').hide();
        $('#txtMatchPopSearch').val('');
    });


    $('#btnMatchPopSearch').on('click',function(){
        Make_Match_Search_Html();
    });

    $('#txtMatchPopSearch').on('keypress',function(e){
        if (e.which === 13 || e.keyCode === 13) {
            Make_Match_Search_Html();
        }
    });

    Make_Html(Make_Option());
});

function Search_Herb(){
    const SearchStr = $('#h_sKey').val();
    $('#cList').empty();
    $('#pageArea').data('page',1);
    Make_Html(Make_Option());
}


function Make_Option(){
    let params = {
        cfcode : $('#cList').data('cfcode'),
        pCnt : $('button[name="pCnt"].active').data('pval'),
        opt : $('#oby').data('sort'),
        page : $('#pageArea').data('page'),
        sStr : $('#h_sKey').val()
    };
    return params;
}


async function Make_Html(params){
    const response = await Model.decoc.Load_Medicine_decoc(params);
    console.log(response);
    let html = '';
    let subHtml = '';
    let stock = 0;
    let oStock = 0;
    let mStock = 0;
    let rStock = 0;
    const total = response.total;
    const mTotal = response.totalRs;
    const nPage= response.nPage;
    if(total>0) {
        $.each(response.list, function (index, el) {
            stock = parseInt((el.stock || 0));
            oStock = parseInt((el.optimal_stock || 0));
            wStock = parseInt((el.stock_ware || 0));
            mStock = parseInt((el.stock_month || 0));
            ware = parseInt((el.stock_ware || 0));
            rStock =(stock*0.1) - el.stock_month;
            subHtml = (rStock<=stock) ? 'class="active"' : '';
            html +=`
                    <tr ${subHtml}>  
                        <td>${el.mm_title}</td>
                        <td>${el.mm_medicine}</td>
                        <td>${number_format(stock + ware)}g</td>
                        <td>${number_format(stock)}g</td>
                        <td>${number_format(ware)}g</td>
                        <td>${number_format(wStock)}g</td>
                        <td>${number_format(mStock)}g</td>
                        <td>${number_format(oStock)}g</td>
                        <td><button class="colorRed machingOption btntype2" type="button" name="mmMatch" data-mname="${el.mm_title}" data-mmcode="${el.mm_medicine}" data-medicode="${el.md_Medi}">${el.matched}건</button></td>
                        <td><button class="bestpri btntype2" type="button" name="popBuy" data-mmcode="${el.mm_medicine}">구입</button></td>
                        <td>${el.update}</td>
                    </tr>
            `;
        });
    }else{
        html =`<tr><td colspan="9">검색된 약재정보가 없습니다.</td></tr>`;
    }

    let options = {
        page : $('#pageArea').data('page'),
        total : mTotal,
        perpage : $('button[name="pCnt"].active').data('pval'),
        bname : 'btnLinkPaging'
    }
    $('#pageArea').html(Make_Page_Html('simple',options));
    $('#totalRs').text(number_format(mTotal || 0));
    $('#cList').empty();
    $('#cList').append(html);
    $('#pageArea').data('page',nPage);
}

async function Open_Match_Pop(cfcode,mmcode,mmtitle,medicode){
    $('#mm_medicine').text(mmcode);
    $('#mm_title').text(mmtitle);
    $('#mm_medicine').data('cfcode',cfcode);
    $('#mm_medicine').data('medicode',medicode);
    let params = {cfcode : cfcode,code:mmcode,medicode:medicode};
    Make_Match_Html(params);
}

function Ini_Match_Pop() {
    $('#mm_medicine').text('');
    $('#mm_title').text('');
    $('#txtMatchPopSearch').val('');
    $('#resSearch').empty();
    $('#resMatching').empty();
    $('#resMatched').empty();
}

async function Make_Match_Html(params){
    let response = await Model.decoc.Load_Medicine_Decoc_Match(params);
    console.log(response);
    let matchedCnt = response.matchedCnt;
    let matchedHtml = '';
    if(matchedCnt>0){
        $.each(response.matched, function (index, el) {
            optionstr = (el.hn_option == '') ? '' : '[' + el.hn_option + ']';
            matchedHtml += `
                <tr>
                    <td class="flexType2"> 
                        <div class="flexCol"> 
                            <p class="data data1">${el.hn_origin} / ${el.hn_wname}</p>
                            <p class="data data2">${el.hn_name} ${optionstr}</p>
                        </div>
                        <button type="button" class="btn_match btn_secondary" name="btnMatchOff" data-cfcode="${params['cfcode']}" data-sn="${el.matchedsn}">해제</button>
                    </td>
                </tr>
            `;
        });

        $('#resMatched').append(matchedHtml);
    }
    let matchingCnt =  response.matchingCnt;
    let matchingHtml = response.matching;
    if(matchingCnt>0){
        $.each(response.matching, function (index, el) {
            matchingHtml += `
                <tr>
                    <td class="flexType2"> 
                        <div class="flexCol"> 
                            <p class="data data1">${el.hn_origin} / ${el.hn_wname}</p>
                            <p class="data data2">${el.hn_name} ${optionstr}</p>
                        </div> 
                        <button type="button" class="btn_match btn_secondary" name="btnMatchOn" data-cfcode="${params['cfcode']}" data-hncode="${el.hncode}" data-hntitle="${el.hn_name}${el.hn_option}">매칭</button>
                    </td>
                </tr>
            `;
        });

        $('#resMatching').append(matchingHtml);
    }
}

async function Make_Match_Search_Html() {
    const s_key = $('#txtMatchPopSearch').val();
    if (s_key == '') {
        Make_Toast('검색할 약재명을 입력하세요.');
        $('#txtMatchPopSearch').focus();
        return;
    }
    let params = {skey: s_key};
    const response = await Model.pharm.Search_Medicine_Pharm(params);
    console.log(response);
    let html = '';
    let total = response.total;
    if (total > 0) {
        $.each(response.list, function (index, el) {
            html += `
                    <div class="item_box flexType2"> 
                        <div class="flexCol"> 
                            <p class="data data1">${el.hn_origin} / ${el.hn_wname}</p>
                            <p class="data data2">${el.hn_name} ${optionstr}</p>
                        </div>  
                        <button type="button" class="btn_match btn_primary" data-cfcode="${params['cfcode']}" data-hncode="${el.hncode}" data-hntitle="${el.hn_name}${el.hn_option}">매칭</button>
                    </div>
            `;
        });
    }else{
        html += `
                    <div class="item_box flexType2">
                        <p class="item active mr10">검색된 약재 없습니다.</p>
                    </div>
       `;
    }
    $('#resSearch').empty();
    $('#resSearch').append(html);
    $('#resSearch').show();
}





