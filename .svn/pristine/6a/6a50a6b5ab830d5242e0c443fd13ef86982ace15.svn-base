/* merwrap  -------------------------------- */

.merregister {
    height: auto;
}

/* footer 이상 시 여기에 height 넣기 */
.merwrap {
    margin: 0 auto;
    width: 1050px;
    display: flex;
    flex-flow: column;
}

.mypageHeader {
    margin: 0 auto;
    width: 1050px;
    height: 60px;
    display: flex;
    align-items: center;

}

.mypageContent {
    display: flex;
    justify-content: center;
}

.merleft,
.merright {
    display: flex;
    flex-flow: column;
}

.merleft1-1 {
    width: 1050px;
    height: 160px;
    position: relative;
}

.merleft1-1 > a {
    position: absolute;
    top: 40px;
    left: 20px;
    font-size: 22px;
    font-weight: bold;
}

.merleft1-1 > div {
    display: flex;
    position: absolute;
    top: 80px;
    left: 20px;
}

.merleft1-1 > div > a {
    margin-right: 10px;
}

.merleft1-2 {
    width: 140px;
    background-color: #fff;
    border-radius: 10px;
    height: 120px;
    margin-right: 16px;
    margin-bottom: 16px;
    display: flex;
    flex-flow: column;
}


.merleft1-2 > a:first-child {
    font-size: 16px;
    padding-left: 20px;
    margin-top: 20px;
    margin-bottom: 5px;
    font-weight: 500;
    height: 32px;
    line-height: 32px;
    text-wrap: wrap;
}

.merleft1-2 > a {
    height: 42px;
    line-height: 14px;
    font-size: 14px;
    padding: 0 20px;
}

.merleft1-3 {
    width: 140px;
    border-radius: 10px;
    height: auto;
    background-color: #fff;
    display: flex;
    flex-flow: column;
    position: relative;
    z-index: 12;
    margin-bottom: 40px;

}

.topmenu {
    padding: 40px 0;
    border-radius: 10px;
    background-color: #fff;
    width: 140px;
    height: auto;
    display: flex;
    flex-flow: column;
    position: sticky;
    z-index: 12;
}

.topmenu > a {
    background-color: #fff;
    width: 140px;
    height: 40px;
    line-height: 40px;
    font-size: 16px;
    padding-left: 30px;
    display: inline-block;
}


/*  submenu1 ----------------*/
.topmenu > a:hover {
    text-decoration: underline;
    color: var(--second-color);
}

.submenu1-4,
.submenu1-1,
.submenu1-2,
.submenu1-3 {
    padding: 40px 0;
    width: 120px;
    height: 280px;
    border-radius: 0px 10px 10px 0px;
    position: absolute;
    top: 0;
    left: 0px;
    background-color: #ececec61;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);

    z-index: 10;
    display: flex;
    flex-flow: column;
    display: none;
}

.submenu1-4 > a,
.submenu1-1 > a,
.submenu1-2 > a,
.submenu1-3 > a {
    width: 120px;
    height: 40px;
    line-height: 40px;
    font-size: 14px;
    display: inline-block;
    color: black;
    text-decoration: none;
    text-align: center;
}

.submenu > a:hover {
    background-color: #fff;
    color: var(--second-color);
    text-decoration: underline;
}


.topmenu1-2:hover ~ .submenu1-4,
.topmenu1-2:hover ~ .submenu1-2,
.topmenu1-1:hover ~ .submenu1-1 {
    display: inline-block;
}

