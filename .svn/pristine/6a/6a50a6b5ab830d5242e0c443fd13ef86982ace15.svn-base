.sotablebox {
    width: 1440px;
    margin: 0 auto;
}

.sotable {
    width: 1440px;
    border-collapse: collapse;
    font-size: 12px;
}

.socol1 {
    min-height: 32px;
    height: 32px;
    line-height: 32px;
    border-bottom: 1px solid var(--bg-color3);
    font-weight: 500;
    text-align: center;
    background-color: var(--bg-color1);
}

.sotable td {
    min-width: 60px;
    width: auto;
    min-height: 32px;
    height: 32px;
    line-height: 32px;
    border-bottom: 1px solid var(--bg-color3);
    text-align: center;


}

.sotable .hn_buyTypeStr1 {
    margin: 0 auto;
    border-radius: 5px;
    width: 40px;
    height: 20px;
    line-height: 20px;
    font-size: 12px;
    background-color: #ececec;
    /*background-color: var(--ninth-color);*/
    /*color:#fff;*/
}


.sotable .hn_buyTypeStr2 {
    margin: 0 auto;
    border-radius: 5px;
    width: 40px;
    height: 20px;
    line-height: 20px;
    font-size: 12px;
    background-color: var(--third-color);
    color:#000;

}



.sotable .hn_buyTypeStr3 {
    margin: 0 10px;
    padding: 0 5px;
    /*border-radius: 5px;*/
    border:none;
    min-width: 40px;
    width: 40px;
    height: 16px;
    line-height: 16px;
    font-size: 10px;
    background-color: var(--forth-color);

    /*color:#fff;*/
}

.sotable .hn_buyTypeStr4 {
    /*padding: 0 2px;*/
    border-radius: 5px;
    border:none;
    min-width: 0px;
    width: 0px;
    height: 20px;
    line-height: 20px;
    font-size: 12px;
    background-color: transparent;

    /*color:#fff;*/
}

.herbList_boxfxp .buyingInfo,
.sotable .buyingInfo {
    margin: 0 auto;
    min-width: 180px;
    width: 180px;
}


.herbList_boxfxp .buyType,
.sotable .buyType {
    min-width: 60px;
    width: 60px;
