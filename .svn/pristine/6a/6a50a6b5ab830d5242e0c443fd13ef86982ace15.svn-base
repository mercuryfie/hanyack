/*Gauge Meter*/



.GaugeMeter {
    position: relative;
    text-align: center;
    overflow: hidden;
    cursor: default;
    display: inline-block;
    padding: 0 10px;
}

.GaugeMeter SPAN, .GaugeMeter B {
    width: 54%;
    position: absolute;
    text-align: center;
    display: inline-block;
    color: rgba(0, 0, 0, 0.8);
    font-weight: 100;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    margin: 0 23%;
}

.GaugeMeter[data-style="Semi"] B {
    width: 80%;
    margin: 0 10%;
}

.GaugeMeter S, .GaugeMeter U {
    text-decoration: none;
    font-size: 0.60em;
    font-weight: 200;
    opacity: 0.6;
}

.GaugeMeter B {
    color: #000;
    font-weight: 200;
    opacity: 0.8;
}

.GaugeMeter .name {
    margin-bottom: 10px;
    font-size: 18px;
    font-weight: 500;
}

.GaugeMeter .flexCol {
    padding-top: 5px;
    font-size: 14px;
}

.GaugeMeter .tag {
    border-radius: 2px;
    width: 12px;
    height: 8px;
    margin-right: 10px;

}
.GaugeMeter .tag1 {
    background-color: var(--second-color);

}
.GaugeMeter .tag2 {
    background-color: #ececec;

}

