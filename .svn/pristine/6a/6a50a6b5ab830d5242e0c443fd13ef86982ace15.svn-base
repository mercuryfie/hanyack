/* mypage ------------------------------------------  */
.mypage {
    background-color: var(--sub-color);
    margin-top: 20px;
    width: 100vw;
    height: 100%;
}

.mypagewrap {
    background-color: var(--sub-color);
    margin: 0 auto;
    width: 1050px;
    height: 100%;
    display: flex;
    position: relative;
}

.myleft {
    display: flex;
    flex-flow: column;
}

.mypagewrap > p {
    display: inline-block;
    margin-top: 60px;
    margin-left: 20px;
    position: absolute;
    top: 0;
    left: 0;
    font-size: 24px;
    font-weight: bold;
}

.myleft,
.myright {
    margin-top: 120px;
}

.myleft1-1,
.myleft1-2,
.myright {
    background-color: #fff;
    border-radius: 5px;
    margin-bottom: 10px;
    margin-right: 10px;
}

.myleft1-1 {
    width: 240px;
    height: 240px;
    margin-right: 20px;
    margin-bottom: 20px;
}

.myleft1-1 > p:first-child {
    margin-top: 40px;
    background-image: linear-gradient(
            to bottom right,
            #5286f6 10%,
            #7623bf 70%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}

.myleft1-1 > p {
    margin-left: 40px;
    width: 180px;
    height: 40px;
    font-size: 18px;
    font-weight: bold;
}

.myleft1-2 {
    width: 240px;
    height: 560px;
}

.myleft1-2 > p:first-child {
    margin-top: 40px;
    font-weight: bold;
    background-image: linear-gradient(
            to bottom right,
            #5286f6 10%,
            #7623bf 70%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}

.myleft1-2 > p {
    margin-left: 40px;
    width: 180px;
    height: 60px;
    font-size: 18px;
    font-weight: 400;
}

.myright {
    width: 750px;
    height: 1050px;
}

.myrightwrap {
    margin-top: 40px;
    margin-left: 40px;
    display: flex;
}

.myright1-1 {
    display: flex;
    flex-flow: column;
}

.myright1-1 > p {
    font-size: 14px;
    width: 180px;
    height: 50px;
    /* line-height: 50px; */
}

.myright1-2 {
    display: flex;
    flex-flow: column;
}

.myright1-2 > p {
    font-size: 14px;
    width: 340px;
    height: 50px;
    /* line-height: 50px; */
}

.myright1-2 > p > input {
    border: 1px solid #ccc;
    height: 30px;
}

.myright1-2 > div {
    font-size: 14px;
    width: 340px;
    height: 50px;
}

.email {
    border: 1px solid #ccc;
    width: 320px !important;
    height: 30px !important;
    line-height: 30px;
    margin-bottom: 20px;
    display: flex;
    justify-content: left;
    position: relative;
    z-index: 10;
}

.coremail {
    z-index: 11;
}

.email > input,
.email > div {
    border: none;
}

.email > input {
    margin-right: 10px;
}

.emailbtn {
    background-color: #fff;
    width: 120px;
    height: 240px;
    border: none;
    display: flex;
    flex-flow: column;
    /*align-items: top;*/
    align-items: start;
}

.emailbox {
    display: flex;
}

.emailbox > button:first-child {
    border: none;
    background-color: #fff;
    width: 100px;
    height: 28px;
}

.emailbox > button:nth-child(2) {
    border: none;
    background-color: #fff;
    width: 28px;
}

.customEmailInput {
    display: none;
    border: none;
    position: absolute;
    top: 0px;
    left: 58%;
    width: 120px;
    height: 28px;
}

.emailbtn {
    border: 1px solid #ccc;
    background-color: #fff;
    width: 140px;
    padding: 10px;
    position: absolute;
    top: 35px;
    left: 50%;
    display: none;
}

.emailbtn > button {
    border: none;
    background-color: #fff;
    color: #ccc;
    width: 120px;
    height: 30px !important;
}

.emailbtn > button:hover {
    border: 1px solid transparent;
    color: var(--fifth-color);
}

.emailbtn > button:last-child {
    margin-bottom: 0px;
}

.coremailp,
.accemailp {
    width: 480px !important;
}

.postcodebtn {
    border: 1px solid var(--fifth-color);
    color: var(--fifth-color);
    background-color: #fff;
    font-weight: 500;
    border-radius: 5px;
    width: 120px;
    height: 30px;
}

.addp1 > input,
.addp2 > input {
    width: 320px;
    height: 30px;
}

.coremailp > select,
.accemailp > select {
    width: 120px;
    height: 30px;
    display: inline-block;
}

.assignp > select {
    border: 1px solid #ccc;
    width: 120px;
    height: 30px;
    display: inline-block;
}


