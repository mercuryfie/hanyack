}

/**************** 바코드 출력 ****************/
.modal-list-area table,
.barcode-top table,
.barcode-bottom table  {
    width: 100%;
    text-align: center;
}
.modal-list-area th,
.modal-list-area td,
.barcode-top th,
.barcode-top td,
.barcode-bottom th,
.barcode-bottom td {
    padding: 6px 6px;
    text-align: center;
    height: 36px;
}


.barcode-top colgroup col:nth-of-type(1) {
    width: 70%;
}
.barcode-top colgroup col:nth-of-type(2) {
    width: 12%;
    min-width: 86px;
}
.barcode-top colgroup col:nth-of-type(3) {
    width: 18%;
}
.barcode-top td:first-child {
    vertical-align: middle;
}
.barcode-top td:last-child {
    text-align: left;
}
.barcode-top {
    margin-bottom: 10px;
}



.barcode-bottom col {
    width: 40%;
}
.barcode-bottom col:first-child {
    width: 60%;
}
.barcode-bottom td {
    height: 108px;
    vertical-align: middle;
}
.barcode-bottom {
    margin-top: 10px;
}
.print-area {
    background: #fff;
    padding: 15px 0;
}
.print-info {
    margin: 40px 0;
    color:#5c5c5c;
    display: flex;
    align-items: center;
    justify-content: center;

}

.authred {
    color: red;
}

.authgreen {
    color: green;
}



