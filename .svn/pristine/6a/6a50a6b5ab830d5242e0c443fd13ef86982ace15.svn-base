    background-color: rgba(0, 0, 0, 0.4);
    display: none;
}

.cartpop,
.orderpop,
.cart_orderpop,
.cart_dltmer,
.authpop
{
    background-color: #fff;
    border-radius: 10px;
    width: 380px;
    height: 240px;
    z-index: 32;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
