}

.inputcon {
    width: 380px;
    height: 60px;
    position: relative;
    margin-bottom: 20px;
}

.inputcon > input {
    width: 380px;
    height: 60px;
    border-radius: 5px;
}

.inputcon > input[type="text"],
.inputcon > input[type="password"] {
    padding-left: 20px;
}


.autoLogin input[type="checkbox"] {
    width: 18px;
    height: 18px;
    margin-right: 20px;
}

.clearbtn > i {
    position: absolute;
    right: 5%;
    top: 50%;
    transform: translateY(-50%);
    color: #000;
    z-index: 12;
}

.inputcon input:not(:placeholder-shown) + .clearbtn {
    display: block;
}

.login > button {
    width: 380px;
    height: 60px;
    background-color: var(--main-color);
