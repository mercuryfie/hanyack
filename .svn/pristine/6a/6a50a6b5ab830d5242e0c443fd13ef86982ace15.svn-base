/* deliveryStatusPopCon --------------- */

.deliveryStatusPopCon {
    display: none;
    position: fixed;
    z-index: 30;
    left: 0;
    top: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.4);
    z-index: 30;

}

.deliveryStatusPop {
    background-color: #fff;
    border-radius: 10px;
    width: 580px;
    height: 720px;
    z-index: 32;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    overflow: hidden;
}

.deliveryStatusPop .innerWrap {
    width: 540px;
    height: 680px;
    margin: 20px;

    overflow: hidden;
    overflow-y: scroll;
    scroll-behavior: auto;

}

.deliveryStatusPop1-0 {
    border-bottom: 1px solid #ececec;
    width: 480px;
    height: 180px;
    margin: 0 auto;
    display: flex;
    flex-flow: column;
    justify-content: flex-start;
    align-items: center;
    position: relative;
}

.deliveryStatusPop1-0 > i {
    width: 40px;
    height: 40px;
    background-color: #ffffff21;
    border-radius: 50%;
    position: fixed;
    top: 20px;
    left: 20px;
    color: #7c7c7c;
    font-size: 24px;
}

.deliveryStatusPop1-0 > * {
    margin-bottom: 10px;
}

.deliveryStatusPop .ttl {
    font-size: 24px;
    margin-top: 20px;
}

.deliveryStatusPop .timeNotice {
    font-size: 18px;
    color: var(--second-color);
}

.deliveryStatusPop1-0 p {
    color: #7c7c7c;
}

.deliveryStatusPop1-1,
.deliveryStatusPop1-3 {
    border-bottom: 10px solid #ececec41;
    width: 520px;
    height: 110px;
    display: flex;
    justify-content: space-between;
    position: relative;

}

.deliveryStatusPop1-1 .baby1,
.deliveryStatusPop1-3 .baby1 {
    width: 380px;
    display: flex;
    justify-content: flex-start;
    align-items: center;
}

.deliveryStatusPop1-1 .baby1 img,
.deliveryStatusPop1-3 .baby1 img {
    border-radius: 10px;
    margin: 0 20px;
    width: 60px;
    height: 60px;
}

.deliveryStatusPop1-1 .herbName {
    font-weight: bold;
    font-size: 18px;
}

.deliveryStatusPop1-1 .baby2 {
    width: 80px;
    height: 100px;
    margin-right: 20px;
    display: flex;
    flex-flow: column;
    justify-content: center;
    align-items: flex-end;
    color: #5c5c5c;
}

.deliveryStatusPop1-2 {
    border-bottom: 10px solid #ececec41;
    width: 520px;
    height: 110px;
    display: flex;
    flex-flow: column;
    align-items: flex-start;
    justify-content: center;

}


.deliveryStatusPop1-2 .baby1 {
    width: 500px;
    height: 34px;
    line-height: 34px;
    display: flex;
    align-items: flex-start;

}

.deliveryStatusPop1-2 .baby2 {
    width: 500px;
    height: 34px;
    line-height: 34px;
    display: flex;
    align-items: center;
    justify-content: flex-start;

}

.deliveryStatusPop1-2 .baby2 > i {
    margin-left: 20px;
}

.deliveryStatusPop1-2 .title {
    margin: 0 20px;
    color: #5c5c5c;
}

.deliveryStatusPop1-3 .herbName {
    font-size: 20px;
}

.deliveryStatusPop1-3 .date {
    color: #5c5c5c;

}

.deliveryStatusPop1-3 .baby2 {
    background-color: #d7dfe841;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    position: absolute;
    top: 50%;
    left: 95%;
    transform: translate(-95%, -50%);
    display: flex;
    justify-content: center;
    align-items: center;
}

.deliveryStatusPop1-3 .baby2 > i {
    color: #7c7c7c;
}

.deliveryStatusPop1-5 {
    border-bottom: 10px solid #ececec41;
    width: 520px;
    height: 180px;
}

.deliveryStatusPop1-5 .progress {
    border-bottom: 1px solid #d7dfe8;
    width: 520px;
    height: 120px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    position: relative;

}

.deliveryStatusPop1-5 .imgBox {
    width: 120px;
    height: 160px;
    display: flex;
    flex-flow: column;
    justify-content: center;
    align-items: center;
}

.deliveryStatusPop1-5 .imgBox > * {
    margin-bottom: 20px;
}

.deliveryStatusPop1-5 .imgBox img {
    border-radius: 10px;
    width: 60px;
    height: 60px;
}


.deliveryStatusPop1-5 .progress .dot {
    width: 10px;
    height: 10px;
    border: 3px solid #d7dfe8;
    background-color: #fff;
    border-radius: 50%;
    position: absolute;
    top: 115px;
}

.deliveryStatusPop1-5 .progress .status {
    position: absolute;
    top: 135px;
}


.deliveryStatusPop1-4 {
    border-bottom: 10px solid #ececec41;
    width: 520px;
    height: auto;
    display: flex;
    flex-flow: column;
    align-items: flex-start;
    justify-content: center;

}

.deliveryStatusPop1-4 .process {
    border-left: 1px solid #d7dfe8;
    margin-left: 20px;
    width: 480px;

}

.deliveryStatusPop1-4 .baby {
    width: 480px;
    height: 50px;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    color: #7c7c7c;
    position: relative;
}

.deliveryStatusPop1-4 .baby > p {
    margin-left: 18px;
}


.deliveryStatusPop1-4 .process .baby .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 3px solid #d7dfe8;
    background-color: #fff;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    left: -24px;

}

.deliveryStatusPop1-4 .process .baby .none {
    display: none;
}

.deliveryStatusPop1-4 .process .baby .nowDot {
    color: var(--second-color);
    z-index: 12;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    left: -8px;
}

.deliveryStatusPop1-5 .progress .none {
    display: none;

}

.deliveryStatusPop1-5 .progress .nowDot {
    color: var(--second-color);
    z-index: 12;
    position: absolute;
    top: 113px;

}


