* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: "Noto Sans KR", sans-serif;
}

ul {
    list-style-type: none;
}

a {
    text-decoration: none;
    color: inherit;
}


@media print {
    body {
        margin: 0 !important;
    }

    .btn-wrap, .popclosePrint,
    .printOpen, .print-info {
        display: none;
    }

    a {
        color: #000 !important;
        text-decoration: none !important;
    }
}

.main-container {
    width: fit-content;
    margin-left: auto;
    margin-right: auto;
}

.ck-content {
    line-height: 1.6;
    word-break: break-word;
}

.editor-container_classic-editor .editor-container__editor {
    min-width: 795px;
    max-width: 795px;
}

:root {
    --main-color: #009965;
    --main-color20: #00996510;
    --main-bg: #F9FAFB;
    --sub-color: #edf1ef;
    --second-color: #5e9b76;
    --third-color: #b0ddc2;
    --forth-color: #8bffb9;
    --fifth-color: #1d3627;
    --sixth-color: #fc88ad;
    --orange: #ff8207;
    --eigth-color: #c975ed;
    --ninth-color: #6eec9a;
    --mint-color: #79f8d8;
    --bg-color1: #f1f1f16f;
    --bg-color2: #ececec;
    --bg-color3: #ccc;
    --bg-color4: #dedede;
    --cartbg: #f2f5f8;
    --gray-cart001: #848f9a;
    --grayColor1: #848f9a;
    --yellow: #f3df14;
    --ck-z-default: 100;
    --ck-z-panel: calc( var(--ck-z-default) + 999 );
}

::selection {
    background-color: #b0ddc2; /* 드래그 배경색 */
    color: #000; /* 드래그된 텍스트 색상 */
}

input[type="checkbox"] {
    accent-color: #5e9b76; /* 체크 표시 색상 (예: 토마토색) */
}

input[type="search"] {
    outline: none;
}

input[type="radio"] {
    accent-color: #4b6957;
    margin-right: 5px;
}

.mt20 {
    margin-top: 20px;
}

.mt40 {
    margin-top: 40px;
}

.pt10 {
    padding-top: 10px;
}

.noto-sans-kr {
    font-family: "Noto Sans KR", sans-serif;
    font-optical-sizing: auto;
    font-weight: 200;
    font-style: normal;
}

#wrap {
    width: 1050px;
    height: auto;
    margin: 0 auto;
    padding: 10px 0;
}

/* header ------------------------------------------  */
.topline {
    width: 100vw;
    height: 20px;
    background-color: var(--main-color);
    color: white;
    font-size: 12px;
    text-align: center;
    text-decoration: underline;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    cursor: pointer;
}


.logo {
    width: 200px;
    /*margin-left: 40px;*/
    cursor: pointer;
    object-fit: cover;
}

.searchicon {
    position: absolute;
    top: 110px;
    left: 66%;
    transform: translateX(-66%);
    font-size: 24px;
    color: var(--main-color);
}

.mainSearch {
    border: 1px solid var(--main-color);
    font-weight: normal;
    font-size: 16px;
    padding-left: 10px;
}

.loginul {
    width: 1050px;
    display: flex;
    justify-content: right;
    position: absolute;
    top: 40px;
    right: 0;
}

.loginul > li > a {
    width: 100%;
    margin-right: 10px;
    font-size: 14px;
    color: #7c7c7c;
}

.iconbox {
    width: 170px;
    height: 70px;
    display: flex;
    justify-content: right;
    position: absolute;
    top: 40%;
    right: 0;
}

.icons {
    display: flex;
}

.iconbox > div > i {
    background-color: #fff;
    margin-right: 10px;
    width: 48px;
    height: 48px;
    line-height: 48px;
    font-size: 28px;
    color: var(--main-color);
    text-align: center;
    cursor: pointer;
    visibility: visible;
    opacity: 1;
}

.hidden {
    visibility: hidden;
    opacity: 0;
    transition: visibility 0s,
    opacity 0.3s ease;
}

.icons > i:last-child {
    margin-right: 0;
}

/* .icon1 {
    position: relative;
} */
.locatip {
    display: none;
    border: 1px solid #ccc;
    width: 320px;
    height: 200px;
    background-color: #fff;
    color: #000;
    /* padding: 0 20px; */
    position: absolute;
    top: 60px;
    right: 110px;
    /* right: 25%;
    transform: translatex(-25%); */
    z-index: 9;
    border-radius: 5px;
}

.locatip::after {
    content: "";
    position: absolute;
    top: -10px;
    right: 10px;
    width: 0px;
    height: 0px;
    border: 10px solid transparent;
    border-bottom-color: #ccc;
    border-top: 0;
    margin-left: 0px;
    margin-bottom: 0px;
}

.locatip > p {
    font-size: 18px;
    font-weight: normal;
    text-align: center;
    line-height: 30px;
    width: 220px;
    margin: 0 auto;
    word-wrap: break-word; /* 긴 단어를 강제로 줄바꿈 */
    overflow-wrap: break-word; /* 위와 동일한 기능, 더 최신 속성 */
    white-space: normal; /* 공백 처리 방식을 기본값으로 설정 */
    padding-top: 30px;
}

.locatip > button {
    border: 1px solid var(--main-color);
    background-color: #fff;
    width: 280px;
    height: 50px;
    font-size: 12px;
    color: var(--main-color);
    border-radius: 5px;
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    cursor: pointer;
}

/* search header view  -------------------------------- */

.headerwrap {
    width: 1140px;
    height: 140px;
    position: relative;
    margin: 0 auto;
}

/* schhead  -------------------------------- */
.schhead {
    margin: 0 auto;
    width: 1050px;
    height: auto;
    display: flex;
    flex-flow: column;
}

.schhead1 {
    width: 1050px;
    height: 80px;
}

.schhead2 {
    margin: 0 auto;
    margin-top: 40px;
    margin-bottom: 40px;
    width: 1050px;
    height: 80px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
}

.schhead2 > p {
    margin-right: 20px;
}

.schicons {
    font-size: 22px;
    color: var(--main-color);
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    right: 0;
}

.schicons > i {
    margin-right: 20px;
}

.schlocatip {
    display: none;
    border: 1px solid #ccc;
    width: 320px;
    height: 200px;
    background-color: #fff;
    color: #000;
    padding: 0 20px;
    position: absolute;
    top: 100%;
    right: 5%;
    transform: translatex(-5%);
    z-index: 9;
    border-radius: 5px;
}

.schlocatip::after {
    content: "";
    position: absolute;
    top: -10px;
    right: 10px;
    width: 0px;
    height: 0px;
    border: 10px solid transparent;
    border-bottom-color: #ccc;
    border-top: 0;
    margin-left: 0px;
    margin-bottom: 0px;
}

.schlocatip > p {
    font-size: 18px;
    font-weight: normal;
    text-align: center;
    line-height: 30px;
    width: 220px;
    margin: 0 auto;
    word-wrap: break-word; /* 긴 단어를 강제로 줄바꿈 */
    overflow-wrap: break-word; /* 위와 동일한 기능, 더 최신 속성 */
    white-space: normal; /* 공백 처리 방식을 기본값으로 설정 */
    padding-top: 30px;
}

.schlocatip > button {
    border: 1px solid var(--main-color);
    background-color: #fff;
    width: 280px;
    height: 50px;
    font-size: 12px;
    color: var(--main-color);
    border-radius: 5px;
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    cursor: pointer;
}

/* schbox  -------------------------------- */
.smartwrap {
    width: 1440px;
    margin: 0 auto;
}

/* .smartwrap button:hover {
    border:1px solid transparent;
    background-color: var(--forth-color);
} */
.smartcon1 {
    margin: 0 auto;
    width: 850px;
    height: 120px;
    display: flex;
    align-items: center;
}

.smartcon1 > img {
    width: 180px;
    height: 50px;
    margin-left: 40px;
}

.sconschbox {
    margin-left: 10px;
    width: 440px;
    height: 40px;
    position: relative;
}

.sconschbox > input {
    border: 1px solid var(--fifth-color);
    border-radius: 5px;
    width: 440px;
    height: 40px;
}

.sconschbox > i {
    font-size: 18px;
    color: var(--main-color);
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    right: 10px;
}

.smartcon2 {
    margin: 0 auto;
    width: 850px;
    height: 60px;
}

.idxtable {
    width: 780px;
    font-size: 14px;
    border-collapse: collapse;
    margin: 0 auto;
    margin-top: 20px;
}

.idxtable td {
    border: 1px solid var(--bg-color2);
    height: 40px;
    padding: 0 10px;
}

.idx1-2 {
    padding-top: 10px;
}

.idx1-2 .btn_cho {
    border: none;
    width: 20px;
    height: 20px;
    border-radius: 2px;
    margin-right: 5px;
}

.idx2-2,
.idx3-2 {
    display: flex;
}

.idx2-2 > p,
.idx3-2 > p {
    text-decoration: underline;
    margin-right: 20px;
}

