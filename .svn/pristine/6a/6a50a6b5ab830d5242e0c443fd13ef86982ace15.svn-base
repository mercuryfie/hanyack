    align-items: center;
}

.idx4-2 > div {
    position: relative;
    width: 180px;
    height: 26px;
}

.idx4-2 > div > input {
    border: 1px solid var(--bg-color3);
    width: 180px;
    height: 26px;
}

.idx4-2 > div > i {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    right: 10px;
    color: var(--bg-color3);
}

.smartcon3 {
    width: 1320px;
    margin: 0 auto;
}

.smartcon3 .head_title {
    margin: 0 auto;
    font-size: 22px;
    font-weight: bold;
    padding-top: 20px;
    padding-bottom: 40px;
    text-align: center;
}

.scbtnbox {
    margin-bottom: 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}


