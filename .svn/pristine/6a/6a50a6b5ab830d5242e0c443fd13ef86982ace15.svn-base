/* footer ------------------------------------------  */

footer {
    position: relative;
}

.footerwrap {
    background-color: var(--sub-color);
    width: 100vw;
    height: 280px;
    display: flex;
    justify-content: center;
}

.whitefoot {
    margin-top: 0px;
    background-color: #fff;
}

.footerwrap > img {
    width: 180px;
    height: 40px;
    object-fit: cover;
    margin-right: 60px;
    margin-top: 60px;
    display: inline-block;
}

.footul {
    margin-top: 20px;
    width: 860px;
    display: flex;
    padding-top: 20px;
}

.footul > li {
    margin-right: 60px;
    color: #5c5c5c;
}

.footul > li > ul > li {
    font-size: 14px;
}

.footul > li > ul > li:first-child {
    font-weight: bold;
    font-size: 14px;
    margin-bottom: 20px;
}

.ful1 > li {
    width: 320px;
}

.ful2 > li,
.ful3 > li,
.ful4 > li {
    width: 120px;
}

.bottomline {
    width: 100vw;
    height: 26px;
    background-color: var(--main-color);
    color: #fff;
    text-align: center;
    z-index: 20;
    /* position: fixed;
    bottom: 0;
    left: 0; */
    padding-top: 5px;
    font-size: 12px;
    font-weight: normal;
}

