}

.bb1-3 > div > button {
    background-color: #a86f5f;
}

/* slickprev  -------------------------------- */
.slickprev,
.slicknext {
    border: none;
    border-radius: 50%;
    position: absolute;
    top: 50%;
    transform: translate(0, -50%);
    display: block;
    background-color: #00000038;
    color: #fff;
    width: 50px;
    height: 50px;
    padding: 0;
    cursor: pointer;
    z-index: 20;
}

.slickprev {
    left: 5%;
}

.slicknext {
    right: 5%;
}

.slickprev:before,
.slicknext:before {
    font-family: "Font Awesome 5 Free";
    font-weight: 900;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}


