/* itemRejectpopcon --------------- */

.accPopCon,
.thumPopCon,
.itemRejectpopcon,
.cancelCheckPopCon,
.itemReturnpopcon{
    display: none;
    position: fixed;
    z-index: 30;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(0, 0, 0, 0.4);

}

.accPop,
.thumpop {
    background-color: #fff;
    border-radius: 10px;
    padding: 10px;
    width: 380px;
    height: 420px;
    position: relative;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-flow: column;
    /*justify-content: center;*/
    align-items: center;

}

.thumpop  i{
    position: absolute;
    top:15px;
    right:20px;
    font-size: 16px;
    color:#5c5c5c;
    margin-bottom: 10px;
}
.thumpop .thum {
    position: absolute;
    top:50px;
    /*right:0px;*/
    width: 340px;
    height: 340px;
    object-fit: cover;
}

.itemRejectpop,
.cancelCheckPop,
.itemReturnpop{
    background-color: #fff;
    border-radius: 10px;
    width: 380px;
    height: 580px;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
}

.itemRejectpop > h2,
.itemReturnpop > h2,
.cancelCheckPop > h2 {
    font-size: 22px;
    margin: 0 auto;
    text-align: center;
    padding: 40px 0 10px 0;
}


.itemRejectpop1-1,
.cancelCheckPop1-1,
.itemReturnpop1-1 {
    width: 320px;
    height: 320px;
    overflow: hidden;
    margin: 0 auto;
    margin-top: 40px;
    scroll-behavior: auto;

    z-index: 10;
    display: flex;
    justify-content: flex-start;


}

.itemRejectpop1-1 .title,
.cancelCheckPop1-1 .title,
.itemReturnpop1-1 .title  {
    margin-right: 20px;
    width: 80px;

}

.itemRejectpop1-1 .title p,
.cancelCheckPop1-1 .title p,
.itemReturnpop1-1 .title p {
    margin-bottom: 20px;
}

.itemRejectpop1-1 .contents,
.cancelCheckPop1-1 .contents,
.itemReturnpop1-1-1 .contents {
    width: 220px;

}

.itemRejectpop1-1 .contents select,
.cancelCheckPop1-1 .contents select,
.itemReturnpop1-1 .contents select {
    border: 1px solid #ccc;
    width: 200px;
    height: 24px;

}

.itemRejectpop1-1 .contents textarea,
.cancelCheckPop1-1 .contents textarea,
.itemReturnpop1-1 .contents textarea {
    border: 1px solid #ccc;
    width: 200px;
    height: 260px;
    margin-top: 20px;
    padding: 5px;
    resize: none;

}

.itemRejectpop1-2,
.cancelCheckPop1-2,
.itemReturnpop1-2 {
    width: 320px;
    height: 24px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-top: 40px;

}

.itemRejectpop1-2 button,
.cancelCheckPop1-2 button,
.itemReturnpop1-2 button {
    border: none;
    background-color: #ececec;
    width: 80px;
    height: 24px;
    line-height: 24px;
    border-radius: 5px;
    margin-right: 10px;
    cursor: pointer;
}

.itemRejectpop1-2 .confirm,
.cancelCheckPop1-2 .confirm,
.itemReturnpop1-2 .confirm {
    background-color: var(--main-color);
    color: #fff;
}



/* spinnerBox --------------- */

.spinnerBox,
.spinner {
    display: none;
}

.spinnerBox {
    position: fixed;
    z-index: 30;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(0, 0, 0, 0.05);

}

.spinner {
    width: 24px;
    height: 24px;
    z-index: 32;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
}

.spinnerBox.active, .spinner.active {
    display: block;
}




/* bestpop --------------- */

.bestpop {
    display: none;
    position: fixed;
    z-index: 30;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(0, 0, 0, 0.4);

}

.bestpopcon {
    background-color: #fff;
    border-radius: 10px;
    width: 380px;
    height: 580px;
    z-index: 32;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
}

.bestbox {
    width: 320px;
    height: 360px;
    overflow: hidden;
    margin: 0 auto;
    scroll-behavior: auto;
}

.bestpopcon > h2 {
    font-size: 22px;
    /* margin-top: 20px;
    margin-left: 30px; */
    margin: 0 auto;
    text-align: center;
    padding: 40px 0 10px 0;
}

.bestcon1-1 {
    width: 380px;
    text-align: right;

}

.bestcon1-1 > select {
    border: 1px solid #ccc;
    margin: 10px 0;
    margin-right: 40px;
}

.bestcon1-2 {
    border: 1px solid #ccc;
    width: 300px;
    height: 360px;
    overflow: hidden;
    margin: 0 auto;
    scroll-behavior: auto;
    max-height: 360px;
    overflow-y: auto;
    padding: 0 10px;

}

.bestops {
    border-bottom: 1px solid #ccc;
    width: 280px;
    height: 80px;
    display: flex;
    flex-flow: column;
    margin-top: 20px;
    margin: 20px 0;
    margin: 0 auto;
}

.becon1-1,
.becon1-2,
.becon1-3 {
    margin-right: 10px;
    display: flex;
    align-items: center;
}

.becon1-1 {
    margin-top: 10px;
}

.becon1-1 > input {
    margin-right: 20px;
}

.becon1-1 > p {
    font-size: 12px;
    margin-right: 10px;
}

.becon1-1 > p:nth-child(2) {
    width: 60px;
    font-size: 12px;
    font-weight: bold;
    margin-right: 20px;
    text-align: left;
}

.becon1-2 > p:nth-child(1),
.becon1-3 > p:nth-child(1) {
    width: 10px;
    margin-right: 22px;
    padding: 2px 0;
}

.becon1-2 > p:nth-child(2),
.becon1-3 > p:nth-child(2) {
    width: 60px;
    font-size: 10px;
    margin-right: 20px;
    padding: 2px 0;
}

.becon1-2 > p:nth-child(3),
.becon1-3 > p:nth-child(3),
.becon1-2 > p:nth-child(4),
.becon1-3 > p:nth-child(4) {
    font-size: 12px;
    font-weight: 500;
}

.becon1-3 > p:last-child {
    font-size: 10px;
    margin-left: 10px;
}

.bestbtn {
    display: flex;
    justify-content: flex-end;
}

.bestbtn button {
    border: none;
    background-color: #ececec;
    width: 80px;
    height: 24px;
    border-radius: 5px;
    margin-top: 20px;
    margin-right: 10px;
    cursor: pointer;
}

.bestbtn > button:last-child {
    background-color: var(--main-color);
    color: #fff;
    margin-right: 40px;
}


/* confirmOrderCon --------------- */
.confirmOrderCon {
    display: none;
