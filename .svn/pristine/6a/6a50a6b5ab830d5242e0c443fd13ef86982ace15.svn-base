.imgattach {
    width: 520px;
    height: 180px;
    border: 1px solid #ccc;
    position: relative;
    margin: 10px 0;
}

.imagePreview {
    height: calc(100% - 40px);
    overflow-y: auto;
    padding: 5px;
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    display: flex;
    flex-flow: column;
    align-items: center;
    justify-content: center;
    font-size: 14px;
}

.imagePreview > span {
    color: #7c7c7c;

}

.preview-item {
    /*width: 32%;*/
    /*border: 1px dashed #eee;*/
    width: 80px;
    height: 100px;
    padding: 5px;
    position: relative;
}


.thumbnail {
    border: 1px dashed #ececec;
    padding: 10px;
    width: 80px;
    height: 80px;
    object-fit: cover;
    display: block;
    margin: 0 auto;
}

.fileThum .fileIcon {
    border: 1px dashed #ececec;
    padding: 10px;
    width: 80px;
    height: 80px;

    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 44px;

}
#mainimg ~ .imagePreview .thumbnail {
    width: 60px;
    height: 60px;
    object-fit: cover;
    max-height: 100px;
    border: 2px solid blue;
}

/*modifier file updater srart*/
.imgThum,
.fileThum{
    border:1px solid blue;
    /*display: none;*/
    width: 518px;
    height: 140px;
    /*border: 1px solid #ccc;*/
    background-color: #fff;
    position: absolute;
    top:0;
    left:0;
    z-index: 12;
}

.fileThum .fileIcon,
.imgThum .thumbnail {
    position: absolute;
    bottom:44px;
    left:50%;
    transform: translateX(-50%);

}

.fileThum .filename,
.imgThum .filename {
    position: absolute;
    bottom:16px;
    left:50%;
    transform: translateX(-50%);
    font-size: 12px;
}

/*modifier file updater end*/


/* 첨부파일 전용 스타일 */
#fileimg ~ .imagePreview .thumbnail {
    width: 60px;
    height: 60px;
    object-fit: cover;
    max-height: 100px;
    border: 2px solid blue;


}

.imagePreview.has-files .default-message {
    display: none;
}

.file-meta {
    text-align: center;
    font-size: 0.8em;
}

.file-meta > span {
    white-space: nowrap;
    /*overflow: hidden;*/

}

.delete-btn {
    position: absolute;
    right: -14px;
    top: -5px;
    background-color: var(--fifth-color);
    color: #fff;
    border: none;
    cursor: pointer;
    border-radius: 50%;
    width: 20px;
    height: 20px;
    line-height: 18px;
}

.fileThum .delete-btn,
.imgThum .delete-btn {
    position: absolute;
    left: 58%;
    transform: translateX(-58%);
    top: 5px;
    z-index: 12;
}


.custom-upload-btn {
    border:1px solid red;
    display: block;
    text-align: center;
    padding: 5px;
    width: 518px;
    height: 40px;
    background: #f8f8f8;
    border-top: 1px solid #ddd;
    cursor: pointer;
}

.infotype8 button {
    width: 70px;
    height: 24px;
}

.reportResult {
    font-size: 14px;
    color: #7c7c7c;
}

.defaultInfo {
    font-size: 14px;
    color: #7c7c7c;
}

.proop > input {
    margin-right: 10px;
}

.proop > label {
    font-size: 14px;
}

.infotype9 {
    padding-bottom: 40px;
}

.infodetail {
    width: 520px;
    height: 260px;
    /*overflow: hidden;*/
    position: relative;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;

    /*box-sizing: border-box;*/
}

.infockeditor .ck.ck-toolbar{
    position: sticky;
    top: 0;
    left:0;
    z-index: 10;
    background: #fff;

    width: 520px;
    max-height: 200px;
    box-sizing: border-box;
}
.ck-editor__editable {
    position: absolute;
    top:36px;
    left:0px;
    width: 520px;
    height: 220px;
    min-height: 220px;
    max-height: 220px;
    overflow: hidden;
    overflow-y: scroll;
    box-sizing: border-box;
    /*overflow-y: visible, hidden, clip, scroll, auto, */
}

.ck-caption {
    display: none !important;
}


.main-container,
.editor-container,
.editor-container__editor {
    height: 100%;
    display: flex;
    flex-direction: column;
}

.ck.ck-editor {
    height: 100%;
    display: flex;
    flex-direction: column;
}

.ck.ck-toolbar {
    flex-shrink: 0;
    position: sticky;
    top: 0;
    z-index: 2;
    background: #fff;
}

.ck-editor__main {
    flex: 1 1 0;
    overflow-y: auto;
    min-height: 0;
}


