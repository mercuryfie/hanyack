/********************************************************************************************************************************************************
 *  공통 - list-area
********************************************************************************************************************************************************/
th, td {
    line-height: 20px;
}

.list-area{
    /* border-top: 1px solid #7389A0;
    border-bottom: 1px solid #7389A0; */
    width: 100%;
}
.list-area table {
    width: 100%;
    border-collapse: collapse;
}
.list-area thead tr{
    background-color: var(--cartbg);
    /* border:1px solid #000; */
    /* border-bottom: 1px solid #C7D3E0; */
}
.list-area thead tr,
.list-area tbody tr {
    /*border-bottom:1px solid #7c7c7c;*/
}
.list-area th,
.list-area td {
    border-right: 1px solid #7c7c7c;
}

/*.list-area th:last-child  {*/
/*    border-right: 1px solid transparent;*/
/*}*/
.list-area thead tr th{
    /*padding: 10px 5px;*/
    vertical-align: middle;
    font-weight: 400;
}


.list-area table .herbName {
    /*color:var(--second-color);*/
    color: blue;
    font-weight: 500;
    text-decoration: underline;
}

.list-area tbody tr th,
.list-area tbody tr td,
.list-area tfoot tr th,
.list-area tfoot tr td {
    /*padding: 6px 6px;*/
    /* vertical-align: top; */
    height: 32px;
    text-align: center;
    vertical-align: middle;
}

.list-area thead span {
    font-weight: 300;
    font-size: 15px;
}

.bardcodeTxt{
    text-align: left;
    margin-top: -20px;
    padding-left: 20px;
    font-weight: 700;
}

.list-area.top-table-area{
    /* border : 1px solid black; */
    /*border-bottom : 1px solid black;*/
}

.modal-con {
    margin: 0 auto;
    border:1px solid #000;
    width: 100vw;

    padding: 10px;
}
.btn-wrap,
.modal-con ~.btn-wrap {
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 15px;
}
.btn-wrap .btntype7 {
    margin-right: 20px;
}

.list-area.bottom-table-area {
    /* margin-top: 10px; */
    /*border: 1px solid #000;*/
}

.modal-con .list-area table {
    text-wrap: nowrap;

}

.list-area.top-table-area tr {
    border: 1px solid #000;
    text-wrap: nowrap;

}
.list-area.top-table-area tbody tr:nth-of-type(2) td {
    padding: 20px 6px;
}
.list-area.top-table-area tbody th {
    text-wrap: nowrap;
    /*border-right: 1px solid #000;*/
    background-color: var(--cartbg);
    /* background: #ececec81;  */
}
.list-area.top-table-area tbody td {
    text-wrap: nowrap;
    background: #fff;
}


/********************************************************************************************************************************************************
 *  공통 - btn
********************************************************************************************************************************************************/

.btn-line-default i,
.btn-line-black i,
.btn-line-brand i,
.btn-fill-brand i {
    margin-left: 10px;
}
.btn-line-disabled {
    color: #a3b6cb;
}


.sbtn-line-default {
    /* border: 1px solid #C7D3E0; */
    border-radius: 4px;
